class RequestPacer:
    """Serialize remote request starts without blocking prior requests from completing."""

    def __init__(self, minimum_interval_seconds: float = REMOTE_REQUEST_MIN_INTERVAL_SECONDS):
        self.minimum_interval_seconds = minimum_interval_seconds
        self.lock = threading.Lock()
        self.next_start = 0.0

    def wait(self) -> None:
        with self.lock:
            now = time.monotonic()
            delay = max(0.0, self.next_start - now)
            self.next_start = max(now, self.next_start) + self.minimum_interval_seconds
        if delay:
            time.sleep(delay)


def parse_utc_timestamp(value: str) -> str:
    for timestamp_format in (UTC_TIMESTAMP_FORMAT, "%Y-%m-%dT%H:%M:%SZ"):
        try:
            return (
                datetime.strptime(value, timestamp_format)
                .replace(tzinfo=timezone.utc)
                .strftime("%Y-%m-%dT%H:%M:%SZ")
            )
        except ValueError:
            continue
    raise argparse.ArgumentTypeError(
        f"invalid UTC timestamp {value!r}; expected {UTC_TIMESTAMP_FORMAT!r} or ISO-8601 UTC"
    )


def resolve_utc_timestamp(value: str, now: datetime) -> str:
    """Resolve a supported absolute or relative time expression to canonical UTC."""
    try:
        return parse_utc_timestamp(value)
    except argparse.ArgumentTypeError:
        pass
    normalized = value.strip().lower()
    if normalized == "now":
        return now.strftime("%Y-%m-%dT%H:%M:%SZ")
    match = re.fullmatch(r"(\d+)\s+(second|minute|hour|day)s?\s+ago", normalized)
    if not match:
        raise ValueError(
            "time must be UTC YYYY-MM-DD HH:MM:SS, 'now', or '<N> seconds|minutes|hours|days ago'"
        )
    amount, unit = int(match.group(1)), match.group(2)
    delta = timedelta(**{f"{unit}s": amount})
    return (now - delta).strftime("%Y-%m-%dT%H:%M:%SZ")


def resolve_time_window(
    since: str, until: str | None, now: datetime | None = None
) -> tuple[str, str]:
    captured_now = now or datetime.now(timezone.utc)
    start = resolve_utc_timestamp(since, captured_now)
    end = resolve_utc_timestamp(until or "now", captured_now)
    if end <= start:
        raise ValueError("end time must be after start time")
    return start, end


def format_audit_timestamp(timestamp: str) -> str:
    return datetime.strptime(timestamp, "%Y-%m-%dT%H:%M:%SZ").strftime("%Y-%m-%d %H:%M")


def format_audit_event_for_display(event: object) -> object:
    if not isinstance(event, dict):
        return event
    created_at = event.get("created_at")
    if not isinstance(created_at, (int, float)):
        return event
    display_event = dict(event)
    created_at_utc = datetime.fromtimestamp(created_at, timezone.utc).strftime(
        "%Y-%m-%d %H:%M:%S UTC"
    )
    display_event["created_at"] = f"{created_at} ({created_at_utc})"
    return display_event


def normalize_time_window_arguments(argv: list[str]) -> list[str]:
    """Translate --since/--until into legacy positional windows for compatible commands."""
    aliases = {"lg": "logs", "la": "log-archiver", "dp": "dashboard-panels"}
    commands = set(aliases) | set(aliases.values())
    command_index = next((index for index, value in enumerate(argv) if value in commands), None)
    if command_index is None:
        return argv
    command = aliases.get(argv[command_index], argv[command_index])
    has_since = "--since" in argv or any(value.startswith("--since=") for value in argv)
    has_until = "--until" in argv or any(value.startswith("--until=") for value in argv)
    if not has_since and not has_until:
        return argv
    if not has_since:
        raise ValueError("--until requires --since")

    remaining = argv[: command_index + 1]
    since = until = None
    index = command_index + 1
    while index < len(argv):
        value = argv[index]
        if value == "--since":
            if since is not None or index + 1 == len(argv):
                raise ValueError("--since must be supplied exactly once with a value")
            since = argv[index + 1]
            index += 2
        elif value.startswith("--since="):
            if since is not None or not value.removeprefix("--since="):
                raise ValueError("--since must be supplied exactly once with a value")
            since = value.removeprefix("--since=")
            index += 1
        elif value == "--until":
            if until is not None or index + 1 == len(argv):
                raise ValueError("--until must be supplied at most once with a value")
            until = argv[index + 1]
            index += 2
        elif value.startswith("--until="):
            if until is not None or not value.removeprefix("--until="):
                raise ValueError("--until must be supplied at most once with a value")
            until = value.removeprefix("--until=")
            index += 1
        else:
            remaining.append(value)
            index += 1
    if since is None:
        raise ValueError("--until requires --since")
    start, end = resolve_time_window(since, until)
    if command == "logs":
        positional_index = command_index + 1
        if positional_index >= len(remaining) or remaining[positional_index].startswith("-"):
            raise ValueError("logs requires node_id before --since")
        return remaining[: positional_index + 1] + [start, end] + remaining[positional_index + 1 :]
    if command == "log-archiver":
        return remaining[: command_index + 1] + [start, end] + remaining[command_index + 1 :]
    positional_index = command_index + 4
    if len(remaining) <= positional_index:
        raise ValueError(
            "dashboard-panels requires source folder, dashboard, and panels before --since"
        )
    return remaining[:positional_index] + [start, end] + remaining[positional_index:]


def normalize_canonical_arguments(argv: list[str]) -> list[str]:
    """Translate option-oriented canonical forms into legacy positional command layouts."""
    aliases = {"la": "log-archiver", "dp": "dashboard-panels"}
    command_index = next(
        (
            index
            for index, value in enumerate(argv)
            if value in set(aliases) | set(aliases.values())
        ),
        None,
    )
    if command_index is None:
        return argv
    command = aliases.get(argv[command_index], argv[command_index])
    required_options = (
        ("--output-dir",)
        if command == "log-archiver"
        else ("--source-folder", "--dashboard", "--panels", "--output-root")
    )
    if not any(
        option in argv or any(value.startswith(f"{option}=") for value in argv)
        for option in required_options
    ):
        return argv

    values: dict[str, str] = {}
    remaining = argv[: command_index + 1]
    index = command_index + 1
    while index < len(argv):
        value = argv[index]
        option = next((candidate for candidate in required_options if value == candidate), None)
        equals_option = next(
            (candidate for candidate in required_options if value.startswith(f"{candidate}=")), None
        )
        if option:
            if option in values or index + 1 == len(argv):
                raise ValueError(f"{option} must be supplied exactly once with a value")
            values[option] = argv[index + 1]
            index += 2
        elif equals_option:
            option_value = value.removeprefix(f"{equals_option}=")
            if equals_option in values or not option_value:
                raise ValueError(f"{equals_option} must be supplied exactly once with a value")
            values[equals_option] = option_value
            index += 1
        else:
            remaining.append(value)
            index += 1
    missing = [option for option in required_options if option not in values]
    if missing:
        raise ValueError(f"canonical {command} form requires {', '.join(missing)}")
    if command == "log-archiver":
        return (
            remaining[: command_index + 1]
            + [values["--output-dir"]]
            + remaining[command_index + 1 :]
        )
    return (
        remaining[: command_index + 1]
        + [
            values["--source-folder"],
            values["--dashboard"],
            values["--panels"],
            values["--output-root"],
        ]
        + remaining[command_index + 1 :]
    )


def normalize_environment_arguments(argv: list[str]) -> list[str]:
    """Accept --env before or after a subcommand and preserve --staging compatibility."""
    environments = set(GCX_CONTEXTS)
    normalized: list[str] = []
    environment: str | None = None
    staging_requested = False
    index = 0
    while index < len(argv):
        value = argv[index]
        if value == "--staging":
            staging_requested = True
            index += 1
            continue
        if value == "--env":
            if index + 1 == len(argv):
                raise ValueError("--env requires prod or staging")
            candidate = argv[index + 1]
            index += 2
        elif value.startswith("--env="):
            candidate = value.removeprefix("--env=")
            index += 1
        else:
            normalized.append(value)
            index += 1
            continue
        if candidate not in environments:
            raise ValueError("--env must be one of: prod, staging")
        if environment is not None and environment != candidate:
            raise ValueError("--env may not select multiple environments")
        environment = candidate
    if staging_requested:
        if environment is not None and environment != "staging":
            raise ValueError("--staging conflicts with --env prod")
        environment = "staging"
    if environment is None:
        return normalized
    return ["--environment", environment, *normalized]


def normalize_explain_arguments(argv: list[str]) -> list[str]:
    """Move explain controls placed before a subcommand into that subcommand's option list."""
    commands = {
        "addresses",
        "ad",
        "audit",
        "au",
        "bundle",
        "bu",
        "collect",
        "co",
        "dashboard-panels",
        "dp",
        "diff-config",
        "dc",
        "df",
        "diff-flags",
        "discover",
        "ds",
        "explain",
        "ex",
        "health",
        "hl",
        "log-archiver",
        "la",
        "logs",
        "lg",
        "migrations",
        "mg",
        "multi",
        "mu",
        "replication-gap",
        "rg",
        "run-inspection-script",
        "rs",
        "run-script",
        "session",
        "scan-compare",
        "sc",
        "slot-ownership",
        "so",
        "slowlog",
        "sl",
    }
    command_index = next((index for index, value in enumerate(argv) if value in commands), None)
    if command_index is None:
        if "--ai-explain" in argv or "--explain" in argv:
            arguments = list(argv)
            arguments.remove("--ai-explain" if "--ai-explain" in arguments else "--explain")
            return ["explain", *arguments]
        return argv
    prefix, command, suffix = argv[:command_index], argv[command_index], argv[command_index + 1 :]
    controls = {"--ai-explain", "--explain", "--ai-deep", "--deep", "--ai-cache"}
    controls_with_value = {
        "--ai-agent",
        "--agent",
        "--ai-depth",
        "--depth",
        "--ai-model",
        "--model",
        "--session",
        "--ai-question",
    }
    retained, moved = [], []
    index = 0
    while index < len(prefix):
        value = prefix[index]
        if value in controls:
            moved.append(value)
            index += 1
        elif value in controls_with_value:
            if index + 1 == len(prefix):
                raise ValueError(f"{value} requires a value")
            moved.extend([value, prefix[index + 1]])
            index += 2
        elif any(value.startswith(f"{option}=") for option in controls_with_value):
            moved.append(value)
            index += 1
        else:
            retained.append(value)
            index += 1
    return [*retained, command, *moved, *suffix]


def build_log_query(source: str, node_id: str, datastore_id: str, shard_id: str) -> str:
    if source == "dfly":
        if not shard_id:
            raise RuntimeError(f"could not identify the shard for {node_id}")
        return (
            '{service_name=~"systemd_journal|dfcloud-logs"}'
            " | systemd_unit=`dragonfly.service`"
            f" | datastore_id=`{datastore_id}`"
            f" | shard_id=`{shard_id}`"
            f" | node_id=`{node_id}` |= ``"
        )
    if source == "agent":
        return (
            '{service_name=~"systemd_journal|dfcloud-logs"}'
            " | systemd_unit=`dfcloud-agent.service`"
            f" | datastore_id=`{datastore_id}`"
            f" | node_id=`{node_id}` |= ``"
        )
    raise ValueError("source must be 'dfly' or 'agent'")


def build_log_command(
    source: str,
    node_id: str,
    datastore_id: str,
    shard_id: str,
    start: str,
    end: str,
    context: str,
    limit: int | None,
    datasource: str | None = None,
) -> list[str]:
    command = [
        "gcx",
        "--context",
        context,
        "logs",
        "query",
        "--from",
        start,
        "--to",
        end,
    ]
    if limit is not None:
        command.extend(["--limit", str(limit)])
    if datasource:
        command.extend(["--datasource", datasource])
    return command + ["-o", "raw", build_log_query(source, node_id, datastore_id, shard_id)]


def dashboard_output_component(value: str, field: str) -> str:
    if not value or value.strip() in {".", ".."}:
        raise ValueError(f"{field} must be a non-empty path component")
    normalized = re.sub(r"\s+", "_", value.strip())
    normalized = re.sub(r"[^A-Za-z0-9._-]+", "_", normalized)
    normalized = re.sub(r"_+", "_", normalized).strip("._")
    if not normalized:
        raise ValueError(f"{field} has no usable filesystem characters")
    return normalized


def close_match_message(requested: str, candidates: list[str], kind: str) -> str:
    matches = get_close_matches(requested, sorted(set(candidates)), n=5, cutoff=0.35)
    if not matches:
        return ""
    return f" Close {kind} titles: {', '.join(repr(match) for match in matches)}."


def panel_title(panel: dict) -> str:
    spec = panel.get("spec", {})
    return spec.get("title") or spec.get("vizConfig", {}).get("spec", {}).get("options", {}).get(
        "title", ""
    )


def replace_dashboard_variables(
    expression: str, datastore_id: str, shard_id: str, node_id: str, rate_interval: str
) -> str:
    values = {
        "$datastore_id": datastore_id,
        "$shard_id": shard_id,
        "$node_id": node_id,
        "$__interval": DEFAULT_DASHBOARD_QUERY_STEP,
        "$__rate_interval": rate_interval,
    }
    for variable, value in values.items():
        expression = expression.replace(variable, value)
    if re.search(r"\$(?:\{[^}]+\}|[A-Za-z_][A-Za-z0-9_]*)", expression):
        raise ValueError(f"panel query has an unsupported Grafana variable: {expression}")
    return expression


def run_gcx_json(command: list[str]) -> dict:
    try:
        result = subprocess.run(
            command,
            text=True,
            capture_output=True,
            check=False,
            timeout=DEFAULT_CONTROL_PLANE_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError(
            f"gcx timed out after {DEFAULT_CONTROL_PLANE_TIMEOUT_SECONDS}s"
        ) from error
    if result.returncode:
        error = result.stderr.strip() or result.stdout.strip() or "no output"
        raise RuntimeError(f"{' '.join(command)} failed: {error}")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError(f"gcx did not return valid JSON: {error.msg}") from error


def gcx_command(context: str | None, *arguments: str) -> list[str]:
    return ["gcx", *(["--context", context] if context else []), *arguments]


def resolve_loki_datasource(context: str, datasource: str | None) -> str:
    if datasource:
        return datasource
    payload = run_gcx_json(gcx_command(context, "datasources", "list", "-o", "json"))
    records = payload.get("datasources", [])
    candidates = [
        (str(record.get("name", "")), str(record.get("uid", "")))
        for record in records
        if isinstance(record, dict)
        and str(record.get("name", "")).lower().endswith("-logs")
        and str(record.get("uid", ""))
    ]
    if len(candidates) == 1:
        return candidates[0][1]
    names = ", ".join(repr(name) for name, _ in candidates) or "none"
    raise RuntimeError(
        "could not select a unique Grafana logs datasource; candidates: "
        f"{names}. Use --loki-datasource only to override this selection."
    )


def write_json(path: Path, value: object) -> None:
    temporary_path = path.with_name(f".{path.name}.tmp")
    temporary_path.write_text(json.dumps(value, indent=2) + "\n")
    temporary_path.replace(path)


def export_resolved_dashboard_panel(
    source_folder: str,
    source_folder_id: str,
    dashboard_title: str,
    dashboard_id: str,
    dashboard: dict,
    requested_panel_title: str,
    panel: dict,
    section: str | None,
    output_dir: Path,
    start: str,
    end: str,
    datastore_id: str,
    shard_id: str,
    node_id: str,
    rate_interval: str,
    context: str | None,
    datasource: str,
    pacer: RequestPacer,
    resume: bool,
    verbose: bool = True,
) -> str:
    queries = panel.get("spec", {}).get("data", {}).get("spec", {}).get("queries", [])
    exports = []
    for query in queries:
        query_spec = query.get("spec", {}).get("query", {})
        if query.get("spec", {}).get("hidden") or query_spec.get("group") != "prometheus":
            continue
        expression = query_spec.get("spec", {}).get("expr")
        if not expression:
            continue
        exports.append(
            {
                "ref_id": query.get("spec", {}).get("refId", "unnamed"),
                "datasource": query_spec.get("datasource", {}).get("name", datasource),
                "expression": replace_dashboard_variables(
                    expression, datastore_id, shard_id, node_id, rate_interval
                ),
            }
        )
    if verbose:
        print(f"Output directory: {output_dir}")
        print(f"Dashboard: {dashboard_title} ({dashboard_id})")
    output_dir.mkdir(parents=True, exist_ok=True)
    dashboard_path = output_dir / "dashboard.json"
    if not resume or not dashboard_path.exists():
        write_json(dashboard_path, dashboard)
    if not exports:
        manifest = {
            "source_folder": source_folder,
            "source_folder_id": source_folder_id,
            "dashboard": dashboard_title,
            "dashboard_id": dashboard_id,
            "panel": requested_panel_title,
            "section": section,
            "from": start,
            "to": end,
            "queries": [],
            "status": "skipped",
            "skip_reason": "no visible Prometheus queries",
        }
        write_json(output_dir / "manifest.json", manifest)
        if verbose:
            print(f"Panel: {requested_panel_title}; skipped: no visible Prometheus queries")
        return "skipped"

    if verbose:
        print(f"Panel: {requested_panel_title}; queries: {len(exports)}")
        print(f"Window: {start} to {end}; remote request starts are paced at one per second.")
    manifest = {
        "source_folder": source_folder,
        "source_folder_id": source_folder_id,
        "dashboard": dashboard_title,
        "dashboard_id": dashboard_id,
        "grafana_folder_id": dashboard.get("metadata", {})
        .get("annotations", {})
        .get("grafana.app/folder", ""),
        "panel": requested_panel_title,
        "section": section,
        "from": start,
        "to": end,
        "queries": exports,
        "status": "in_progress",
    }
    manifest_path = output_dir / "manifest.json"
    completed_outputs = set()
    if resume and manifest_path.exists():
        try:
            previous_manifest = json.loads(manifest_path.read_text())
        except json.JSONDecodeError:
            previous_manifest = {}
        required_fields = (
            "source_folder",
            "source_folder_id",
            "dashboard",
            "dashboard_id",
            "panel",
            "section",
            "from",
            "to",
        )
        if all(previous_manifest.get(field) == manifest[field] for field in required_fields):
            previous_queries = previous_manifest.get("queries", [])
            if isinstance(previous_queries, list):
                for index, export in enumerate(exports, start=1):
                    if index > len(previous_queries):
                        break
                    previous_query = previous_queries[index - 1]
                    output = f"query_{index}_{dashboard_output_component(export['ref_id'], 'refId')}.json"
                    if (
                        previous_query.get("output") == output
                        and (output_dir / output).is_file()
                        and all(
                            previous_query.get(field) == export[field]
                            for field in ("ref_id", "datasource", "expression")
                        )
                    ):
                        completed_outputs.add(output)
    write_json(manifest_path, manifest)
    for index, export in enumerate(exports, start=1):
        output = (
            output_dir
            / f"query_{index}_{dashboard_output_component(export['ref_id'], 'refId')}.json"
        )
        if output.name in completed_outputs:
            export["output"] = output.name
            if verbose:
                print(f"Resumed {export['ref_id']}: {output}")
            write_json(manifest_path, manifest)
            continue
        query_datasource = export["datasource"] or datasource
        command = gcx_command(
            context,
            "datasources",
            "prometheus",
            "query",
            "-d",
            query_datasource,
            export["expression"],
            "--from",
            start,
            "--to",
            end,
            "--step",
            DEFAULT_DASHBOARD_QUERY_STEP,
            "-o",
            "json",
        )
        pacer.wait()
        result = subprocess.run(command, text=True, capture_output=True, check=False)
        output.write_text(result.stdout)
        if result.stderr and verbose:
            print(result.stderr, end="", file=sys.stderr)
        if result.returncode:
            raise RuntimeError(f"query {export['ref_id']} failed; response saved to {output}")
        export["output"] = output.name
        if verbose:
            print(f"Saved {export['ref_id']}: {output}")
        write_json(manifest_path, manifest)
    manifest["status"] = "completed"
    write_json(manifest_path, manifest)
    return "completed"


def get_logs(
    node_id: str,
    start: str,
    end: str,
    environment: str,
    context: str,
    source: str,
    limit: int | None,
    datastore_id: str | None,
    shard_id: str | None,
    output: Path | None,
    dry_run: bool = False,
) -> int:
    if not node_id.startswith("node_"):
        raise ValueError("node_id must begin with 'node_'")
    if datastore_id and not datastore_id.startswith("dst_"):
        raise ValueError("datastore_id must begin with 'dst_'")
    if shard_id and not shard_id.startswith("shard_"):
        raise ValueError("shard_id must begin with 'shard_'")
    if limit is not None and limit <= 0:
        raise ValueError("limit must be positive")

    start_time = datetime.strptime(start, "%Y-%m-%dT%H:%M:%SZ")
    end_time = datetime.strptime(end, "%Y-%m-%dT%H:%M:%SZ")
    if end_time <= start_time:
        raise ValueError("end time must be after start time")

    if dry_run:
        if not datastore_id or not shard_id:
            raise ValueError("--dry-run requires both --datastore-id and --shard-id")
        command = build_log_command(
            source, node_id, datastore_id, shard_id, start, end, context, limit
        )
        print("Dry run: no log query will be sent.")
        print(f"Planned command: {shlex.join(command)}")
        if output:
            print(f"Planned local output: {output}")
        return 0

    node_shard_id, node_datastore_id = get_node_details(environment, node_id)
    datastore_id = datastore_id or node_datastore_id
    shard_id = shard_id or node_shard_id
    if not datastore_id or not shard_id:
        raise RuntimeError(f"could not identify the datastore and shard for {node_id}")

    command = build_log_command(source, node_id, datastore_id, shard_id, start, end, context, limit)
    if output is None:
        result = subprocess.run(command, text=True, capture_output=True, check=False)
        print(result.stdout, end="")
        if result.stderr:
            print(result.stderr, end="", file=sys.stderr)
    else:
        with output.open("wb") as stream:
            result = subprocess.run(command, stdout=stream, stderr=subprocess.PIPE, check=False)
        if result.stderr:
            print(result.stderr.decode(errors="replace"), end="", file=sys.stderr)
    if result.returncode == 0 and (
        not result.stdout if output is None else output.stat().st_size == 0
    ):
        print(
            warning_message(
                "log query returned no records; check the date, time window, source, and labels."
            ),
            file=sys.stderr,
        )
    return result.returncode


def run_archived_log_query(
    source: str,
    node_id: str,
    shard_id: str,
    datastore_id: str,
    start: str,
    end: str,
    context: str,
    limit: int | None,
    output: Path,
    datasource: str | None = None,
) -> int:
    command = build_log_command(
        source, node_id, datastore_id, shard_id, start, end, context, limit, datasource
    )
    with output.open("wb") as stream:
        result = subprocess.run(command, stdout=stream, stderr=subprocess.PIPE, check=False)
    if result.stderr:
        print(f"{node_id}: {result.stderr.decode(errors='replace')}", end="", file=sys.stderr)
    if result.returncode == 0 and output.stat().st_size == 0:
        print(
            warning_message(
                f"{node_id} ({source}): log query returned no records; check the date, time window, source, and labels."
            ),
            file=sys.stderr,
        )
    return result.returncode


def archive_path_for(output_dir: Path, archive_started_at: datetime) -> Path:
    resolved_output_dir = output_dir.resolve()
    timestamp = archive_started_at.strftime("%Y%m%dT%H%M%SZ")
    return resolved_output_dir / f"downloaded_logs_{timestamp}.tar.gz"


def archive_downloaded_logs(
    log_paths: list[Path], output_dir: Path, archive_started_at: datetime
) -> Path | None:
    downloaded_logs = sorted(path for path in log_paths if path.is_file())
    if not downloaded_logs:
        return None

    archive_path = archive_path_for(output_dir, archive_started_at)
    with tarfile.open(archive_path, "w:gz") as archive:
        for log_path in downloaded_logs:
            archive.add(log_path, arcname=log_path.name)
    return archive_path


def log_filename(datastore_id: str, node_id: str, source: str, start: str, end: str) -> str:
    start_stamp = start.replace("-", "").replace(":", "")
    end_stamp = end.replace("-", "").replace(":", "")
    return f"{datastore_id}_{node_id}_{source}_{start_stamp}_{end_stamp}.log"


def run_dfadmin(environment: str, *arguments: str, allow_failure: bool = False) -> str:
    command = ["dfadmin-wrapper", "--env", environment, *arguments]
    try:
        result = subprocess.run(
            command,
            text=True,
            capture_output=True,
            check=False,
            timeout=DEFAULT_CONTROL_PLANE_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError(
            f"dfadmin timed out after {DEFAULT_CONTROL_PLANE_TIMEOUT_SECONDS}s"
        ) from error
    if result.returncode != 0 and not allow_failure:
        error = result.stderr.strip() or result.stdout.strip() or "no output"
        raise RuntimeError(f"{' '.join(command)} failed: {error}")
    return result.stdout.strip()


def run_dfadmin_json(environment: str, *arguments: str) -> object:
    output = run_dfadmin(environment, *arguments, "--output", "json")
    try:
        return json.loads(output)
    except json.JSONDecodeError as error:
        raise RuntimeError(f"dfadmin did not return valid JSON: {error.msg}") from error


def rethrow_missing_resource(error: Exception, resource_type: str, resource_id: str) -> None:
    message = str(error)
    if re.search(r"\bnot\s+(?:found|fo)\b|does not exist", message, re.IGNORECASE):
        raise ValueError(
            f"{resource_type} {resource_id} does not exist in the selected environment"
        ) from error
    raise error


def get_resource_show_json(
    environment: str, resource_type: str, resource_id: str, *arguments: str
) -> object:
    try:
        return run_dfadmin_json(environment, resource_type, "show", resource_id, *arguments)
    except RuntimeError as error:
        rethrow_missing_resource(error, resource_type, resource_id)


def redact_audit_value(value: object) -> object:
    if isinstance(value, dict):
        return {
            key: (
                "<redacted>"
                if re.search(
                    r"(?:^|_)(metadata|password|secret|token|authorization|credential|api_key)(?:$|_)",
                    key,
                    re.IGNORECASE,
                )
                else redact_audit_value(child)
            )
            for key, child in value.items()
        }
    if isinstance(value, list):
        return [redact_audit_value(child) for child in value]
    return value


def audit_events(payload: object) -> list[object]:
    if isinstance(payload, list):
        return payload
    if isinstance(payload, dict):
        for name in ("events", "items", "audit_logs", "data"):
            value = payload.get(name)
            if isinstance(value, list):
                return value
    return [payload]


def audit_log(
    environment: str, resource_id: str, since: str, until: str, limit: int, json_output: bool
) -> int:
    if not resource_id:
        raise ValueError("resource ID must not be empty")
    if not 1 <= limit <= 100:
        raise ValueError("--limit must be between 1 and 100")
    request_since = format_audit_timestamp(since)
    request_until = format_audit_timestamp(until)
    payload = run_dfadmin_json(
        environment,
        "audit-log",
        "list",
        "--from",
        request_since,
        "--to",
        request_until,
        "--resource-id",
        resource_id,
        "--search-metadata",
        "--limit",
        str(limit),
    )
    events = [redact_audit_value(event) for event in audit_events(payload)]
    report = {
        "schema_version": AUDIT_SCHEMA_VERSION,
        "command": "audit",
        "environment": environment,
        "resource_id": resource_id,
        "from": request_since,
        "to": request_until,
        "events": events,
    }
    if json_output:
        print(json.dumps(report, indent=2, sort_keys=True))
        return 0
    print("Skipper Audit Report")
    print(f"Environment: {environment}")
    print(f"Resource: {resource_id}")
    print(f"Window: {request_since} to {request_until} UTC")
    print(f"Events: {len(events)}")
    for index, event in enumerate(events, 1):
        print(f"\nEvent {index}:")
        print(json.dumps(format_audit_event_for_display(event), indent=2, sort_keys=True))
    return 0


def extract_field(node_details: str, field: str) -> str:
    match = re.search(rf"^\s*{re.escape(field)}:\s*(.+?)\s*$", node_details, re.MULTILINE)
    return match.group(1) if match else ""


@functools.lru_cache(maxsize=None)
def get_node_metadata(environment: str, node_id: str) -> tuple[str, str, str, str, str]:
    try:
        details = run_dfadmin(environment, "node", "show", node_id)
    except RuntimeError as error:
        rethrow_missing_resource(error, "node", node_id)
    return (
        extract_field(details, "shard_id"),
        extract_field(details, "datastore_id"),
        extract_field(details, "role"),
        extract_field(details, "public_ip"),
        extract_field(details, "private_ip"),
    )


def get_node_details(environment: str, node_id: str) -> tuple[str, str]:
    shard_id, datastore_id, _, _, _ = get_node_metadata(environment, node_id)
    return shard_id, datastore_id


def get_node_address(environment: str, node_id: str) -> tuple[str, str, str, str]:
    shard_id, _, role, public_ip, private_ip = get_node_metadata(environment, node_id)
    return shard_id, role, public_ip, private_ip


def get_shard_node_ids(environment: str, shard_id: str) -> list[str]:
    shard = get_resource_show_json(environment, "shard", shard_id, "--nodes")

    node_ids = []
    for record in find_node_records(shard):
        node_id = first_value(record, {"node_id"})
        if node_id and node_id not in node_ids:
            node_ids.append(node_id)
    if not node_ids:
        raise RuntimeError(f"dfadmin returned no node records for shard {shard_id}")
    return node_ids


def get_datastore_node_ids(environment: str, datastore_id: str) -> list[str]:
    return list(get_datastore_nodes(environment, datastore_id))


@functools.lru_cache(maxsize=None)
def get_customer_datastores(environment: str, customer_id: str) -> tuple[tuple[str, str], ...]:
    if not re.fullmatch(r"cus_[A-Za-z0-9]+", customer_id):
        raise ValueError(f"invalid customer target {customer_id!r}")
    payload = run_dfadmin_json(environment, "datastore", "list", "--customer-id", customer_id)
    records = payload.get("datastores") if isinstance(payload, dict) else None
    datastores = {
        (str(record.get("datastore_id")), str(record.get("name") or ""))
        for record in records or []
        if isinstance(record, dict) and str(record.get("datastore_id", "")).startswith("dst_")
    }
    if not datastores:
        raise ValueError(f"customer target {customer_id!r} has no active datastores")
    return tuple(sorted(datastores))


def get_customer_datastore_ids(environment: str, customer_id: str) -> tuple[str, ...]:
    return tuple(
        datastore_id for datastore_id, _ in get_customer_datastores(environment, customer_id)
    )


def expand_customer_targets(environment: str, targets: Sequence[str]) -> list[str]:
    expanded = []
    for target in targets:
        if target.startswith("cus_"):
            expanded.extend(get_customer_datastore_ids(environment, target))
        else:
            expanded.append(target)
    return sorted(set(expanded))


def get_datastore_nodes(
    environment: str, datastore_id: str
) -> dict[str, tuple[str, str, str, str, str]]:
    datastore = get_resource_show_json(
        environment, "datastore", datastore_id, "--shards", "--nodes"
    )

    nodes = {}
    for record in find_node_records(datastore):
        node_id = first_value(record, {"node_id"})
        if node_id:
            nodes[node_id] = (
                first_value(record, {"shard_id"}),
                first_value(record, {"datastore_id"}) or datastore_id,
                first_value(record, {"role"}),
                first_value(record, {"public_ip"}),
                first_value(record, {"private_ip"}),
            )
    if not nodes:
        raise RuntimeError(f"dfadmin returned no node records for datastore {datastore_id}")
    return nodes


def is_sensitive_field(name: str) -> bool:
    return bool(
        re.search(
            r"(?:^|_)(password|secret|token|authorization|credential|api_key|acl_rules)(?:$|_)|^(masterauth|requirepass)$",
            name,
            re.IGNORECASE,
        )
    )


def print_schema_tree(value: object, indent: int = 0) -> None:
    prefix = "  " * indent
    if isinstance(value, dict):
        scalar_names = []
        nested_names = []
        for name, child in value.items():
            if isinstance(child, dict):
                nested_names.append(name)
            elif isinstance(child, list):
                nested_names.append(name)
            else:
                scalar_names.append(name)
        if scalar_names:
            fields = ", ".join(
                f"{name}{' [sensitive]' if is_sensitive_field(name) else ''}"
                for name in scalar_names
            )
            print(f"{prefix}{{{fields}}}")
        for name in nested_names:
            child = value[name]
            sensitive = " [sensitive]" if is_sensitive_field(name) else ""
            if isinstance(child, dict):
                print(f"{prefix}{name}{sensitive}")
                print_schema_tree(child, indent + 1)
            else:
                print(f"{prefix}{name}[]{sensitive}")
                if child:
                    print_schema_tree(child[0], indent + 1)
    elif isinstance(value, list) and value:
        print_schema_tree(value[0], indent)


def resolve_schema_resource(environment: str, target: str, schema: str) -> tuple[str, str]:
    inferred = (
        "node"
        if target.startswith("node_")
        else (
            "shard"
            if target.startswith("shard_")
            else "datastore" if target.startswith("dst_") else ""
        )
    )
    if not inferred:
        raise ValueError(
            "target must be a node ID (node_...), shard ID (shard_...), or datastore ID (dst_...)"
        )
    resource_type = inferred if schema == "auto" else schema
    if resource_type == "node":
        if inferred == "node":
            return resource_type, target
        node_ids = (
            get_shard_node_ids(environment, target)
            if inferred == "shard"
            else get_datastore_node_ids(environment, target)
        )
        return resource_type, sorted(node_ids)[0]
    if resource_type == "shard":
        if inferred == "shard":
            return resource_type, target
        if inferred == "node":
            shard_id, _ = get_node_details(environment, target)
            if shard_id:
                return resource_type, shard_id
    if resource_type == "datastore":
        if inferred == "datastore":
            return resource_type, target
        node_id = (
            target if inferred == "node" else sorted(get_shard_node_ids(environment, target))[0]
        )
        _, datastore_id = get_node_details(environment, node_id)
        if datastore_id:
            return resource_type, datastore_id
    raise ValueError(f"could not resolve {resource_type} schema from {target}")


def show_schema(environment: str, target: str, schema: str) -> int:
    resource_type, resource_id = resolve_schema_resource(environment, target, schema)
    payload = normalize_show_payload(
        resource_type, get_resource_show_json(environment, resource_type, resource_id)
    )
    print(f"Schema: {resource_type} ({resource_id})")
    print_schema_tree(payload)
    print("\nSchema notation (this compact outline is not JSON):")
    print(
        "  {a, b}       object fields whose values are scalars (string, number, boolean, or null)"
    )
    print("  name         nested object/map")
    print("  name[]       list/array")
    print("  <node_id>    dynamic-key map; the key is a resource ID, not a literal field name")
    print("  [sensitive]  values are redacted by multi")
    print("\nCompare fields:")
    print(f"  dfly-inspect multi {resource_id} --resource {resource_type} --field status.state")
    print(f"  dfly-inspect multi {resource_id} --resource {resource_type} --prefix status")
    return 0


def resolve_multi_resource_ids(
    environment: str, resource_type: str, targets: list[str]
) -> list[str]:
    resource_ids = set()
    for target in expand_customer_targets(environment, targets):
        if target.startswith("node_"):
            if resource_type == "node":
                resource_ids.add(target)
            else:
                shard_id, datastore_id = get_node_details(environment, target)
                resource_ids.add({"shard": shard_id, "datastore": datastore_id}[resource_type])
        elif target.startswith("shard_"):
            if resource_type == "node":
                resource_ids.update(get_shard_node_ids(environment, target))
            elif resource_type == "shard":
                resource_ids.add(target)
            else:
                _, datastore_id = get_node_details(
                    environment, sorted(get_shard_node_ids(environment, target))[0]
                )
                resource_ids.add(datastore_id)
        elif target.startswith("dst_"):
            if resource_type == "node":
                resource_ids.update(get_datastore_node_ids(environment, target))
            elif resource_type == "shard":
                resource_ids.update(
                    metadata[0] for metadata in get_datastore_nodes(environment, target).values()
                )
            else:
                resource_ids.add(target)
        else:
            raise ValueError(
                f"{target!r} must be a target ID (cus_..., dst_..., shard_..., or node_...)"
            )
    if not all(resource_ids):
        raise RuntimeError(f"could not resolve {resource_type} IDs for all targets")
    return sorted(resource_ids)


def infer_multi_resource_type(targets: list[str]) -> str:
    target_types = {
        (
            "node"
            if target.startswith("node_")
            else (
                "shard"
                if target.startswith("shard_")
                else "datastore" if target.startswith("dst_") else ""
            )
        )
        for target in targets
    }
    return target_types.pop() if len(target_types) == 1 and "" not in target_types else "node"


def is_sensitive_path(path: str) -> bool:
    return any(is_sensitive_field(component) for component in path.split("."))


def normalize_show_payload(resource_type: str, payload: object) -> object:
    if isinstance(payload, dict) and isinstance(payload.get(resource_type), dict):
        return payload[resource_type]
    return payload


def flatten_scalar_fields(value: object, prefix: str = "") -> dict[str, object]:
    if isinstance(value, dict):
        fields = {}
        for name, child in value.items():
            path = f"{prefix}.{name}" if prefix else name
            fields.update(flatten_scalar_fields(child, path))
        return fields
    if isinstance(value, list):
        return {prefix: value}
    return {prefix: value}


def get_nested_value(value: object, path: str) -> object | None:
    current = value
    for component in path.split("."):
        if not isinstance(current, dict) or component not in current:
            return None
        current = current[component]
    return current


def display_multi_value(value: object, path: str) -> str:
    if value is None:
        return "nil"
    if is_sensitive_path(path):
        return "<redacted>"
    if isinstance(value, (dict, list)):
        return json.dumps(value, sort_keys=True, separators=(",", ":"))
    return str(value)


def truncate_multi_value(value: str, maximum_width: int | None) -> str:
    if maximum_width is None or len(value) <= maximum_width:
        return value
    if maximum_width < 4:
        return value[:maximum_width]
    return f"{value[:maximum_width - 3]}..."


def print_multi_table(
    columns: list[str],
    rows: Sequence[Mapping[str, object]],
    maximum_width: int | None,
    render: bool = True,
) -> int:
    display_rows = [
        {
            column: (
                str(row.get(column, "nil"))
                if column.endswith("_id") or column == "error"
                else truncate_multi_value(str(row.get(column, "nil")), maximum_width)
            )
            for column in columns
        }
        for row in rows
    ]
    widths = [max(len(column), *(len(row[column]) for row in display_rows)) for column in columns]
    if render:
        print("  ".join(f"{column:<{width}}" for column, width in zip(columns, widths)))
        print("  ".join("-" * width for width in widths))
        for row in display_rows:
            print("  ".join(f"{row[column]:<{width}}" for column, width in zip(columns, widths)))
    return sum(widths) + 2 * (len(widths) - 1)


def table_exceeds_terminal_width(
    columns: list[str], rows: Sequence[Mapping[str, object]], maximum_width: int | None
) -> tuple[int, int] | None:
    table_width = print_multi_table(columns, rows, maximum_width, render=False)
    terminal_width = shutil.get_terminal_size(fallback=(120, 24)).columns
    return (table_width, terminal_width) if table_width > terminal_width else None


def print_multi_vertical(
    resource_type: str, columns: list[str], rows: list[dict[str, str]], maximum_width: int | None
) -> None:
    resource_column = f"{resource_type}_id"
    for index, row in enumerate(rows):
        if index:
            print()
        print(f"{resource_column}: {row[resource_column]}")
        for column in columns:
            print(f"{column}: {truncate_multi_value(row[column], maximum_width)}")
        if row["error"]:
            print(f"error: {row['error']}")


def multi_show(
    environment: str,
    resource_type: str,
    targets: list[str],
    fields: list[str],
    prefix: str | None,
    workers: int,
    output_format: str | bool,
    maximum_width: int | None = None,
    max_elements: int | None = None,
) -> int:
    if not 1 <= workers <= DEFAULT_MULTI_WORKERS:
        raise ValueError(f"--workers must be between 1 and {DEFAULT_MULTI_WORKERS}")
    if maximum_width is not None and maximum_width <= 0:
        raise ValueError("--max-column-width must be positive")
    if max_elements is not None and max_elements <= 0:
        raise ValueError("--max-elements must be positive")
    if not fields and not prefix:
        raise ValueError("supply at least one --field or --prefix")
    if isinstance(output_format, bool):
        output_format = "json" if output_format else "table"
    resource_ids = resolve_multi_resource_ids(environment, resource_type, targets)
    total_resources = len(resource_ids)
    if max_elements is not None and total_resources == 1:
        raise ValueError("--max-elements cannot be used when only one resource is selected")
    resource_ids = resource_ids[:max_elements]
    truncated = len(resource_ids) < total_resources

    def fetch(resource_id: str) -> tuple[str, object | None, str | None]:
        try:
            payload = get_resource_show_json(environment, resource_type, resource_id)
            return resource_id, normalize_show_payload(resource_type, payload), None
        except (RuntimeError, ValueError) as error:
            try:
                rethrow_missing_resource(error, resource_type, resource_id)
            except ValueError as normalized_error:
                return resource_id, None, str(normalized_error)
            return resource_id, None, str(error)

    results = {}
    with ThreadPoolExecutor(max_workers=min(workers, len(resource_ids))) as executor:
        futures = [executor.submit(fetch, resource_id) for resource_id in resource_ids]
        for future in as_completed(futures):
            resource_id, payload, error = future.result()
            results[resource_id] = (payload, error)

    columns = list(dict.fromkeys(fields))
    if prefix:
        prefix_values = [
            get_nested_value(payload, prefix)
            for payload, error in results.values()
            if error is None and payload is not None
        ]
        if not any(value is not None for value in prefix_values):
            hint = (
                " Try --resource node to compare every node selected by the target."
                if resource_type != "node"
                else ""
            )
            raise ValueError(
                f"--prefix {prefix!r} does not exist on {resource_type} records.{hint}"
            )
        prefix_columns = sorted(
            {
                path
                for value in prefix_values
                if value is not None
                for path in flatten_scalar_fields(value, prefix)
            }
        )
        if not prefix_columns:
            raise ValueError(f"no scalar fields found below --prefix {prefix!r}")
        columns = list(dict.fromkeys([*columns, *prefix_columns]))
    rows = []
    for resource_id in resource_ids:
        payload, error = results[resource_id]
        row = {resource_type + "_id": resource_id, "error": error or ""}
        if payload is not None:
            values = flatten_scalar_fields(payload)
            for field in columns:
                row[field] = display_multi_value(values.get(field), field)
        else:
            row.update({field: "nil" for field in columns})
        rows.append(row)
    report = {
        "command": "multi",
        "environment": environment,
        "resource_type": resource_type,
        "targets": targets,
        "total_elements": total_resources,
        "selected_elements": len(rows),
        "truncated": truncated,
        "columns": columns,
        "rows": [
            {name: value for name, value in row.items() if name != "error" or value} for row in rows
        ],
    }
    if output_format == "json":
        print(json.dumps(report, indent=2, sort_keys=True))
    elif output_format == "vertical":
        if truncated:
            print(
                warning_message(
                    f"showing {len(rows)} of {total_resources} resources; results are partial."
                ),
                file=sys.stderr,
            )
        print_multi_vertical(resource_type, columns, rows, maximum_width)
    else:
        table_columns = [f"{resource_type}_id", *columns]
        if any(row["error"] for row in rows):
            table_columns.append("error")
        table_dimensions = table_exceeds_terminal_width(table_columns, rows, maximum_width)
        if table_dimensions:
            table_width, terminal_width = table_dimensions
            print(
                warning_message(
                    f"table width {table_width} exceeds terminal width {terminal_width} "
                    f"({len(columns)} selected fields); using vertical output."
                ),
                file=sys.stderr,
            )
            if truncated:
                print(
                    warning_message(
                        f"showing {len(rows)} of {total_resources} resources; results are partial."
                    ),
                    file=sys.stderr,
                )
            print_multi_vertical(resource_type, columns, rows, maximum_width)
        else:
            print_multi_table(table_columns, rows, maximum_width)
            if truncated:
                print(
                    warning_message(
                        f"showing {len(rows)} of {total_resources} resources; results are partial."
                    ),
                    file=sys.stderr,
                )
        if len(columns) > 10 and not table_dimensions:
            print(
                warning_message(
                    f"{len(columns)} selected columns may be hard to scan; "
                    "Use --format vertical, --format json, or --max-column-width."
                ),
                file=sys.stderr,
            )
    return 0 if not any(row["error"] for row in rows) else 1


def health_reports(
    environment: str,
    targets: Sequence[str],
    bastion: str,
    workers: int,
    output_format: str,
    max_elements: int | None = None,
) -> int:
    datastore_targets = expand_customer_targets(environment, targets)
    statuses = []
    for index, target in enumerate(datastore_targets):
        if index and output_format != "json":
