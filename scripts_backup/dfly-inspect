        {"question": question, "source": source, "output": output[:MAX_AGENT_CONTEXT_BYTES]},
        default_agent_context(),
        depth,
        model,
    )
    answer = response.get("answer")
    if not isinstance(answer, str) or not answer.strip():
        raise RuntimeError(f'{agent_name} must return {{"answer":"..."}}')
    result = {"agent": agent_name, "model": model, "source": source, "answer": answer.strip()}
    if use_cache:
        write_ai_cache(result, agent_name, question, source, output, depth, model)
        result["cache"] = "stored"
    return result


