    return 1 if any(statuses) else 0


def archive_logs(
    environment: str,
    targets: list[str],
    start: str,
    end: str,
    context: str,
    limit: int | None,
    output_dir: Path,
    max_workers: int | None,
    source: str,
    compress: bool,
    dry_run: bool,
    max_elements: int | None = None,
    datasource: str | None = None,
) -> int:
    if limit is not None and limit <= 0:
        raise ValueError("limit must be positive")
    if max_workers is not None and max_workers <= 0:
        raise ValueError("max-workers must be positive")
    if max_elements is not None and max_elements <= 0:
        raise ValueError("--max-elements must be positive")
    if datetime.strptime(end, "%Y-%m-%dT%H:%M:%SZ") <= datetime.strptime(
        start, "%Y-%m-%dT%H:%M:%SZ"
    ):
        raise ValueError("end time must be after start time")

    effective_workers = max_workers or DEFAULT_LOG_ARCHIVER_WORKERS
    worker_source = "explicit" if max_workers is not None else "default"
    datasource = resolve_loki_datasource(context, datasource)

    pacer = RequestPacer()
    resolved_nodes: dict[str, tuple[str, str, str, str, str]] = {}
    for target in targets:
        if target.startswith("dst_"):
            pacer.wait()
            resolved_nodes.update(get_datastore_nodes(environment, target))
        elif target.startswith("shard_"):
            pacer.wait()
            for node_id in get_shard_node_ids(environment, target):
                shard_id, datastore_id, role, public_ip, private_ip = get_node_metadata(
                    environment, node_id
                )
                if not datastore_id or not shard_id:
                    raise RuntimeError(f"could not identify the datastore and shard for {node_id}")
                resolved_nodes[node_id] = (shard_id, datastore_id, role, public_ip, private_ip)
        elif target.startswith("node_"):
            pacer.wait()
            shard_id, datastore_id, role, public_ip, private_ip = get_node_metadata(
                environment, target
            )
            if not datastore_id or not shard_id:
                raise RuntimeError(f"could not identify the datastore and shard for {target}")
            resolved_nodes[target] = (shard_id, datastore_id, role, public_ip, private_ip)
        else:
            raise ValueError(
                f"{target!r} must be a node ID (node_...), shard ID (shard_...), or datastore ID (dst_...)"
            )

    total_nodes = len(resolved_nodes)
    if max_elements is not None and total_nodes == 1:
        raise ValueError("--max-elements cannot be used when only one node is selected")
    resolved_nodes = dict(sorted(resolved_nodes.items())[:max_elements])
    truncated = len(resolved_nodes) < total_nodes

    sources = ["dfly", "agent"] if source == "all" else [source]
    jobs = []
    for node_id, (shard_id, datastore_id, _, _, _) in sorted(resolved_nodes.items()):
        for log_source in sources:
            if log_source == "dfly" and not shard_id:
                raise RuntimeError(f"could not identify the shard for {node_id}")
            jobs.append(
                (
                    log_source,
                    node_id,
                    shard_id,
                    datastore_id,
                    output_dir
                    / node_id
                    / log_filename(datastore_id, node_id, log_source, start, end),
                )
            )

    limit_description = str(limit) if limit is not None else "unlimited"
    print("Log collection plan")
    print("---")
    print(f"Nodes to download: {len(resolved_nodes)} of {total_nodes}")
    if truncated:
        print(warning_message("node selection is partial due to --max-elements."), file=sys.stderr)
    print(f"Log sources: {', '.join(sources)} ({len(jobs)} files)")
    print(f"Per-node log limit: {limit_description}")
    print(f"Max in-flight workers: {effective_workers} ({worker_source})")
    print("Remote request starts are paced at no more than one per second.")
    print()
    if dry_run:
        for log_source, node_id, shard_id, datastore_id, output in jobs:
            print(f"DRY RUN: {node_id} [{log_source}] {datastore_id} {shard_id} -> {output}")
        print(f"DRY RUN COMPLETE: {len(jobs)} log files for {len(resolved_nodes)} unique nodes.")
        return 0

    output_dir.mkdir(parents=True, exist_ok=True)

    def fetch(job: tuple[str, str, str, str, Path]) -> tuple[str, str, int, Path]:
        log_source, node_id, shard_id, datastore_id, output = job
        pacer.wait()
        output.parent.mkdir(parents=True, exist_ok=True)
        return (
            log_source,
            node_id,
            run_archived_log_query(
                log_source,
                node_id,
                shard_id,
                datastore_id,
                start,
                end,
                context,
                limit,
                output,
                datasource,
            ),
            output,
        )

    failures = 0
    with ThreadPoolExecutor(max_workers=effective_workers) as executor:
        futures = [executor.submit(fetch, job) for job in jobs]
        total_jobs = len(futures)
        for completed_jobs, future in enumerate(as_completed(futures), start=1):
            log_source, node_id, returncode, output = future.result()
            status = "OK" if returncode == 0 else f"FAILED ({returncode})"
            print(
                f"[{completed_jobs}/{total_jobs}, {total_jobs - completed_jobs} remaining] "
                f"{status}: {node_id} [{log_source}] -> {output}"
            )
            failures += returncode != 0
    if compress and not failures:
        archive_path = archive_downloaded_logs(
            [output for _, _, _, _, output in jobs], output_dir, datetime.now(timezone.utc)
        )
        if archive_path:
            print(f"Archived downloaded logs without deleting them: {archive_path}")
    return 1 if failures else 0


def show_addresses(
    environment: str, targets: list[str], json_output: bool = False, max_elements: int | None = None
) -> int:
    if max_elements is not None and max_elements <= 0:
        raise ValueError("--max-elements must be positive")
    nodes: dict[str, tuple[str, str, str, str]] = {}
    unresolved_node_ids = set()
    for target in targets:
        if target.startswith("node_"):
            unresolved_node_ids.add(target)
        elif target.startswith("shard_"):
            unresolved_node_ids.update(get_shard_node_ids(environment, target))
        elif target.startswith("dst_"):
            nodes.update(
                {
                    node_id: (shard_id, role, public_ip, private_ip)
                    for node_id, (shard_id, _, role, public_ip, private_ip) in get_datastore_nodes(
                        environment, target
                    ).items()
                }
            )
        else:
            raise ValueError(
                f"{target!r} must be a node ID (node_...), shard ID (shard_...), or datastore ID (dst_...)"
            )
    all_node_ids = sorted(set(nodes) | unresolved_node_ids)
    total_nodes = len(all_node_ids)
    if max_elements is not None and total_nodes == 1:
        raise ValueError("--max-elements cannot be used when only one node is selected")
    selected_node_ids = all_node_ids[:max_elements]
    truncated = len(selected_node_ids) < total_nodes
    for node_id in selected_node_ids:
        if node_id not in nodes:
            nodes[node_id] = get_node_address(environment, node_id)
    selected_nodes = [(node_id, nodes[node_id]) for node_id in selected_node_ids]

    if json_output:
        print(
            json.dumps(
                {
                    "schema_version": TOPOLOGY_SCHEMA_VERSION,
                    "command": "addresses",
                    "environment": environment,
                    "targets": targets,
                    "total_elements": total_nodes,
                    "selected_elements": len(selected_nodes),
                    "truncated": truncated,
                    "nodes": [
                        {
                            "node_id": node_id,
                            "shard_id": shard_id or None,
                            "role": role or None,
                            "public_ip": public_ip or None,
                            "private_ip": private_ip or None,
                        }
                        for node_id, (shard_id, role, public_ip, private_ip) in selected_nodes
                    ],
                },
                indent=2,
            )
        )
        return 0
    if truncated:
        print(
            warning_message(
                f"showing {len(selected_nodes)} of {total_nodes} nodes; results are partial."
            ),
            file=sys.stderr,
        )
    for index, (node_id, (shard_id, role, public_ip, private_ip)) in enumerate(selected_nodes):
        print(f"Node:       {node_id}")
        print(f"Shard:      {shard_id or '<unavailable>'}")
        print(f"Role:       {role or '<unknown>'}")
        print(f"Public IP:  {public_ip or '<unavailable>'}")
        print(f"Private IP: {private_ip or '<unavailable>'}")
        if index + 1 != len(selected_nodes):
            print()
    return 0


def redact_slowlog_value(value: object) -> object:
    if isinstance(value, list):
        return [redact_slowlog_value(item) for item in value]
    if isinstance(value, str):
        return redact_persisted_output(value)
    return value


def parse_slowlog_response(node_id: str, response: str) -> list[dict[str, object]]:
    """Normalize JSON-shaped SLOWLOG GET output while retaining unknown responses safely."""
    try:
        parsed = json.loads(response)
    except json.JSONDecodeError:
        return [{"node_id": node_id, "raw": redact_persisted_output(response)}]
    entries = (
        parsed
        if isinstance(parsed, list)
        else parsed.get("entries", []) if isinstance(parsed, dict) else []
    )
    if not isinstance(entries, list):
        return [{"node_id": node_id, "raw": redact_persisted_output(response)}]
    rows = []
    for entry in entries:
        if not isinstance(entry, list) or len(entry) < 4:
            rows.append({"node_id": node_id, "raw": redact_slowlog_value(entry)})
            continue
        command = entry[3]
        if isinstance(command, list):
            command = " ".join(str(part) for part in command)
        row = {
            "node_id": node_id,
            "id": entry[0],
            "timestamp": entry[1],
            "duration_us": entry[2],
            "command": redact_slowlog_value(command),
        }
        if len(entry) > 4:
            row["client"] = redact_slowlog_value(entry[4])
        if len(entry) > 5:
            row["client_name"] = redact_slowlog_value(entry[5])
        rows.append(row)
    return rows


def slowlog_markdown(report: dict[str, Any], nodes: list[dict[str, Any]]) -> str:
    lines = [
        "# Dragonfly Slowlog Report",
        "",
        f"- Environment: `{report['environment']}`",
        f"- Requested limit per node: `{report['limit']}`",
        f"- Nodes queried: `{len(nodes)}`",
        "",
    ]
    for node in nodes:
        node_id = node["node_id"]
        lines.extend([f"## {node_id}", ""])
        if node.get("error"):
            lines.extend([f"Error: `{node['error']}`", ""])
            continue
        rows = node["entries"]
        if not rows:
            lines.extend(["No slowlog entries returned.", ""])
            continue
        lines.extend(
            [
                "| ID | Timestamp | Duration (us) | Command | Client |",
                "| --- | --- | --- | --- | --- |",
            ]
        )
        for row in rows:
            command = (
                str(row.get("command", row.get("raw", ""))).replace("|", "\\|").replace("\n", " ")
            )
            lines.append(
                f"| {row.get('id', '')} | {row.get('timestamp', '')} | {row.get('duration_us', '')} | {command} | {row.get('client', '')} |"
            )
        lines.append("")
    return "\n".join(lines)


def slowlog_report(
    environment: str,
    targets: list[str],
    limit: int,
    output_format: str,
    output: Path | None,
    workers: int,
    max_elements: int | None,
    dry_run: bool,
) -> int:
    if not 0 <= limit <= 128:
        raise ValueError("--limit must be between 0 and 128")
    if workers < 1 or workers > DEFAULT_MULTI_WORKERS:
        raise ValueError(f"--workers must be between 1 and {DEFAULT_MULTI_WORKERS}")
    if max_elements is not None and max_elements <= 0:
        raise ValueError("--max-elements must be positive")
    if output is not None and output_format == "table":
        raise ValueError("--output requires --format json or --format markdown")
    if dry_run:
        print("Dry run: no control-plane or Redis requests will be sent.")
        print(f"Planned topology resolution: resolve {', '.join(targets)} to unique node IDs")
        print(
            f"Planned command per resolved node: dfadmin-wrapper --env {environment} node resp NODE_ID -- SLOWLOG GET {limit}"
        )
        print(f"Planned output: {output or 'stdout'} ({output_format})")
        return 0
    node_ids = resolve_multi_resource_ids(environment, "node", targets)
    total_nodes = len(node_ids)
    node_ids = node_ids[:max_elements]

    def fetch(node_id: str) -> dict[str, object]:
        try:
            return {
                "node_id": node_id,
                "entries": parse_slowlog_response(
                    node_id,
                    run_dfadmin(
                        environment, "node", "resp", node_id, "--", "SLOWLOG", "GET", str(limit)
                    ),
                ),
            }
        except RuntimeError as error:
            return {"node_id": node_id, "entries": [], "error": str(error)}

    with ThreadPoolExecutor(max_workers=min(workers, len(node_ids))) as executor:
        nodes: list[dict[str, Any]] = list(executor.map(fetch, node_ids))
    report: dict[str, Any] = {
        "command": "slowlog",
        "environment": environment,
        "targets": targets,
        "limit": limit,
        "total_nodes": total_nodes,
        "selected_nodes": len(nodes),
        "truncated": len(nodes) < total_nodes,
        "nodes": nodes,
    }
    if output_format == "json":
        rendered = json.dumps(report, indent=2, sort_keys=True) + "\n"
    elif output_format == "markdown":
        rendered = slowlog_markdown(report, nodes)
    else:
        rows = [entry for node in nodes for entry in node["entries"]]
        if rows:
            print_multi_table(
                ["node_id", "id", "timestamp", "duration_us", "command", "client"], rows, 80
            )
        else:
            print("No slowlog entries returned.")
        for node in nodes:
            if node.get("error"):
                print(f"ERROR: {node['node_id']}: {node['error']}", file=sys.stderr)
        rendered = ""
    if output is not None:
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(rendered)
        print(f"Report: {output}")
    elif output_format in {"json", "markdown"}:
        print(rendered, end="")
    return 1 if all(node.get("error") for node in nodes) else 0


def resolve_collection_nodes(
    environment: str, targets: list[str]
) -> tuple[dict[str, tuple[str, str, str, str]], list[dict]]:
    nodes: dict[str, tuple[str, str, str, str]] = {}
    failures = []
    for target in targets:
        try:
            if target.startswith("dst_"):
                for node_id, (shard_id, _, role, public_ip, private_ip) in get_datastore_nodes(
                    environment, target
                ).items():
                    nodes[node_id] = (shard_id, role, public_ip, private_ip)
                continue
            elif target.startswith("shard_"):
                node_ids = get_shard_node_ids(environment, target)
            elif target.startswith("node_"):
                node_ids = [target]
            else:
                raise ValueError("target must be a node ID, shard ID, or datastore ID")
            for node_id in node_ids:
                nodes[node_id] = get_node_address(environment, node_id)
        except (RuntimeError, ValueError) as error:
            failures.append({"target": target, "status": "SKIPPED", "reason": str(error)})
    return nodes, failures


def remote_ssh_command(bastion: str, public_ip: str) -> list[str]:
    try:
        ipaddress.ip_address(public_ip)
    except ValueError as error:
        raise ValueError(f"invalid public IP address: {public_ip!r}") from error
    return deployment_ssh_command(
        bastion,
        [
            "sudo",
            "ssh",
            "-o",
            "BatchMode=yes",
            "-o",
            "ConnectTimeout=15",
            "-o",
            "ServerAliveInterval=15",
            "-o",
            "ServerAliveCountMax=4",
            "-o",
            "Compression=no",
            public_ip,
            "sudo",
            "nice",
            "-n",
            "19",
            "ionice",
            "-c3",
            "bash",
            "-s",
        ],
    )


def ssh_access_recovery_hint(detail: str, bastion: str) -> str:
    if "permission denied" not in detail.lower():
        return ""
    return (
        "\n\nSSH authentication was rejected. This helper will not open an interactive session or "
        "authenticate for you. Before retrying:\n"
        f"  1. Establish the approved bastion session in another terminal: ssh {bastion}\n"
        "  2. Authenticate the local control-plane CLI: dfadmin auth login --env prod\n"
        "  3. Retry this collection.\n"
        "Note: dfadmin authentication is separate from SSH access; if SSH is still rejected, verify "
        "your bastion/node SSH authorization."
    )


def run_parallel_node_operations(
    node_ids: list[str], workers: int, operation: Callable[[str], NodeResult]
) -> dict[str, NodeResult]:
    if workers <= 0:
        raise ValueError("--workers must be positive")
    results = {}
    failures = {}
    with ThreadPoolExecutor(max_workers=min(workers, len(node_ids))) as executor:
        futures = {executor.submit(operation, node_id): node_id for node_id in node_ids}
        for future in as_completed(futures):
            node_id = futures[future]
            try:
                results[node_id] = future.result()
            except Exception as error:
                failures[node_id] = str(error)
    if failures:
        detail = "; ".join(f"{node_id}: {error}" for node_id, error in failures.items())
        raise RuntimeError(f"node operations failed: {detail}")
    return {node_id: results[node_id] for node_id in node_ids}


def admission_script(max_normalized_load: float, min_free_kib: int) -> str:
    return f"""set -eu
cpu_count=$(nproc)
load_one=$(cut -d ' ' -f1 /proc/loadavg)
normalized_load=$(awk -v load_value="$load_one" -v cpus="$cpu_count" 'BEGIN {{ printf "%.3f", load_value / cpus }}')
printf 'load1=%s cpu_count=%s normalized_load=%s\\n' "$load_one" "$cpu_count" "$normalized_load"
df -Pk / /var/log/dragonfly /var/lib/dragonfly 2>&1 || true
awk -v load_value="$normalized_load" -v max="{max_normalized_load}" 'BEGIN {{ exit !(load_value <= max) }}'
check_paths=(/)
for candidate in /var/log/dragonfly /var/lib/dragonfly /tmp; do
    [[ -d "$candidate" ]] && check_paths+=("$candidate")
done
df -Pk "${{check_paths[@]}}" | awk -v minimum="{min_free_kib}" 'NR > 1 && $4 < minimum {{ exit 1 }}'
"""


def load_admission_script(max_normalized_load: float) -> str:
    return f"""set -eu
cpu_count=$(nproc)
load_one=$(cut -d ' ' -f1 /proc/loadavg)
normalized_load=$(awk -v load_value="$load_one" -v cpus="$cpu_count" 'BEGIN {{ printf "%.3f", load_value / cpus }}')
printf 'load1=%s cpu_count=%s normalized_load=%s\n' "$load_one" "$cpu_count" "$normalized_load"
awk -v load_value="$normalized_load" -v max="{max_normalized_load}" 'BEGIN {{ exit !(load_value <= max) }}'
"""


def admission_failure_reason(
    detail: str, max_normalized_load: float, min_free_kib: int | None = None
) -> str:
    match = re.search(r"normalized_load=([0-9.]+)", detail)
    if match and float(match.group(1)) > max_normalized_load:
        return (
            f"node is busy (load {match.group(1)} exceeds the safe limit {max_normalized_load:.3f}); "
            "no collection scripts were run on it"
        )
    if min_free_kib is not None:
        return (
            f"node has less than {min_free_kib} KiB free on a checked filesystem; "
            "no collection scripts were run on it"
        )
    return "node did not meet the safe collection limits; no collection scripts were run on it"


