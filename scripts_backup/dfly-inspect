def color_message(color: str, message: str, stream: object = sys.stdout) -> str:
    if getattr(stream, "isatty", lambda: False)() and not os.environ.get("NO_COLOR"):
        return f"{color}{message}{ANSI_RESET}"
    return message


def warning_message(message: str) -> str:
    return f"{color_message(ANSI_YELLOW, 'WARNING:', sys.stderr)} {message}"


def error_message(message: str) -> str:
    return f"{color_message(ANSI_RED, 'ERROR:', sys.stderr)} {message}"


def load_deployment_ssh_connection() -> str | None:
    try:
        value = json.loads(DEPLOYMENT_SSH_CONNECTION_PATH.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    command = value.get("command") if isinstance(value, dict) else None
    return command if isinstance(command, str) and command.strip() else None


def save_deployment_ssh_connection(command: str) -> None:
    HISTORY_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    write_json(DEPLOYMENT_SSH_CONNECTION_PATH, {"command": command})
    DEPLOYMENT_SSH_CONNECTION_PATH.chmod(0o600)


def clear_deployment_ssh_connection() -> None:
    with contextlib.suppress(OSError):
        DEPLOYMENT_SSH_CONNECTION_PATH.unlink()


def set_deployment_ssh_connection(command: str | None) -> bool:
    global _deployment_ssh_connection_command
    _deployment_ssh_connection_command = command or load_deployment_ssh_connection()
    return command is None and _deployment_ssh_connection_command is not None


def deployment_ssh_command(_bastion: str | None, remote_command: list[str]) -> list[str]:
    if _deployment_ssh_connection_command:
        command = shlex.split(_deployment_ssh_connection_command)
        if command[:3] != ["gcloud", "compute", "ssh"]:
            raise ValueError("--deployment-ssh-conn-command must start with 'gcloud compute ssh'")
        return [*command, f"--command={shlex.join(remote_command)}"]
    raise ValueError(
        "deployment SSH is not configured; provide --deployment-ssh-conn-command once "
        "to verify and cache the deployment connection"
    )


def preflight_dfadmin(environment: str) -> None:
    try:
        result = subprocess.run(
            ["dfadmin-wrapper", "--env", environment, "datastore", "list"],
            text=True,
            capture_output=True,
            check=False,
            timeout=DEFAULT_CONTROL_PLANE_TIMEOUT_SECONDS,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RuntimeError(
            f"dfadmin is not ready for --env {environment}: {error}\n"
            f"Authenticate before retrying: dfadmin auth login --env {environment}"
        ) from error
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or "no output"
        raise RuntimeError(
            f"dfadmin is not ready for --env {environment}: {detail}\n"
            f"Authenticate before retrying: dfadmin auth login --env {environment}"
        )


def preflight_deployment_ssh(supplied_command: str | None) -> None:
    command = deployment_ssh_command(None, ["true"])
    try:
        result = subprocess.run(command, text=True, capture_output=True, check=False, timeout=20)
    except (OSError, subprocess.TimeoutExpired) as error:
        if supplied_command or _deployment_ssh_connection_command:
            clear_deployment_ssh_connection()
        raise RuntimeError(f"deployment SSH readiness check failed: {error}") from error
    if result.returncode:
        if supplied_command or _deployment_ssh_connection_command:
            clear_deployment_ssh_connection()
        detail = result.stderr.strip() or result.stdout.strip() or "no output"
        connection_hint = supplied_command or _deployment_ssh_connection_command
        raise RuntimeError(
            f"deployment SSH is not ready: {detail}\n"
            "Authenticate or restore access, then retry with the deployment SSH connection "
            f"command: {connection_hint!r}"
        )
    if supplied_command:
        if supplied_command != load_deployment_ssh_connection():
            save_deployment_ssh_connection(supplied_command)
            print(
                f"Deployment SSH connection cached: {DEPLOYMENT_SSH_CONNECTION_PATH}\n"
                "Future commands will use it automatically; do not repeat --deployment-ssh-conn-command."
            )


class InspectArgumentParser(argparse.ArgumentParser):
    """Show operator-oriented parser errors before the usage summary."""

    description_first: bool = False

    def format_help(self) -> str:
        rendered = super().format_help()
        if not getattr(self, "description_first", False) or not self.description:
            return rendered
        description = f"{self.description}\n\n"
        return description + rendered.replace(description, "", 1)

    def error(self, message: str) -> NoReturn:
        options = {
            option
            for action in self._actions
            for option in action.option_strings
            if option.startswith("--")
        }
        mistyped = next(
            (
                argument
                for argument in sys.argv[1:]
                if argument.startswith("-")
                and not argument.startswith("--")
                and len(argument) > 2
                and f"--{argument[1:]}" in options
            ),
            None,
        )
        if mistyped:
            message = f"invalid option {mistyped!r}; use '--{mistyped[1:]}'"
        print(error_message(message), file=sys.stderr)
        print(f"Hint: run '{self.prog} --help' for command options and examples.", file=sys.stderr)
        self.print_usage(sys.stderr)
        self.exit(2)


