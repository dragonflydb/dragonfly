def collect_node(
    node_id: str,
    public_ip: str,
    output_dir: Path,
    bastion: str,
    max_normalized_load: float,
    min_free_kib: int,
    includes: set[str],
    since: str,
    until: str | None,
    raw_transfer: bool,
) -> dict:
    archive_compression = "perf" not in includes
    use_raw_transfer = False
    report = {
        "node_id": node_id,
        "public_ip": public_ip,
        "collected": ["basic", *sorted(includes)],
        "archive_compression": "zstd" if archive_compression else "none (perf selected)",
    }
    if not public_ip:
        return report | {"status": "SKIPPED", "reason": "node has no public IP"}
    command = remote_ssh_command(bastion, public_ip)
    admission = subprocess.run(
        command,
        input=admission_script(max_normalized_load, min_free_kib),
        text=True,
        capture_output=True,
        check=False,
    )
    if admission.returncode:
        if not raw_transfer:
            detail = admission.stdout + admission.stderr
            return report | {
                "status": "SKIPPED",
                "reason": admission_failure_reason(detail, max_normalized_load, min_free_kib),
                "detail": detail + ssh_access_recovery_hint(detail, bastion),
            }
        raw_admission = subprocess.run(
            command,
            input=load_admission_script(max_normalized_load),
            text=True,
            capture_output=True,
            check=False,
        )
        if raw_admission.returncode:
            detail = raw_admission.stdout + raw_admission.stderr
            return report | {
                "status": "SKIPPED",
                "reason": admission_failure_reason(detail, max_normalized_load),
                "detail": detail + ssh_access_recovery_hint(detail, bastion),
            }
        archive_compression = False
        use_raw_transfer = True
        report["archive_compression"] = "none (raw fallback after disk admission rejection)"
        report["warning"] = "normal collection rejected by disk admission; used raw transfer"
    suffix = ".tar.zst" if archive_compression else "_uncompressed.tar"
    output = output_dir / f"{node_id}{suffix}"
    output_dir.mkdir(parents=True, exist_ok=True)
    with output.open("wb") as stream:
        result = subprocess.run(
            command,
            input=collection_script(
                includes, since, until, archive_compression, use_raw_transfer
            ).encode(),
            stdout=stream,
            stderr=subprocess.PIPE,
            check=False,
        )
    if result.returncode:
        output.unlink(missing_ok=True)
        return report | {
            "status": "PARTIAL",
            "reason": "collection transfer failed",
            "detail": result.stderr.decode(errors="replace"),
        }
    return report | {"status": "COLLECTED", "bundle": output.name}


def estimate_node(
    node_id: str,
    public_ip: str,
    bastion: str,
    includes: set[str],
    since: str,
    until: str | None,
    max_normalized_load: float,
) -> dict:
    report = {"node_id": node_id, "public_ip": public_ip, "estimated_bytes": {}}
    if not public_ip:
        return report | {"status": "SKIPPED", "reason": "node has no public IP"}
    command = remote_ssh_command(bastion, public_ip)
    admission = subprocess.run(
        command,
        input=load_admission_script(max_normalized_load),
        text=True,
        capture_output=True,
        check=False,
    )
    if admission.returncode:
        detail = admission.stdout + admission.stderr
        return report | {
            "status": "SKIPPED",
            "reason": admission_failure_reason(detail, max_normalized_load),
            "detail": detail + ssh_access_recovery_hint(detail, bastion),
        }
    result = subprocess.run(
        command,
        input=estimate_script(includes, since, until),
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode:
        return report | {"status": "PARTIAL", "reason": "estimate failed", "detail": result.stderr}
    for line in result.stdout.splitlines():
        source, separator, value = line.partition("\t")
        if not separator:
            continue
        if value == "unknown":
            report["estimated_bytes"][source] = None
        elif value.isdigit():
            report["estimated_bytes"][source] = int(value)
    measured = sum(value for value in report["estimated_bytes"].values() if value is not None)
    return report | {"status": "ESTIMATED", "measured_bytes": measured}


def collection_workflow_guide(collected: list[dict]) -> str:
    archive_names = [entry["bundle"] for entry in collected]
    has_compressed = any(name.endswith(".tar.zst") for name in archive_names)
    has_raw = any(name.endswith(".tar") for name in archive_names)
    lines = [
        "Collected node artifacts",
        "",
        "Run the archive commands from this output directory.",
        "",
    ]
    if has_compressed:
        lines.extend(
            [
                "Compressed .tar.zst archives:",
                "  Search: find . -maxdepth 1 -name '*.tar.zst' -print0 | xargs -0 -r -n 1 -P 8 zstdgrep -a -H -i 'migrate'",
                '  Extract: for archive in *.tar.zst; do directory=${archive%.tar.zst}; mkdir -p "$directory"; tar --use-compress-program=unzstd -xf "$archive" -C "$directory"; done',
                "",
            ]
        )
    if has_raw:
        lines.extend(
            [
                "Uncompressed .tar archives:",
                "  Search: find . -maxdepth 1 -name '*_uncompressed.tar' -print0 | xargs -0 -r -n 1 -P 8 grep -a -H -i 'migrate'",
                '  Extract: for archive in *_uncompressed.tar; do directory=${archive%_uncompressed.tar}; mkdir -p "$directory"; tar -xf "$archive" -C "$directory"; done',
                "",
            ]
        )
    if has_compressed and has_raw:
        lines.append(
            "This collection has mixed archive formats: compressed transfers are .tar.zst; uncompressed transfers are *_uncompressed.tar."
        )
        lines.append("")
    lines.extend(
        [
            "Rotated Dragonfly logs remain individually zstd-compressed after extraction:",
