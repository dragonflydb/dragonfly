    return "\n".join(lines)


def collect_evidence(
    environment: str,
    targets: list[str],
    output_dir: Path,
    includes: set[str],
    workers: int,
    bastion: str,
    max_normalized_load: float,
    min_free_kib: int,
    since: str,
    until: str | None,
    compress: bool,
    raw_transfer: bool,
    estimate: bool,
    dry_run: bool,
    max_elements: int | None = None,
) -> int:
    if max_elements is not None and max_elements <= 0:
        raise ValueError("--max-elements must be positive")
    nodes, unresolved_targets = resolve_collection_nodes(environment, targets)
    report = list(unresolved_targets)
    total_nodes = len(nodes)
    if not nodes:
        raise RuntimeError("no nodes could be resolved from the supplied targets")
    if max_elements is not None and total_nodes == 1:
        raise ValueError("--max-elements cannot be used when only one node is selected")
    nodes = dict(sorted(nodes.items())[:max_elements])
    if len(nodes) < total_nodes:
        unresolved_targets.append(
            {
                "status": "SKIPPED",
                "target": "--max-elements",
                "reason": f"showing {len(nodes)} of {total_nodes} nodes; results are partial",
            }
        )
    if dry_run:
        print(
            json.dumps(
                {
                    "includes": sorted(includes),
                    "nodes": [
                        *report,
                        *({"node_id": node_id, "status": "PLANNED"} for node_id in nodes),
                    ],
                },
                indent=2,
            )
        )
        return 0
    if estimate:
        with ThreadPoolExecutor(max_workers=workers) as executor:
            futures = [
                executor.submit(
                    estimate_node,
                    node_id,
                    address[2],
                    bastion,
                    includes,
                    since,
                    until,
                    max_normalized_load,
                )
                for node_id, address in nodes.items()
            ]
            report.extend(future.result() for future in as_completed(futures))
        print("Transfer estimate")
        for entry in report:
            if entry.get("status") == "ESTIMATED":
                detail = ", ".join(
                    f"{source}={'unknown' if size is None else size} bytes"
                    for source, size in entry["estimated_bytes"].items()
                )
                print(
                    f"ESTIMATED: {entry['node_id']} - measured total: {entry['measured_bytes']} bytes; {detail}"
                )
            else:
                print(
                    color_message(
                        ANSI_YELLOW,
                        f"{entry.get('status')}: {entry.get('node_id', entry.get('target'))} - {entry.get('reason', 'not estimated')}",
                    )
                )
        return 0 if report and all(entry["status"] == "ESTIMATED" for entry in report) else 1
    output_dir.mkdir(parents=True, exist_ok=True)
    with ThreadPoolExecutor(max_workers=workers) as executor:
        futures = [
            executor.submit(
                collect_node,
                node_id,
                address[2],
                output_dir,
                bastion,
                max_normalized_load,
                min_free_kib,
                includes,
                since,
                until,
                raw_transfer,
            )
            for node_id, address in nodes.items()
        ]
        report.extend(future.result() for future in as_completed(futures))
    summary = {
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "tool_version": TOOL_VERSION,
        "script_sha256": SCRIPT_SHA256,
        "includes": sorted(includes),
        "nodes": report,
    }
    (output_dir / "collection-report.json").write_text(json.dumps(summary, indent=2) + "\n")
    collected = [entry for entry in report if entry.get("status") == "COLLECTED"]
    analysis_guide = output_dir / "README.txt"
    analysis_guide.write_text(collection_workflow_guide(collected))
    print("-" * 80)
    print("Collection Report:")
    print("-" * 80)
    print(f"Output directory: {output_dir}")
    print(f"Artifact analysis guide: {analysis_guide}")
    for entry in report:
        status = entry.get("status", "UNKNOWN")
        target = entry.get("node_id", entry.get("target"))
        message = (
            f"{status}: {target} - {entry.get('reason', ', '.join(entry.get('collected', [])))}"
        )
        if status == "SKIPPED":
            print(message)
            if detail := entry.get("detail", "").strip():
                print(f"{target} capacity check:\n{detail}", file=sys.stderr)
        elif status in {"FAILED", "PARTIAL"}:
            print(color_message(ANSI_RED, message))
            if detail := entry.get("detail", "").strip():
                print(color_message(ANSI_RED, f"ERROR: {target} detail:\n{detail}"))
        else:
            print(message)
            if warning := entry.get("warning", "").strip():
                print(warning_message(f"{target} {warning}"), file=sys.stderr)
    if collected and compress:
        archive = output_dir.parent / f"{output_dir.name}.tar"
        with tarfile.open(archive, "w") as bundle:
            bundle.add(output_dir, arcname=output_dir.name)
        print(f"Local bundle: {archive}")
    elif not collected:
        print("No node-local evidence was collected; no local archive was created.")
    return 0 if report and all(entry["status"] == "COLLECTED" for entry in report) else 1


def parse_bundle_window(value: str) -> timedelta:
    match = re.fullmatch(r"(\d+)([smhd])", value.strip().lower())
    if not match or int(match.group(1)) <= 0:
        raise ValueError("--window must be a positive duration such as 30m, 1h, or 2d")
    amount, unit = match.groups()
    return timedelta(
        **{{"s": "seconds", "m": "minutes", "h": "hours", "d": "days"}[unit]: int(amount)}
    )


def format_elapsed(seconds: float) -> str:
    total_seconds = max(0, round(seconds))
    hours, remainder = divmod(total_seconds, 3600)
    minutes, seconds = divmod(remainder, 60)
    if hours:
        return f"{hours}h {minutes}m {seconds}s"
    if minutes:
        return f"{minutes}m {seconds}s"
    return f"{seconds}s"


def bundle_readme(
    bundle_id: str, node_datastores: Sequence[tuple[str, str]], start: str, end: str
) -> str:
    scope = "\n".join(
        f"    - node {node_id}: datastore {datastore_id}"
        for node_id, datastore_id in node_datastores
    )
    return f"""Dragonfly evidence bundle {bundle_id}

Scope:
{scope}
Evidence window: {start} to {end}

Start here:
    1. Check manifest.json for bundle status and completed stages.
    2. For a failed or slow stage, read _dfly_inspect_logs/<stage>.log.
    3. Inspect node-local evidence in artifacts/ and archived Dragonfly and dfcloud-agent logs in logs/<node-id>/.
    4. Open index.html to view the captured dashboard data offline.

artifacts/
    One compressed evidence archive per collected node, named with its node ID. Each archive contains
    bounded node-local diagnostics such as redacted Dragonfly configuration and metadata, service and
    listener state, Redis INFO/MEMORY/DBSIZE/SLOWLOG output, and available metrics. Optional collection
    sources can add Dragonfly logs, journals, agent logs, info dumps, client lists, or perf captures.
    For exact archive search and extraction commands, see artifacts/README.txt.

logs/<node-id>/
    Archived Grafana Loki logs for that node. Files whose name contains _dfly_ are Dragonfly server
    logs; files whose name contains _agent_ are dfcloud-agent logs. Log filenames include the datastore, node,
    source, and requested time window.

dashboards/
    Grafana panel-query results grouped by source folder, dashboard, and panel. index.html is a
    self-contained offline viewer built from the captured query data; it makes no Grafana requests.
    These are datastore dashboard results, shared across all selected nodes, not node-local files.

_dfly_inspect_logs/
    Internal execution logs for bundle stages. Use these to diagnose a failed or slow stage.
"""


class BundleStageLog:
    def __init__(
        self, stream: TextIO, stream_lock: threading.Lock, stage_log: TextIO, stage_name: str
    ):
        self.stream = stream
        self.stream_lock = stream_lock
        self.stage_log = stage_log
        self.stage_name = stage_name
        self.lock = threading.Lock()

    def write(self, text: str) -> int:
        with self.lock:
            written = self.stage_log.write(text)
            self.stage_log.flush()
            return written

    def flush(self) -> None:
        self.stage_log.flush()


class BundleOutputRouter:
    def __init__(self, fallback: TextIO):
        self.fallback = fallback
        self.outputs: dict[int, BundleStageLog] = {}
        self.lock = threading.Lock()

    def register(self, output: BundleStageLog) -> None:
        with self.lock:
            self.outputs[threading.get_ident()] = output

    def unregister(self) -> None:
        with self.lock:
            self.outputs.pop(threading.get_ident(), None)

    def write(self, text: str) -> int:
        with self.lock:
            output = self.outputs.get(threading.get_ident())
        if output is not None:
            return output.write(text)
        return self.fallback.write(text)

    def flush(self) -> None:
        self.fallback.flush()


def incident_bundle(
    environment: str,
    incident_id: str,
    around: str,
    window: str,
    targets: list[str],
    source_folder: str,
    dashboard: str,
    panels: str,
    output_dir: Path,
    collect_includes: set[str],
    log_limit: int | None,
    loki_datasource: str | None,
    dashboard_sections: str,
    dashboard_global_only: bool,
    bastion: str,
    resume: bool,
    overwrite: bool,
    dry_run: bool,
) -> int:
    bundle_started = time.monotonic()
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", incident_id):
        raise ValueError(
            "incident-id must be 1-64 letters, digits, '.', '_', or '-', starting with a letter or digit"
        )
    captured_now = datetime.now(timezone.utc)
    around_utc = resolve_utc_timestamp(around, captured_now)
    center = datetime.strptime(around_utc, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    duration = parse_bundle_window(window)
    start = (center - duration).strftime("%Y-%m-%dT%H:%M:%SZ")
    end = (center + duration).strftime("%Y-%m-%dT%H:%M:%SZ")
    paths = {
        "root": output_dir,
        "viewer": output_dir / "index.html",
        "artifacts": output_dir / "artifacts",
        "logs": output_dir / "logs",
        "dashboards": output_dir / "dashboards",
        "stage_logs": output_dir / "_dfly_inspect_logs",
        "manifest": output_dir / "manifest.json",
        "readme": output_dir / "README.txt",
    }
    if dry_run:
        print("Dry run: no control-plane, Redis, SSH, or Grafana requests will be sent.")
        print(f"Bundle: {incident_id}; environment: {environment}")
        print(f"Normalized window: {start} to {end} (around {around_utc}, +/- {window})")
        print(f"Planned output root: {paths['root']}")
        print(
            f"Planned evidence artifacts: {paths['artifacts']} targets={', '.join(targets)} includes={','.join(sorted(collect_includes)) or 'baseline'}"
        )
        print(
            f"Planned log archive: {paths['logs']} sources=dfly,agent "
            f"limit={log_limit or 'unlimited'} datasource={loki_datasource or 'context default'}"
        )
        print(
            f"Planned dashboard export: {paths['dashboards']} folder={source_folder!r} dashboard={dashboard!r} panels={panels!r}"
        )
        print(
            f"Planned manifest: {paths['manifest']}; resume={'enabled' if resume else 'disabled'}"
        )
        return 0
    if resume and overwrite:
        raise ValueError("--resume and --overwrite cannot be used together")
    context = GCX_CONTEXTS[environment]
    print(
        f"Bundle preflight: validating Grafana dashboard {dashboard!r} and logs datasource.",
        flush=True,
    )
    resolve_dashboard(context, source_folder, dashboard)
    loki_datasource = resolve_loki_datasource(context, loki_datasource)
    if output_dir.exists() and overwrite:
        if output_dir.is_dir():
            shutil.rmtree(output_dir)
        else:
            output_dir.unlink()
        print(f"Bundle output removed: {output_dir}")
    if output_dir.exists() and not resume:
        raise ValueError(
            f"bundle output already exists: {output_dir}; use --resume to continue it, "
            "--overwrite to delete it and start over, or remove it manually"
        )
    if resume and output_dir.exists() and not paths["manifest"].is_file():
        raise ValueError(f"--resume requires an existing bundle manifest: {paths['manifest']}")
    print("Bundle preflight: resolving datastore target.", flush=True)
    datastore_ids = resolve_multi_resource_ids(environment, "datastore", targets)
    if len(datastore_ids) != 1:
        raise ValueError(
            "bundle targets must resolve to exactly one datastore for dashboard export"
        )
    datastore_id = datastore_ids[0]
    resolved_nodes, _ = resolve_collection_nodes(environment, targets)
    if not resolved_nodes:
        raise RuntimeError("no nodes could be resolved from the supplied targets")
    node_datastores = [(node_id, datastore_id) for node_id in sorted(resolved_nodes)]
    node_id_pattern = "^(?:" + "|".join(re.escape(node_id) for node_id, _ in node_datastores) + ")$"
    print(f"Bundle preflight: ready for datastore {datastore_id}.")
    previous_stages: dict[str, Any] = {}
    if resume and paths["manifest"].is_file():
        try:
            previous = json.loads(paths["manifest"].read_text())
        except (OSError, json.JSONDecodeError) as error:
            raise ValueError(f"could not read bundle manifest for --resume: {error}") from error
        compatible = {
            "incident_id": incident_id,
            "environment": environment,
            "datastore_id": datastore_id,
            "from": start,
            "to": end,
        }
        if not isinstance(previous, dict) or any(
            previous.get(key) != value for key, value in compatible.items()
        ):
            raise ValueError(
                "--resume manifest does not match this incident, environment, datastore, or time window"
            )
        if isinstance(previous.get("stages"), dict):
            previous_stages = previous["stages"]
    output_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    paths["stage_logs"].mkdir(mode=0o700, exist_ok=True)
    paths["readme"].write_text(bundle_readme(incident_id, node_datastores, start, end))
    manifest: dict[str, Any] = {
        "command": "bundle",
        "incident_id": incident_id,
        "environment": environment,
        "targets": targets,
        "datastore_id": datastore_id,
        "nodes": [
            {"node_id": node_id, "datastore_id": node_datastore_id}
            for node_id, node_datastore_id in node_datastores
        ],
        "around": around_utc,
        "window": window,
        "from": start,
        "to": end,
        "output_root": str(output_dir),
        "status": "in_progress",
        "resume": resume,
        "stages": {},
    }
    write_json(paths["manifest"], manifest)
    stages: list[tuple[str, Callable[[], int], Path]] = [
        (
            "dashboard_panels",
            lambda: export_dashboard_panels(
                source_folder,
                dashboard,
                panels,
                start,
                end,
                paths["dashboards"],
                datastore_id,
                ".*",
                node_id_pattern,
                "1m",
                context,
                "victoria-prom",
                dashboard_sections,
                dashboard_global_only,
                resume,
                False,
                False,
            ),
            paths["dashboards"],
        ),
        (
            "collect",
            lambda: collect_evidence(
                environment,
                targets,
                paths["artifacts"],
                collect_includes,
                DEFAULT_COLLECTION_WORKERS,
                bastion,
                DEFAULT_MAX_NORMALIZED_LOAD,
                DEFAULT_MIN_FREE_KIB,
                start,
                end,
                False,
                False,
                False,
                False,
            ),
            paths["artifacts"],
        ),
        (
            "log_archiver",
            lambda: archive_logs(
                environment,
                targets,
                start,
                end,
                GCX_CONTEXTS[environment],
                log_limit,
                paths["logs"],
                None,
                "all",
                False,
                False,
                None,
                loki_datasource,
            ),
            paths["logs"],
        ),
    ]
    terminal_stdout = sys.stdout
    terminal_output_lock = threading.Lock()
    failures = 0

    def terminal_print(message: str) -> None:
        with terminal_output_lock:
            print(message, file=terminal_stdout, flush=True)

    def finish_stage(name: str, status: int, stage: dict[str, object]) -> None:
        nonlocal failures
        manifest["stages"][name] = stage
        failures += status != 0
        write_json(paths["manifest"], manifest)
        stage_log_path = Path(str(stage["details"]))
        if status == 0:
            result = "completed"
        else:
            detail = stage.get("error")
            result = (
                f"failed: {detail}; details: {stage_log_path}"
                if isinstance(detail, str) and detail
                else f"failed; details: {stage_log_path}"
            )
        elapsed_seconds = stage.get("elapsed_seconds")
        elapsed = float(elapsed_seconds) if isinstance(elapsed_seconds, (int, float)) else 0.0
        terminal_print(f"Bundle: {name} {result} in {format_elapsed(elapsed)}.")

    def run_stage(
        name: str,
        stage_action: Callable[[], int],
        path: Path,
        output_router: BundleOutputRouter | None = None,
    ) -> tuple[int, dict[str, object]]:
        stage_started = time.monotonic()
        stage_log_path = paths["stage_logs"] / f"{name}.log"
        terminal_print(f"Bundle: {name} started; details: {stage_log_path}")
        try:
            with stage_log_path.open("w") as stage_log:
                stage_output = BundleStageLog(
                    terminal_stdout, terminal_output_lock, stage_log, name
                )
                if output_router is None:
                    with (
                        contextlib.redirect_stdout(stage_output),
                        contextlib.redirect_stderr(stage_output),
                    ):
                        status = stage_action()
                else:
                    output_router.register(stage_output)
                    try:
                        status = stage_action()
                    finally:
                        output_router.unregister()
            stage = {
                "status": "completed" if status == 0 else "failed",
                "exit_code": status,
                "output": str(path),
                "details": str(stage_log_path),
                "elapsed_seconds": round(time.monotonic() - stage_started, 3),
            }
        except (OSError, RuntimeError, ValueError) as error:
            status = 1
            stage = {
                "status": "failed",
                "exit_code": status,
                "output": str(path),
                "details": str(stage_log_path),
                "error": str(error),
                "elapsed_seconds": round(time.monotonic() - stage_started, 3),
            }
        return status, stage

    pending_stages = []
    for name, stage_action, path in stages:
        previous_stage = previous_stages.get(name)
        if (
            isinstance(previous_stage, dict)
            and previous_stage.get("status") == "completed"
            and path.exists()
        ):
            manifest["stages"][name] = {**previous_stage, "resume": "skipped_completed_stage"}
            write_json(paths["manifest"], manifest)
            print(f"Bundle resume: skipped completed {name} stage.")
            continue
        pending_stages.append((name, stage_action, path))

    if pending_stages:
        output_router = BundleOutputRouter(terminal_stdout)
        with contextlib.redirect_stdout(output_router), contextlib.redirect_stderr(output_router):
            with ThreadPoolExecutor(max_workers=len(pending_stages)) as executor:
                future_names = {
                    executor.submit(run_stage, name, stage_action, path, output_router): name
                    for name, stage_action, path in pending_stages
                }
                for future in as_completed(future_names):
                    name = future_names[future]
                    status, stage = future.result()
                    finish_stage(name, status, stage)
    dashboard_dir = paths["dashboards"] / dashboard_output_component(source_folder, "source folder")
    dashboard_dir /= dashboard_output_component(dashboard, "dashboard")
    dashboard_stage = manifest["stages"].get("dashboard_panels")
    if isinstance(dashboard_stage, dict) and dashboard_stage.get("status") == "completed":
        try:
            viewer_path = write_dashboard_viewer(dashboard_dir, paths["viewer"])
        except (OSError, ValueError) as error:
            failures += 1
            manifest["offline_dashboard_viewer"] = {"status": "failed", "error": str(error)}
            terminal_print(f"Bundle: offline dashboard viewer failed: {error}")
        else:
            manifest["offline_dashboard_viewer"] = {"status": "completed", "path": str(viewer_path)}
            terminal_print(f"Bundle: offline dashboard viewer ready: {viewer_path}")
    manifest["status"] = "completed" if not failures else "failed"
    manifest["finished_at"] = datetime.now(timezone.utc).isoformat()
    write_json(paths["manifest"], manifest)
    print(
        f"Bundle status: {manifest['status']}; elapsed: {format_elapsed(time.monotonic() - bundle_started)}; "
        f"manifest: {paths['manifest']}"
    )
    return 0 if not failures else 1


def static_mutation_findings(script: str) -> list[str]:
    """Return obvious mutation or shell-indirection findings; this is not a proof of safety."""
    findings = []
    patterns = (
        (
            r"(^|[;|&]\s*)(?:sudo\s+)?(?:rm|mv|cp|install|mkdir|rmdir|touch|chmod|chown|chgrp|truncate|dd|mkfs|mount|umount|reboot|shutdown|poweroff|kill|pkill|killall)\b",
            "filesystem, process, or host mutation command",
        ),
        (
            r"\bsystemctl\s+(?:start|stop|restart|reload|enable|disable|mask|unmask|daemon-reload|set-property)\b",
            "mutating systemctl action",
        ),
        (
            r"\b(?:apt(?:-get)?|yum|dnf|rpm|apk|pip(?:3)?|npm|gem)\s+(?:install|remove|uninstall|upgrade|update)\b",
            "package-management action",
        ),
        (
            r"\bkubectl\s+(?:apply|delete|patch|replace|edit|scale|rollout|cordon|uncordon|drain|taint|label|annotate)\b",
            "mutating kubectl action",
        ),
        (r"\bterraform\s+(?:apply|destroy|import)\b", "mutating terraform action"),
        (r"\b(?:sed|perl)\s+-[^\n]*i\b", "in-place file edit"),
        (r"\btee\b", "file-writing tee command"),
        (r"\b(?:eval|source)\b|(^|[;&|]\s*)\.\s+|`|\$\(", "shell indirection"),
        (r"(?<!\d)>{1,2}(?![&])", "shell output redirection"),
        (
            r"\bcurl\b[^\n]*(?:\s(?:-X|--request)\s*(?:POST|PUT|PATCH|DELETE)|\s(?:-d|--data|--data-raw|--data-binary)\b)",
            "mutating HTTP request",
        ),
    )
    for line_number, line in enumerate(script.splitlines(), 1):
        content = line.split("#", 1)[0]
        for pattern, description in patterns:
            if re.search(pattern, content, re.IGNORECASE):
                findings.append(f"line {line_number}: {description}")
    return findings


def default_agent_context() -> str:
    if not DEFAULT_DFADMIN_CHEATSHEET.is_file():
        return ""
    content = DEFAULT_DFADMIN_CHEATSHEET.read_text(errors="replace")
    content = content[:MAX_COPILOT_CONTEXT_BYTES]
    return f"\n\nDFADMIN CHEAT SHEET:\n{content}"


def agent_validation_cache_path(agent_name: str, script_sha256: str) -> Path:
    return AGENT_CACHE_DIR / f"{agent_name}-mutation-{script_sha256}.json"


def read_agent_validation_cache(agent_name: str, script_sha256: str) -> str | None:
    cache_path = agent_validation_cache_path(agent_name, script_sha256)
    try:
        cached = json.loads(cache_path.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(cached, dict) or cached.get("policy_version") != AGENT_POLICY_VERSION:
        return None
    reason = cached.get("reason")
    return reason if isinstance(reason, str) and reason.strip() else None


def write_agent_validation_cache(agent_name: str, script_sha256: str, reason: str) -> None:
    AGENT_CACHE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    write_json(
        agent_validation_cache_path(agent_name, script_sha256),
        {
            "agent": agent_name,
            "task": "classify_script_mutation",
            "script_sha256": script_sha256,
            "policy_version": AGENT_POLICY_VERSION,
            "approved_at": datetime.now(timezone.utc).isoformat(),
            "reason": reason,
        },
    )


def agent_command(agent_name: str, prompt: str, model: str | None = None) -> list[str]:
    """Return a bounded prompt-only invocation for a supported local agent CLI."""
    if agent_name == "copilot":
        command = [
            "copilot",
            "--prompt",
            prompt,
            "--silent",
            "--no-color",
            "--context",
            "default",
            "--max-ai-credits",
            str(COPILOT_VALIDATION_CREDITS),
            "--available-tools=",
            "--disable-builtin-mcps",
            "--no-custom-instructions",
            "--no-remote",
            "--no-remote-export",
            "--no-ask-user",
        ]
        if model:
            command.extend(["--model", model])
        return command
    if model:
        raise ValueError("--model is currently supported only with --agent copilot")
    if agent_name == "gemini":
        return ["gemini", "--prompt", prompt, "--output-format", "json", "--approval-mode", "plan"]
    if agent_name == "codex":
        return [
            "codex",
            "exec",
            "--ephemeral",
            "--sandbox",
            "read-only",
            "--skip-git-repo-check",
            "--ignore-user-config",
            prompt,
        ]
    if agent_name == "claude":
        return ["claude", "-p", prompt, "--bare", "--output-format", "json"]
    raise ValueError(f"unknown agent backend: {agent_name}")


def parse_agent_response(agent_name: str, output: str) -> dict[str, Any]:
    """Extract the required JSON object from a prompt-only agent response."""
    try:
        response = json.loads(output)
    except json.JSONDecodeError as error:
        raise RuntimeError(f"{agent_name} must return JSON only") from error
    if agent_name == "claude" and isinstance(response, dict):
        response = response.get("structured_output") or response.get("result")
        if isinstance(response, str):
            try:
                response = json.loads(response)
            except json.JSONDecodeError as error:
                raise RuntimeError("claude result must contain JSON only") from error
    if (
        agent_name == "gemini"
        and isinstance(response, dict)
        and isinstance(response.get("response"), str)
    ):
        try:
            response = json.loads(response["response"])
        except json.JSONDecodeError as error:
            raise RuntimeError("gemini response must contain JSON only") from error
    if not isinstance(response, dict):
        raise RuntimeError(f"{agent_name} must return a JSON object")
    return response


def explain_depth_instruction(depth: str) -> str:
    instructions = {
        "concise": "Give only the key conclusion and the most important next read-only check.",
        "standard": "Explain the key findings, uncertainty, and practical read-only next checks.",
        "deep": "Analyze the evidence in detail, relate values across the supplied output, identify uncertainty and risks, and give prioritized read-only next checks.",
    }
    try:
        return instructions[depth]
    except KeyError as error:
        raise ValueError(f"--depth must be one of: {', '.join(EXPLAIN_DEPTHS)}") from error


def ask_agent(
    agent_name: str,
    question: str,
    payload: Mapping[str, Any],
    context: str = "",
    depth: str = "standard",
    model: str | None = None,
) -> dict[str, Any]:
    """Run a constrained local agent query; reusable by inspection and explain commands."""
    depth_instruction = explain_depth_instruction(depth)
    executable = agent_command(agent_name, "", model)[0]
    if not shutil.which(executable):
        raise AgentUnavailable(f"{agent_name} CLI is not on PATH")
    prompt = (
        f"TASK: {question}\n"
        f"RESPONSE DEPTH: {depth}. {depth_instruction}\n"
        "Return JSON only. Do not use tools, run commands, edit files, or make network requests.\n"
        f"PAYLOAD:\n{json.dumps(payload, sort_keys=True)}{context}"
    )
    try:
        result = subprocess.run(
            agent_command(agent_name, prompt, model),
            text=True,
            capture_output=True,
            timeout=DEFAULT_AGENT_VALIDATOR_TIMEOUT_SECONDS,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RuntimeError(f"{agent_name} request failed: {error}") from error
    if result.returncode:
        raise RuntimeError(
            f"{agent_name} request failed: {result.stderr.strip() or 'non-zero exit'}"
        )
    return parse_agent_response(agent_name, result.stdout)


def run_agent_mutation_validation(
    agent_name: str, script: str, script_sha256: str
) -> tuple[bool, str]:
    cached_reason = read_agent_validation_cache(agent_name, script_sha256)
    if cached_reason is not None:
        print(f"Validation: {agent_name} approval cache hit.", file=sys.stderr)
        return True, f"cached approval: {cached_reason}"
    print(
        f"Validation: {agent_name} approval cache miss; starting local agent check.",
        file=sys.stderr,
    )
    response = ask_agent(
        agent_name,
        "Classify whether this custom inspection shell script mutates, or might mutate, remote state. "
        'Treat uncertainty as mutating. Return exactly {"answer":"yes"|"no","reason":"one sentence"}. '
        "yes means the script must be rejected; no means it can proceed to confirmation.",
        {"script": script},
        default_agent_context(),
    )
    answer = response.get("answer") if isinstance(response, dict) else None
    reason = response.get("reason") if isinstance(response, dict) else None
    if answer not in {"yes", "no"} or not isinstance(reason, str) or not reason.strip():
        raise RuntimeError(f'{agent_name} must return {{"answer":"yes"|"no","reason":"..."}}')
    if "\n" in reason.strip():
        raise RuntimeError(f"{agent_name} validation reason must be one line")
    reason = reason.strip()
    if answer == "no":
        write_agent_validation_cache(agent_name, script_sha256, reason)
        return True, reason
    return False, reason


def explain_with_agent(
