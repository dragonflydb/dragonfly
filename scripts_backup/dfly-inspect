def static_inspection_script_validation(script_text: str) -> str:
    print("Validation: using conservative local static code checks.", file=sys.stderr)
    findings = static_mutation_findings(script_text)
    if findings:
        print("Validation: local static code checks rejected the script.", file=sys.stderr)
        raise ValueError("static mutation check rejected the script: " + "; ".join(findings))
    print("Validation: local static code checks approved the script.", file=sys.stderr)
    return "static check found no obvious mutation or shell indirection"


def validate_inspection_script(agent_name: str | None, script: bytes) -> tuple[str, str]:
    script_text = script.decode(errors="replace")
    script_sha256 = hashlib.sha256(script).hexdigest()
    print(f"Validation: script SHA-256 {script_sha256}.", file=sys.stderr)
    if agent_name is None:
        return "static", static_inspection_script_validation(script_text)
    try:
        approved, reason = run_agent_mutation_validation(agent_name, script_text, script_sha256)
    except AgentUnavailable as error:
        print(
            warning_message(f"{error}; falling back to local static code checks."),
            file=sys.stderr,
        )
        return "static-fallback", static_inspection_script_validation(script_text)
    if not approved:
        print(f"Validation: {agent_name} rejected the script: {reason}", file=sys.stderr)
        raise ValueError(f"{agent_name} mutation check rejected the script: {reason}")
    print(f"Validation: {agent_name} approved the script: {reason}", file=sys.stderr)
    return agent_name, f"{agent_name} check approved: {reason}"


def confirm_inspection_script(validation_reason: str) -> None:
    print(
        warning_message(
            "This tool is intended for custom inspection scripts. Mutation validation is limited "
            "and cannot prove that an arbitrary shell script is read-only."
        ),
        file=sys.stderr,
    )
    print(f"Validation: {validation_reason}", file=sys.stderr)
    if not sys.stdin.isatty():
        raise RuntimeError("custom inspection script requires an interactive yes/no confirmation")
    if input("Run this custom inspection script? (yes/no): ").strip().lower() != "yes":
        raise RuntimeError("custom inspection script cancelled")


def run_script_on_nodes(
    environment: str,
    targets: list[str],
    script_path: Path | None,
    inline_command: str | None,
    output_dir: Path | None,
    workers: int,
    bastion: str,
    timeout_seconds: int,
    acknowledge_multi_node: bool,
    tee: bool,
    screen_only: bool,
    dry_run: bool,
    max_elements: int | None = None,
    agent_validation: str | None = None,
) -> int:
    if workers <= 0 or workers > MAX_SCRIPT_RUN_WORKERS:
        raise ValueError(f"--workers must be between 1 and {MAX_SCRIPT_RUN_WORKERS}")
    if timeout_seconds <= 0 or timeout_seconds > MAX_SCRIPT_RUN_TIMEOUT_SECONDS:
        raise ValueError(
            f"--timeout-seconds must be between 1 and {MAX_SCRIPT_RUN_TIMEOUT_SECONDS}"
        )
    if max_elements is not None and max_elements <= 0:
        raise ValueError("--max-elements must be positive")
    if script_path is not None:
        if not script_path.is_file():
            raise ValueError(f"--script must name a regular file: {script_path}")
        script = script_path.read_bytes()
        script_source = str(script_path)
    elif inline_command is not None:
        script = inline_command.encode()
        script_source = "<inline --command>"
    else:
        raise ValueError("one of --script or --command is required")
    if not script:
        raise ValueError("--script must not be empty")
    if len(script) > 65536:
        raise ValueError("--script must not exceed 65536 bytes")
    script_sha256 = hashlib.sha256(script).hexdigest()
    validation_mode, validation_reason = validate_inspection_script(agent_validation, script)

    nodes, unresolved_targets = resolve_collection_nodes(environment, targets)
    report = []
    total_nodes = len(nodes)
    if not nodes:
        raise RuntimeError("no nodes could be resolved from the supplied targets")
    if max_elements is not None and total_nodes == 1:
        raise ValueError("--max-elements cannot be used when only one node is selected")
    nodes = dict(sorted(nodes.items())[:max_elements])
    if len(nodes) < total_nodes:
        unresolved_targets.append(
            {
                "status": "SKIPPED",
                "target": "--max-elements",
                "reason": f"showing {len(nodes)} of {total_nodes} nodes; results are partial",
            }
        )
    if len(nodes) > 1 and not dry_run and not acknowledge_multi_node:
        raise ValueError(
            "multiple nodes require --acknowledge-multi-node; review the script and use --dry-run first"
        )
    if screen_only and tee:
        raise ValueError("--screen-only cannot be combined with --tee")
    if screen_only and output_dir is not None:
        raise ValueError("--screen-only cannot be combined with --output-dir")
    if output_dir is None and not screen_only:
        timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        output_dir = Path(f"run-inspection-script-{timestamp}")
    if output_dir is not None and output_dir.exists() and any(output_dir.iterdir()):
        raise ValueError(f"output directory is not empty: {output_dir}")

    plan = {
        "command": "run-inspection-script",
        "environment": environment,
        "script": script_source,
        "submitted_script": "submitted-script.sh",
        "script_sha256": script_sha256,
        "timeout_seconds": timeout_seconds,
        "workers": min(workers, len(nodes)),
        "output_mode": "screen-only" if screen_only else "files",
        "mutation_validation": {
            "mode": validation_mode,
            "reason": validation_reason,
        },
        "nodes": [
            {"node_id": node_id, "public_ip": address[2] or None}
            for node_id, address in nodes.items()
        ],
        "unresolved_targets": unresolved_targets,
    }
    if dry_run:
        print(json.dumps(plan, indent=2))
        return 0
    confirm_inspection_script(validation_reason)

    if output_dir is not None:
        output_dir.mkdir(parents=True, exist_ok=True)
        submitted_script_path = output_dir / "submitted-script.sh"
        submitted_script_path.write_bytes(script)
    stdout_header = (
        f"=== Submitted script (SHA-256: {script_sha256}) ===\n".encode()
        + script
        + (b"" if script.endswith(b"\n") else b"\n")
        + b"=== Remote stdout ===\n"
    )
    if screen_only:
        print(f"=== Submitted script (SHA-256: {script_sha256}) ===")
        print(script.decode(errors="replace"), end="" if script.endswith(b"\n") else "\n")
    file_output_dir = output_dir or Path()

    def run_node(node_id: str, public_ip: str) -> dict:
        if screen_only:
            entry = {"node_id": node_id, "public_ip": public_ip or None}
            if not public_ip:
                return entry | {"status": "SKIPPED", "reason": "node has no public IP"}
            try:
                result = subprocess.run(
                    remote_ssh_command(bastion, public_ip),
                    input=script,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    timeout=timeout_seconds,
                    check=False,
                )
            except subprocess.TimeoutExpired as error:
                return entry | {
                    "status": "TIMED_OUT",
                    "reason": f"exceeded {timeout_seconds} seconds",
                    "stdout_output": (error.stdout or b"").decode(errors="replace"),
                    "stderr_output": ((error.stderr or b"") + b"\ncommand timed out\n").decode(
                        errors="replace"
                    ),
                }
            return entry | {
                "status": "COMPLETED" if result.returncode == 0 else "FAILED",
                "returncode": result.returncode,
                "reason": "remote script returned non-zero" if result.returncode else "",
                "stdout_output": result.stdout.decode(errors="replace"),
                "stderr_output": result.stderr.decode(errors="replace"),
            }
        node_dir = file_output_dir / node_id
        node_dir.mkdir()
        stdout_path = node_dir / "stdout.log"
        stderr_path = node_dir / "stderr.log"
        entry = {
            "node_id": node_id,
            "public_ip": public_ip or None,
            "stdout": str(stdout_path.relative_to(file_output_dir)),
            "stderr": str(stderr_path.relative_to(file_output_dir)),
        }
        if not public_ip:
            stderr_path.write_text("node has no public IP\n")
            stdout_path.write_bytes(stdout_header)
            return entry | {"status": "SKIPPED", "reason": "node has no public IP"}
        try:
            result = subprocess.run(
                remote_ssh_command(bastion, public_ip),
                input=script,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=timeout_seconds,
                check=False,
            )
        except subprocess.TimeoutExpired as error:
            stdout_path.write_bytes(stdout_header + (error.stdout or b""))
            stderr_path.write_bytes((error.stderr or b"") + b"\ncommand timed out\n")
            return entry | {"status": "TIMED_OUT", "reason": f"exceeded {timeout_seconds} seconds"}
        stdout_path.write_bytes(stdout_header + result.stdout)
        stderr_path.write_bytes(result.stderr)
        if result.returncode:
            detail = result.stderr.decode(errors="replace")
            return entry | {
                "status": "FAILED",
                "returncode": result.returncode,
                "reason": "remote script returned non-zero",
                "detail": detail + ssh_access_recovery_hint(detail, bastion),
            }
        return entry | {"status": "COMPLETED", "returncode": 0}

    effective_workers = min(workers, len(nodes))
    print(f"Starting {len(nodes)} node sessions in parallel (maximum {effective_workers} workers).")
    with ThreadPoolExecutor(max_workers=effective_workers) as executor:
        futures = {
            executor.submit(run_node, node_id, address[2]): node_id
            for node_id, address in nodes.items()
        }
        for future in as_completed(futures):
            entry = future.result()
            report.append(entry)
            if screen_only:
                print(f"\n=== Node: {entry['node_id']} ===")
                print(f"Public IP: {entry['public_ip'] or '<unavailable>'}")
                print(f"Status: {entry['status']}")
                if entry.get("reason"):
                    print(f"Reason: {entry['reason']}")
                print("--- stdout ---")
                print(
                    entry.get("stdout_output", ""),
                    end="" if entry.get("stdout_output", "").endswith("\n") else "\n",
                )
                print("--- stderr ---")
                print(
                    entry.get("stderr_output", ""),
                    end="" if entry.get("stderr_output", "").endswith("\n") else "\n",
                )
                continue
            print(f"{entry['status']}: {entry['node_id']} -> {entry['stdout']}")
            if entry["status"] != "COMPLETED":
                print(
                    warning_message(
                        f"{entry['node_id']}: {entry.get('detail') or entry.get('reason', 'unknown failure')}"
                    ),
                    file=sys.stderr,
                )
            if tee:
                stdout = (output_dir / entry["stdout"]).read_text(errors="replace")
                stderr = (output_dir / entry["stderr"]).read_text(errors="replace")
                if stdout:
                    print(
                        f"--- {entry['node_id']} stdout ---\n{stdout}",
                        end="" if stdout.endswith("\n") else "\n",
                    )
                if stderr:
                    print(
                        f"--- {entry['node_id']} stderr ---\n{stderr}",
                        end="" if stderr.endswith("\n") else "\n",
                        file=sys.stderr,
                    )

    if output_dir is not None:
        summary = plan | {
            "generated_at": datetime.now(timezone.utc).isoformat(),
            "nodes": report,
        }
        write_json(output_dir / "run-inspection-script-report.json", summary)
        print(f"Output directory: {output_dir}")
        print(f"Report: {output_dir / 'run-inspection-script-report.json'}")
    return 0 if report and all(entry["status"] == "COMPLETED" for entry in report) else 1


def get_role(environment: str, node_id: str) -> tuple[str, str]:
    replication = run_dfadmin(environment, "node", "resp", node_id, "--", "INFO", "replication")
    normalized_replication = (
        replication.replace("\\r\\n", "\n").replace("\\n", "\n").replace("\\r", "\n")
    )
    match = re.search(
        r"^\s*role\s*[:=]\s*[\"']?(master|slave|primary|replica)[\"']?",
        normalized_replication,
        re.IGNORECASE | re.MULTILINE,
    )
    if not match:
        return "", replication
    role = match.group(1).lower()
    return {"primary": "master", "replica": "slave"}.get(role, role), replication


def parse_info_response(response: str) -> dict[str, str]:
    normalized = response.replace("\\r\\n", "\n").replace("\\n", "\n").replace("\\r", "\n")
    fields = {}
    for line in normalized.splitlines():
        if line.startswith("#") or ":" not in line:
            continue
        name, value = line.split(":", 1)
        fields[name.strip()] = value.strip()
    return fields


def parse_info_integer(fields: dict[str, str], *names: str) -> int | None:
    for name in names:
        try:
            return int(fields[name])
        except (KeyError, ValueError):
            continue
    return None


def parse_config_get_integer(response: str, name: str) -> int | None:
    fields = parse_info_response(response)
    value = fields.get(name)
    if value is not None:
        try:
            return int(value.strip('"'))
        except ValueError:
            pass
    values = [line.strip() for line in response.splitlines() if line.strip()]
    if len(values) >= 2 and values[0] == name:
        try:
            return int(values[1])
        except ValueError:
            pass
    return None


def parse_dbsize(response: str) -> int | None:
    try:
        value = float(response.strip())
    except ValueError:
        return None
    if not value.is_integer() or value < 0:
        return None
    return int(value)


def nested_field(value: object, *path: str) -> object | None:
    current = value
    for component in path:
        if not isinstance(current, dict):
            return None
        current = next(
            (child for name, child in current.items() if name.lower() == component), None
        )
    return current


def format_reported_at(value: object) -> str:
    try:
        timestamp = float(str(value))
        reported_at = datetime.fromtimestamp(timestamp, timezone.utc)
    except (TypeError, ValueError, OverflowError):
        return "nil"
    age_seconds = max(0, int((datetime.now(timezone.utc) - reported_at).total_seconds()))
    return f"{reported_at.strftime('%Y-%m-%d %H:%M:%SZ')} ({age_seconds}s ago)"


def api_connectivity(bastion: str, public_ip: str) -> tuple[str, str]:
    if not public_ip:
        return "unavailable", "unavailable"
    script = """for family in 4 6; do
  result=$(curl -$family -sS -o /dev/null -w '%{http_code} %{time_total}' --connect-timeout 5 --max-time 10 https://api.dragonflydb.cloud/ 2>&1) || true
  printf 'ipv%s=%s\\n' "$family" "$result"
done
"""
    try:
        result = subprocess.run(
            remote_ssh_command(bastion, public_ip),
            input=script.encode(),
            capture_output=True,
            timeout=25,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return "timeout", "timeout"
    values = dict(
        line.split("=", 1)
        for line in result.stdout.decode(errors="replace").splitlines()
        if "=" in line
    )

    def describe(value: str | None) -> str:
        if value is None:
            return "unavailable"
        match = re.fullmatch(r"(\d{3})\s+([\d.]+)", value)
        if match:
            return f"reachable (HTTP {match.group(1)}, {match.group(2)}s)"
        return f"unreachable ({value})"

    return describe(values.get("ipv4")), describe(values.get("ipv6"))


def health_datastore_id(environment: str, target: str) -> str:
    if target.startswith("dst_"):
        return target
    if target.startswith("node_"):
        _, datastore_id = get_node_details(environment, target)
    elif target.startswith("shard_"):
        node_ids = get_shard_node_ids(environment, target)
        _, datastore_id = get_node_details(environment, sorted(node_ids)[0])
    else:
        raise ValueError("health target must be a datastore, shard, or node ID")
    if not datastore_id:
        raise RuntimeError(f"could not identify the parent datastore for {target}")
    return datastore_id


def print_health_vertical(columns: list[str], rows: list[dict[str, object]]) -> None:
    for index, row in enumerate(rows):
        if index:
            print()
        print(f"node_id: {row['node_id']}")
        for column in columns:
            if column == "master_link_status" and row["role"] == "primary":
                continue
            print(f"{column}: {row.get(column, 'nil')}")
        if row["error"]:
            print(f"error: {row['error']}")


def health_report(
    environment: str,
    target: str,
    bastion: str,
    workers: int,
    output_format: str,
    max_elements: int | None = None,
) -> int:
    if not 1 <= workers <= DEFAULT_HEALTH_WORKERS:
        raise ValueError(f"--workers must be between 1 and {DEFAULT_HEALTH_WORKERS}")
    if max_elements is not None and max_elements <= 0:
        raise ValueError("--max-elements must be positive")

    datastore_id = health_datastore_id(environment, target)
    all_nodes = get_datastore_nodes(environment, datastore_id)
    total_nodes = len(all_nodes)
    if max_elements is not None and total_nodes == 1:
        raise ValueError("--max-elements cannot be used when only one node is selected")
    selected_items = sorted(all_nodes.items())[:max_elements]
    nodes = dict(selected_items)
    truncated = len(nodes) < total_nodes

    def fetch(node_id: str, shard_id: str, topology_role: str, public_ip: str) -> dict[str, object]:
        display_role = {"master": "primary", "slave": "replica"}.get(
            topology_role, topology_role or "unknown"
        )
        row: dict[str, object] = {
            "node_id": node_id,
            "shard_id": shard_id or "nil",
            "role": display_role,
            "master_link_status": "" if display_role == "primary" else "nil",
            "replication_offset": None,
            "replication_lag_bytes": "nil",
            "key_count": "nil",
            "key_count_gap": "nil",
            "synced": "nil",
            "status": "unknown",
            "last_reported": "nil",
            "agent_healthy": "nil",
            "dragonfly_version": "nil",
            "image_timestamp": "nil",
            "uptime_seconds": "nil",
            "used_memory": "nil",
            "maxmemory": "nil",
            "memory_used_percent": "nil",
            "api_ipv4": "unavailable",
            "api_ipv6": "unavailable",
            "rss_to_used_memory_ratio": "nil",
            "evicted_keys": "nil",
            "rdb_bgsave_in_progress": "nil",
            "connected_clients": "nil",
            "error": "",
        }
        try:
            node_show = get_resource_show_json(environment, "node", node_id)
            sections = {
                section: parse_info_response(
                    run_dfadmin(environment, "node", "resp", node_id, "--", "INFO", section)
                )
                for section in (
                    "server",
                    "replication",
                    "memory",
                    "persistence",
                    "stats",
                    "clients",
                )
            }
            key_count = run_dfadmin(environment, "node", "resp", node_id, "--", "DBSIZE")
            maxmemory = run_dfadmin(
                environment, "node", "resp", node_id, "--", "CONFIG", "GET", "maxmemory"
            )
        except RuntimeError as error:
            row["error"] = str(error)
            return row

        replication = sections["replication"]
        node = nested_field(node_show, "node")
        row["last_reported"] = format_reported_at(
            nested_field(node, "status", "health", "instance", "last_reported")
            or nested_field(node, "status", "health", "dragonfly", "last_reported")
        )
        local_healthy = nested_field(node, "status", "health", "instance", "local", "healthy")
        row["agent_healthy"] = "nil" if local_healthy is None else str(local_healthy).lower()
        role = replication.get("role") or topology_role or "unknown"
        row["role"] = {"master": "primary", "slave": "replica"}.get(role, role)
        if row["role"] != "primary":
            row["master_link_status"] = replication.get("master_link_status", "nil")
            row["synced"] = "yes" if row["master_link_status"] == "up" else "no"
        else:
            row["synced"] = "not_applicable"
        row["replication_offset"] = parse_info_integer(
            replication, "slave_repl_offset", "master_repl_offset"
        )
        used_memory = parse_info_integer(sections["memory"], "used_memory")
        configured_maxmemory = parse_config_get_integer(maxmemory, "maxmemory")
        row["used_memory"] = str(used_memory) if used_memory is not None else "nil"
        row["maxmemory"] = str(configured_maxmemory) if configured_maxmemory is not None else "nil"
        if used_memory is not None and configured_maxmemory and configured_maxmemory > 0:
            row["memory_used_percent"] = f"{100 * used_memory / configured_maxmemory:.1f}"
        used_memory_rss = parse_info_integer(sections["memory"], "used_memory_rss")
        if used_memory and used_memory_rss is not None:
            row["rss_to_used_memory_ratio"] = f"{used_memory_rss / used_memory:.2f}"
        row["evicted_keys"] = sections["stats"].get("evicted_keys", "nil")
        row["rdb_bgsave_in_progress"] = sections["persistence"].get("rdb_bgsave_in_progress", "nil")
        row["connected_clients"] = sections["clients"].get("connected_clients", "nil")
        parsed_key_count = parse_dbsize(key_count)
        row["key_count"] = str(parsed_key_count) if parsed_key_count is not None else "nil"
        row["dragonfly_version"] = sections["server"].get(
            "dragonfly_version",
            str(nested_field(node, "status", "telemetry", "dragonfly_version") or "nil"),
        )
        row["uptime_seconds"] = sections["server"].get("uptime_in_seconds", "nil")
        row["image_timestamp"] = str(
            nested_field(node, "config", "version", "image_timestamp") or "nil"
        )
        row["api_ipv4"], row["api_ipv6"] = api_connectivity(bastion, public_ip)
        row["status"] = (
            "healthy"
            if row["synced"] in {"yes", "not_applicable"} and row["agent_healthy"] != "false"
            else "warning"
        )
        return row

    rows = []
    with ThreadPoolExecutor(max_workers=min(workers, len(nodes))) as executor:
        futures = {
            executor.submit(fetch, node_id, shard_id, role, public_ip): node_id
            for node_id, (shard_id, _, role, public_ip, _) in nodes.items()
        }
        for future in as_completed(futures):
            rows.append(future.result())
    rows.sort(key=lambda row: str(row["node_id"]))

    primary_offsets = {
        str(row["shard_id"]): int(row["replication_offset"])
        for row in rows
        if row["role"] == "primary" and row["replication_offset"] is not None
    }
    for row in rows:
        offset = row["replication_offset"]
        primary_offset = primary_offsets.get(str(row["shard_id"]))
        if row["role"] == "primary":
            row["replication_lag_bytes"] = "0" if offset is not None else "unavailable"
        elif offset is not None and primary_offset is not None:
            row["replication_lag_bytes"] = str(max(0, primary_offset - int(offset)))
        elif not row["error"]:
            row["replication_lag_bytes"] = "unknown"
        row["replication_offset"] = "unavailable" if offset is None else str(offset)

    primary_key_counts = {
        str(row["shard_id"]): int(row["key_count"])
        for row in rows
        if row["role"] == "primary" and str(row["key_count"]).isdigit()
    }
    for row in rows:
        primary_count = primary_key_counts.get(str(row["shard_id"]))
        if primary_count is not None and str(row["key_count"]).isdigit():
            row["key_count_gap"] = str(abs(primary_count - int(row["key_count"])))

    columns = [
        "status",
        "shard_id",
        "role",
        "synced",
        "agent_healthy",
        "last_reported",
        "master_link_status",
        "key_count",
        "key_count_gap",
        "replication_offset",
        "replication_lag_bytes",
        "dragonfly_version",
        "image_timestamp",
        "uptime_seconds",
        "used_memory",
        "maxmemory",
        "memory_used_percent",
        "rss_to_used_memory_ratio",
        "evicted_keys",
        "rdb_bgsave_in_progress",
        "connected_clients",
        "api_ipv4",
        "api_ipv6",
    ]
    if output_format == "json":
        print(
            json.dumps(
                {
                    "command": "health",
                    "environment": environment,
                    "datastore_id": datastore_id,
                    "target": target,
                    "total_nodes": total_nodes,
                    "selected_nodes": len(rows),
                    "truncated": truncated,
                    "replication_lag_note": "Snapshot offset and key-count gaps are not definitive replication correctness measurements.",
                    "rows": [
                        {
                            name: value
                            for name, value in row.items()
                            if (name != "error" or value)
                            and not (name == "master_link_status" and row["role"] == "primary")
                        }
                        for row in rows
                    ],
                },
                indent=2,
                sort_keys=True,
            )
        )
    elif output_format == "vertical":
        if truncated:
            print(
                warning_message(
                    f"showing {len(rows)} of {total_nodes} nodes; results are partial."
                ),
                file=sys.stderr,
            )
        print_health_vertical(columns, rows)
    else:
        table_columns = ["node_id", *columns]
        if any(row["error"] for row in rows):
            table_columns.append("error")
        table_dimensions = table_exceeds_terminal_width(table_columns, rows, None)
        if table_dimensions:
            table_width, terminal_width = table_dimensions
            print(
                warning_message(
                    f"table width {table_width} exceeds terminal width {terminal_width}; "
                    "using vertical output."
                ),
                file=sys.stderr,
            )
            if truncated:
                print(
                    warning_message(
                        f"showing {len(rows)} of {total_nodes} nodes; results are partial."
                    ),
                    file=sys.stderr,
                )
            print(
                "Health snapshot: replication offset and key-count gaps are snapshots, not definitive replication correctness."
            )
            print_health_vertical(columns, rows)
        else:
            if truncated:
                print(
                    warning_message(
                        f"showing {len(rows)} of {total_nodes} nodes; results are partial."
                    ),
                    file=sys.stderr,
                )
            print(
                "Health snapshot: replication offset and key-count gaps are snapshots, not definitive replication correctness."
            )
            print_multi_table(table_columns, rows, None)
    return 1 if all(row["error"] for row in rows) else 0


def get_key_counts(environment: str, node_id: str) -> dict[str, int]:
    keyspace = run_dfadmin(environment, "node", "resp", node_id, "--", "INFO", "keyspace")
    counts = {
        database: int(count) for database, count in re.findall(r"(db\d+):keys=(\d+)", keyspace)
    }
    if not counts:
        raise RuntimeError(f"could not parse a key count from INFO keyspace for {node_id}")
    return counts


def get_config(environment: str, node_id: str, parameter: str) -> str:
    return run_dfadmin(
        environment, "node", "resp", node_id, "--", "CONFIG", "GET", parameter, allow_failure=True
    )


def config_response_is_empty(response: str) -> bool:
    normalized = response.strip().lower()
    return not normalized or normalized in {"(nil)", "nil", "[]", "{}"}


def normalize_config_value(parameter: str, response: str) -> str:
    if config_response_is_empty(response):
        return "nil"
    lines = [line.strip() for line in response.splitlines() if line.strip()]
    if len(lines) >= 2 and lines[0].replace("-", "_") == parameter.replace("-", "_"):
        return " ".join(lines[1:])
    value = " ".join(lines)
    match = re.fullmatch(rf"{re.escape(parameter)}\s*[:=]\s*(.*)", value, re.IGNORECASE)
    if match:
        value = match.group(1)
    try:
        parsed = json.loads(value)
    except json.JSONDecodeError:
        return value
    return (
        str(parsed) if not isinstance(parsed, (dict, list)) else json.dumps(parsed, sort_keys=True)
    )


def parse_all_config_values(response: str) -> dict[str, str]:
    if config_response_is_empty(response):
        return {}
    try:
        parsed = json.loads(response)
    except json.JSONDecodeError:
        parsed = None
    if isinstance(parsed, dict):
        return {
            str(name): normalize_config_value(str(name), json.dumps(value))
            for name, value in parsed.items()
        }

    values = {}
    lines = [line.strip() for line in response.splitlines() if line.strip()]
    for line in lines:
        match = re.fullmatch(r"([A-Za-z0-9_-]+)\s*:\s*(.*)", line)
        if match:
            parameter, value = match.groups()
            values[parameter] = normalize_config_value(parameter, f"{parameter}: {value}")
    if values:
        return values

    if len(lines) % 2 == 0:
        return {
            lines[index]: normalize_config_value(lines[index], lines[index + 1])
            for index in range(0, len(lines), 2)
            if re.fullmatch(r"[A-Za-z0-9_-]+", lines[index])
        }
    return {}


def config_difference_groups(
    parameters: list[str], rows: list[dict[str, str]]
) -> dict[str, dict[str, list[str]]]:
    return {
        parameter: {
            value: [row["node_id"] for row in rows if not row["error"] and row[parameter] == value]
            for value in sorted({row[parameter] for row in rows if not row["error"]})
        }
        for parameter in parameters
    }


def print_config_difference_report(groups: dict[str, dict[str, list[str]]]) -> None:
    print("Diff report:")
    if all(len(values) <= 1 for values in groups.values()):
        print("  No differences; all available configuration values are equal.")
    for parameter, values in groups.items():
        node_count = sum(len(nodes) for nodes in values.values())
        if not values:
            print(f"  {parameter}: no successful node responses")
        elif len(values) == 1:
            print(f"  {parameter}: no differences; {node_count} nodes equal")
        else:
            print(f"  {parameter}: differences")
            for value, nodes in values.items():
                print(f"    {value}: {', '.join(nodes)}")


def list_config_parameters(environment: str, targets: list[str]) -> int:
    node_ids = resolve_multi_resource_ids(environment, "node", targets)
    if len(node_ids) != 1:
        raise ValueError("--list-parameters requires targets that resolve to exactly one node")
    node_id = node_ids[0]
    response = run_dfadmin(environment, "node", "resp", node_id, "--", "CONFIG", "GET", "*")
    parameters = sorted(parse_all_config_values(response))
    if not parameters:
        raise RuntimeError("CONFIG GET * returned no parseable configuration parameters")
    print(f"Configuration parameters: {node_id}")
    for parameter in parameters:
        print(parameter)
    return 0


def diff_config(
    environment: str,
    targets: list[str],
    parameters: list[str],
    workers: int,
    output_format: str,
    max_elements: int | None = None,
    report_only: bool = False,
) -> int:
    if not parameters:
        raise ValueError("supply at least one --parameter")
    if "*" in parameters and len(parameters) != 1:
        raise ValueError("--parameter '*' cannot be combined with named parameters")
    if not 1 <= workers <= DEFAULT_MULTI_WORKERS:
        raise ValueError(f"--workers must be between 1 and {DEFAULT_MULTI_WORKERS}")
    if max_elements is not None and max_elements <= 0:
        raise ValueError("--max-elements must be positive")
    if report_only and output_format == "json":
        raise ValueError("--report-only is only available with table or vertical output")

    node_ids = resolve_multi_resource_ids(environment, "node", targets)
    total_nodes = len(node_ids)
    if total_nodes < 2:
        raise ValueError("diff-config requires at least two resolved nodes to compare")
    if max_elements is not None and total_nodes == 1:
        raise ValueError("--max-elements cannot be used when only one node is selected")
    node_ids = node_ids[:max_elements]
    if len(node_ids) < 2:
        raise ValueError("--max-elements must select at least two nodes for diff-config")
    truncated = len(node_ids) < total_nodes
    parameters = list(dict.fromkeys(parameters))
    wildcard = parameters == ["*"]
    requested_parameters = parameters

    def fetch(node_id: str) -> dict[str, str]:
        row = {"node_id": node_id, "error": ""}
        if wildcard:
            try:
                response = run_dfadmin(
                    environment, "node", "resp", node_id, "--", "CONFIG", "GET", "*"
                )
                for parameter, value in parse_all_config_values(response).items():
                    row[parameter] = "<redacted>" if is_sensitive_field(parameter) else value
                if len(row) == 2:
                    row["error"] = "could not parse any CONFIG GET * values"
            except RuntimeError as error:
                row["error"] = str(error)
            return row
        for parameter in parameters:
            try:
                value = run_dfadmin(
                    environment, "node", "resp", node_id, "--", "CONFIG", "GET", parameter
                )
                row[parameter] = (
                    "<redacted>"
                    if is_sensitive_field(parameter)
                    else normalize_config_value(parameter, value)
                )
            except RuntimeError as error:
                row[parameter] = "nil"
                row["error"] = str(error)
        return row

    rows = []
    with ThreadPoolExecutor(max_workers=min(workers, len(node_ids))) as executor:
        futures = [executor.submit(fetch, node_id) for node_id in node_ids]
        rows = [future.result() for future in futures]

    if wildcard:
        parameters = sorted(
            {
                parameter
                for row in rows
                for parameter in row
                if parameter not in {"node_id", "error"}
            }
        )
        if not parameters:
            raise RuntimeError("CONFIG GET * returned no parseable configuration parameters")
        for row in rows:
            for parameter in parameters:
                row.setdefault(parameter, "nil")

    difference_groups = config_difference_groups(parameters, rows)
    differing_parameters = [
        parameter for parameter, values in difference_groups.items() if len(values) > 1
    ]
    unavailable_parameters = [
        parameter
        for parameter in parameters
        if all(row[parameter] == "nil" for row in rows if not row["error"])
    ]
    report = {
        "command": "diff-config",
        "environment": environment,
        "targets": targets,
        "requested_parameters": requested_parameters,
        "parameters": parameters,
        "differing_parameters": differing_parameters,
        "parameter_value_groups": difference_groups,
        "unavailable_parameters": unavailable_parameters,
        "total_elements": total_nodes,
        "selected_elements": len(rows),
        "truncated": truncated,
        "rows": [
            {name: value for name, value in row.items() if name != "error" or value} for row in rows
        ],
    }
    if output_format == "json":
        print(json.dumps(report, indent=2, sort_keys=True))
    elif output_format == "vertical" and not report_only:
        if truncated:
            print(
                warning_message(
                    f"showing {len(rows)} of {total_nodes} nodes; results are partial."
                ),
                file=sys.stderr,
            )
        print_multi_vertical("node", parameters, rows, None)
    elif not report_only:
        columns = ["node_id", *parameters]
        if any(row["error"] for row in rows):
            columns.append("error")
        table_dimensions = table_exceeds_terminal_width(columns, rows, None)
        if table_dimensions:
            table_width, terminal_width = table_dimensions
            print(
                warning_message(
                    f"table width {table_width} exceeds terminal width {terminal_width}; "
                    "using vertical output."
                ),
                file=sys.stderr,
            )
            print_multi_vertical("node", parameters, rows, None)
        else:
            print_multi_table(columns, rows, None)
        if truncated:
            print(
                warning_message(
                    f"showing {len(rows)} of {total_nodes} nodes; results are partial."
                ),
                file=sys.stderr,
            )
    if output_format != "json":
        if not report_only:
            print()
        print_config_difference_report(difference_groups)
        if unavailable_parameters:
            print(f"Unavailable parameters: {', '.join(unavailable_parameters)}")
    return 2 if differing_parameters else 1 if any(row["error"] for row in rows) else 0


def layout_sections(layout: object) -> dict[str, set[str]]:
    """Map named Grafana row layouts to the panel element names they contain."""
    sections: dict[str, set[str]] = {}

    def element_references(value: object) -> set[str]:
        if isinstance(value, list):
            return set().union(*(element_references(item) for item in value)) if value else set()
        if not isinstance(value, dict):
            return set()
        names = (
            {value["name"]}
            if value.get("kind") == "ElementReference" and value.get("name")
            else set()
        )
        for child in value.values():
            names.update(element_references(child))
        return names

    def visit(value: object) -> None:
        if isinstance(value, list):
            for item in value:
                visit(item)
            return
        if not isinstance(value, dict):
            return
        kind = str(value.get("kind", "")).lower()
        raw_spec = value.get("spec")
        spec = raw_spec if isinstance(raw_spec, dict) else {}
        title = spec.get("title") or value.get("title")
        if "row" in kind and title:
            sections.setdefault(str(title), set()).update(element_references(spec))
        for child in value.values():
            visit(child)

    visit(layout)
    return {title: names for title, names in sections.items() if names}


def resolve_dashboard(context: str, source_folder: str, dashboard_title: str) -> tuple[str, str]:
    pacer = RequestPacer()
    pacer.wait()
    folders = run_gcx_json(gcx_command(context, "api", "/api/folders", "-X", "GET", "-o", "json"))
    folders = [
        folder for folder in folders if isinstance(folder.get("id"), int) and folder["id"] >= 0
    ]
    folder_matches = [folder for folder in folders if folder.get("title") == source_folder]
    if len(folder_matches) != 1:
        candidates = sorted({folder.get("title", "") for folder in folders if folder.get("title")})
        raise RuntimeError(
            f"expected exactly one Grafana source folder titled {source_folder!r}; "
            f"found {len(folder_matches)}. Valid source folders: "
            f"{', '.join(repr(candidate) for candidate in candidates)}."
        )
    folder_id = folder_matches[0]["uid"]
    pacer.wait()
    catalog = run_gcx_json(
        gcx_command(
            context, "dashboards", "search", "--folder", folder_id, "--limit", "0", "-o", "json"
        )
    )
    dashboards = [
        item
        for item in catalog.get("items", [])
        if item.get("spec", {}).get("title") == dashboard_title
    ]
    if len(dashboards) != 1:
        titles = sorted(item.get("spec", {}).get("title", "") for item in catalog.get("items", []))
        raise RuntimeError(
            f"expected exactly one dashboard titled {dashboard_title!r} in source folder "
            f"{source_folder!r}; found {len(dashboards)}. Dashboards in this folder: "
            f"{', '.join(repr(title) for title in titles if title)}."
        )
    dashboard_id = dashboards[0].get("metadata", {}).get("name")
    if not dashboard_id:
        raise RuntimeError(f"dashboard {dashboard_title!r} has no metadata.name")
    return str(folder_id), str(dashboard_id)


def export_dashboard_panels(
    source_folder: str,
    dashboard_title: str,
    panel_selector: str,
    start: str,
    end: str,
    output_root: Path,
    datastore_id: str,
    shard_id: str,
    node_id: str,
    rate_interval: str,
    context: str,
    datasource: str,
    sections: str,
    global_only: bool,
    resume: bool,
    dry_run: bool,
    verbose: bool = True,
) -> int:
    """Resolve and export selected panels while preserving the dashboard hierarchy."""
    if not datastore_id.startswith("dst_"):
        raise ValueError("datastore_id must begin with 'dst_'")
    if datetime.strptime(end, "%Y-%m-%dT%H:%M:%SZ") <= datetime.strptime(
        start, "%Y-%m-%dT%H:%M:%SZ"
    ):
        raise ValueError("end time must be after start time")
    folder_id, dashboard_id = resolve_dashboard(context, source_folder, dashboard_title)
    pacer = RequestPacer()
    pacer.wait()
    dashboard = run_gcx_json(gcx_command(context, "dashboards", "get", dashboard_id, "-o", "json"))
    panel_records = [
        (name, panel_title(panel), panel)
        for name, panel in dashboard.get("spec", {}).get("elements", {}).items()
        if panel.get("kind") == "Panel" and panel_title(panel)
    ]
    panels = [title for _, title, _ in panel_records]
    requested = [title.strip() for title in panel_selector.split(",") if title.strip()]
    if not requested:
        raise ValueError("panel selector must be '*' or one or more comma-separated panel titles")
    named_sections = layout_sections(dashboard.get("spec", {}).get("layout", {}))
    panel_sections = {
        panel_name: section_title
        for section_title, panel_names in named_sections.items()
        for panel_name in panel_names
    }
    section_names = [title.strip() for title in sections.split(",") if title.strip()]
    if section_names and panel_selector.strip() != "*":
        raise ValueError("--sections requires panel selector '*'")
    if section_names:
        missing_sections = [title for title in section_names if title not in named_sections]
        if missing_sections:
            available = ", ".join(repr(title) for title in sorted(named_sections)) or "none"
            raise RuntimeError(
                f"no named dashboard section titled {missing_sections[0]!r} exists; "
                f"available named sections: {available}."
            )
    if global_only:
        if panel_selector.strip() != "*":
            raise ValueError("--global-only requires panel selector '*'")
        section_panels = set().union(*named_sections.values()) if named_sections else set()
        selected = [
            (name, title, panel, None)
            for name, title, panel in panel_records
            if name not in section_panels
        ]
    elif panel_selector.strip() == "*":
        if section_names:
            section_panels = set().union(*(named_sections[title] for title in section_names))
            selected = [
                (name, title, panel, panel_sections.get(name))
                for name, title, panel in panel_records
                if name in section_panels
            ]
        else:
            selected = [
                (name, title, panel, panel_sections.get(name))
                for name, title, panel in panel_records
            ]
    else:
        missing = [title for title in requested if title not in panels]
        if missing:
            raise RuntimeError(
                f"no panel titled {missing[0]!r} exists."
                f"{close_match_message(missing[0], panels, 'panel')}"
            )
        selected = [
            (name, title, panel, None)
            for requested_title in requested
            for name, title, panel in panel_records
            if title == requested_title
        ]
    if verbose:
        print(f"Dashboard: {dashboard_title} ({dashboard_id}); selected panels: {len(selected)}")
    if dry_run:
        for _, title, _, section in selected:
            location = f"Sections/{section}" if section else "Panels"
            print(f"DRY RUN: {location}/{title}")
        return 0
    dashboard_output_dir = output_root / dashboard_output_component(source_folder, "source folder")
    dashboard_output_dir /= dashboard_output_component(dashboard_title, "dashboard")
    dashboard_output_dir.mkdir(parents=True, exist_ok=True)
    resume_path = dashboard_output_dir / "resume.json"
    progress = {
        "status": "in_progress",
        "source_folder": source_folder,
        "dashboard": dashboard_title,
        "dashboard_id": dashboard_id,
        "from": start,
        "to": end,
        "resume_with": "rerun this command with --resume",
        "panels": [],
    }
    progress_lock = threading.Lock()
    output_dirs = {}
    used_output_dirs = {}
    for selection in selected:
        _, title, _, section = selection
        output_dir = dashboard_output_dir
        if section:
            output_dir /= Path("Sections") / dashboard_output_component(section, "section")
        else:
            output_dir /= "Panels"
        output_dir /= dashboard_output_component(title, "panel")
        if output_dir in used_output_dirs:
            output_dir = output_dir.with_name(
                f"{output_dir.name}_{hashlib.sha256(selection[0].encode()).hexdigest()[:8]}"
            )
        used_output_dirs[output_dir] = selection[0]
        output_dir.mkdir(parents=True, exist_ok=True)
        output_dirs[selection[0]] = output_dir
        progress["panels"].append({"path": str(output_dir), "status": "planned"})
    write_json(resume_path, progress)

    def export_selected_panel(selection: tuple[str, str, dict, str | None]) -> None:
        name, title, panel, section = selection
        output_dir = output_dirs[name]
        status = export_resolved_dashboard_panel(
            source_folder,
            folder_id,
            dashboard_title,
            dashboard_id,
            dashboard,
            title,
            panel,
            section,
            output_dir,
            start,
            end,
            datastore_id,
            shard_id,
            node_id,
            rate_interval,
            context,
            datasource,
            pacer,
            resume,
            verbose,
        )
        with progress_lock:
            next(entry for entry in progress["panels"] if entry["path"] == str(output_dir))[
                "status"
            ] = status

    with ThreadPoolExecutor(
        max_workers=min(DEFAULT_DASHBOARD_QUERY_WORKERS, len(selected))
    ) as executor:
        futures = [executor.submit(export_selected_panel, selection) for selection in selected]
        failures = []
        for future in as_completed(futures):
            try:
                future.result()
            except (RuntimeError, ValueError) as error:
                failures.append(str(error))
    if failures:
        progress["status"] = "incomplete"
        progress["errors"] = failures
        write_json(resume_path, progress)
        raise RuntimeError(f"dashboard export incomplete; see {resume_path}: {failures[0]}")
    progress["status"] = "completed"
    write_json(resume_path, progress)
    write_dashboard_viewer(dashboard_output_dir)
    return 0


def dashboard_viewer_payload(dashboard_dir: Path) -> dict[str, object]:
    resume_path = dashboard_dir / "resume.json"
    try:
        resume = json.loads(resume_path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError(f"could not read dashboard export index {resume_path}: {error}") from error
    if not isinstance(resume, dict) or resume.get("status") != "completed":
        raise ValueError(f"dashboard export is not complete: {resume_path}")

    focus_nodes: list[str] = []
    datastore_id = ""
    for parent in dashboard_dir.parents:
        collection_report = parent / "artifacts" / "collection-report.json"
        if not collection_report.is_file():
            continue
        try:
            report = json.loads(collection_report.read_text())
        except (OSError, json.JSONDecodeError):
            break
        focus_nodes = sorted(
            str(entry["node_id"])
            for entry in report.get("nodes", [])
            if entry.get("status") == "COLLECTED" and entry.get("node_id")
        )
        break

    for parent in dashboard_dir.parents:
        bundle_manifest = parent / "manifest.json"
        if not bundle_manifest.is_file():
            continue
        try:
            manifest = json.loads(bundle_manifest.read_text())
        except (OSError, json.JSONDecodeError):
            break
        datastore_id = str(manifest.get("datastore_id", ""))
        break

    panels = []
    for entry in resume.get("panels", []):
        panel_path = Path(str(entry.get("path", "")))
        manifest_path = panel_path / "manifest.json"
        if entry.get("status") != "completed" or not manifest_path.is_file():
            continue
        try:
            manifest = json.loads(manifest_path.read_text())
        except (OSError, json.JSONDecodeError) as error:
            raise ValueError(f"could not read panel manifest {manifest_path}: {error}") from error
        queries = []
        for query in manifest.get("queries", []):
            output_name = query.get("output")
            if not isinstance(output_name, str):
                continue
            output_path = panel_path / output_name
            try:
                response = json.loads(output_path.read_text())
            except (OSError, json.JSONDecodeError) as error:
                raise ValueError(f"could not read captured query {output_path}: {error}") from error
            queries.append(
                {
                    "ref_id": query.get("ref_id", "?"),
                    "expression": query.get("expression", ""),
                    "response": response,
                }
            )
        panels.append(
            {
                "title": manifest.get("panel", panel_path.name),
                "section": manifest.get("section") or "Overview",
                "queries": queries,
            }
        )
    return {
        "dashboard": resume.get("dashboard", dashboard_dir.name),
        "from": resume.get("from", ""),
        "to": resume.get("to", ""),
        "datastore_id": datastore_id,
        "focus_nodes": focus_nodes,
        "panels": panels,
    }


