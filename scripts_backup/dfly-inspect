def write_dashboard_viewer(dashboard_dir: Path, output: Path | None = None) -> Path:
    viewer_path = output or dashboard_dir / "index.html"
    viewer_path.parent.mkdir(parents=True, exist_ok=True)
    viewer_path.write_text(dashboard_viewer_html(dashboard_viewer_payload(dashboard_dir)))
    return viewer_path


def first_value(value: object, names: set[str]) -> str:
    if isinstance(value, dict):
        for name, child in value.items():
            if name.lower() in names and child not in (None, ""):
                return str(child)
        for child in value.values():
            found = first_value(child, names)
            if found:
                return found
    elif isinstance(value, list):
        for child in value:
            found = first_value(child, names)
            if found:
                return found
    return ""


def node_record_is_deleted(record: Mapping[str, object]) -> bool:
    deleted_at = record.get("deleted_at")
    return deleted_at not in (None, "", "(unset)", 0, "0")


def find_node_records(value: object, include_deleted: bool = False) -> list[dict]:
    records = []
    if isinstance(value, dict):
        if value.get("node_id"):
            if include_deleted or not node_record_is_deleted(value):
                records.append(value)
        else:
            for child in value.values():
                records.extend(find_node_records(child, include_deleted))
    elif isinstance(value, list):
        for child in value:
            records.extend(find_node_records(child, include_deleted))
    return records


def find_customer_name(value: object) -> str:
    """Return an explicitly named customer value from a datastore payload."""
    return first_value(
        value,
        {
            "customer",
            "customer_name",
            "customer_display_name",
            "organization_name",
            "tenant_name",
            "account_name",
        },
    )


def discovery_topology_summary(report: Mapping[str, object], fallback_shards: int) -> str:
    totals = report.get("totals", {})
    if not isinstance(totals, dict):
        totals = {}
    selected = report.get("selected_elements", fallback_shards)
    selected_nodes = report.get("selected_nodes", 0)
    is_partial = selected != totals.get("shards", fallback_shards) or selected_nodes != totals.get(
        "nodes", selected_nodes
    )
    prefix = "Partial topology" if is_partial else "Topology"
    return (
        f"{prefix}: {selected} of {totals.get('shards', fallback_shards)} shards; "
        f"{selected_nodes} of {totals.get('nodes', selected_nodes)} unique nodes"
    )


def discovery_table_rows(
    report: Mapping[str, object], shards_only: bool
) -> list[tuple[str, str, str]]:
    shards = report["shards"]
    if not isinstance(shards, list):
        raise RuntimeError("discovery report has invalid shard data")
    public_ips = report.get("node_public_ips", {})
    if not isinstance(public_ips, dict):
        public_ips = {}
    rows = []
    for shard in shards:
        if not isinstance(shard, dict):
            continue
        shard_id = str(shard.get("shard_id") or "<unavailable>")
        primary = str(shard.get("primary") or "<unavailable>")
        if shards_only:
            rows.append((shard_id, str(shard.get("node_count", 0)), primary))
            continue
        primary_display = f"{primary} ({public_ips.get(primary) or '<unavailable>'})"
        replicas = shard.get("replicas", [])
        other_nodes = shard.get("other_nodes", [])
        members = (
            [*replicas, *other_nodes]
            if isinstance(replicas, list) and isinstance(other_nodes, list)
            else []
        )
        replica_display = (
            ", ".join(
                f"{node_id} ({public_ips.get(str(node_id)) or '<unavailable>'})"
                for node_id in members
            )
            or "<none>"
        )
        rows.append((shard_id, primary_display, replica_display))
    return rows


def render_discovery_report(
    report: Mapping[str, object], shards_only: bool, show_context: bool
) -> None:
    datastore_id = str(report["datastore_id"])
    headers = (
        ("Shard", "Nodes", "Primary")
        if shards_only
        else ("Shard", "Primary (public IP)", "Replicas (public IP)")
    )
    rows = discovery_table_rows(report, shards_only)
    widths = [
        max(len(header), *(len(row[index]) for row in rows)) for index, header in enumerate(headers)
    ]
    topology_summary = discovery_topology_summary(report, len(rows))
    if show_context:
        print(f"Datastore: {datastore_id} | {topology_summary}")
    print(f"{headers[0]:<{widths[0]}}  {headers[1]:<{widths[1]}}  {headers[2]}")
    print(f"{'-' * widths[0]}  {'-' * widths[1]}  {'-' * widths[2]}")
    for shard_id, primary, replicas in rows:
        print(f"{shard_id:<{widths[0]}}  {primary:<{widths[1]}}  {replicas}")


def discover_datastore(
    environment: str,
    target: str,
    json_output: bool = False,
    max_elements: int | None = None,
    include_deleted: bool = False,
    shards_only: bool = False,
    show_context: bool = True,
    report_out: list[dict[str, object]] | None = None,
) -> int:
    if max_elements is not None and max_elements <= 0:
        raise ValueError("--max-elements must be positive")
    target_shard_id = ""
    if target.startswith("node_"):
        target_shard_id, datastore_id = get_node_details(environment, target)
        if not target_shard_id:
            raise RuntimeError(f"could not identify the shard for {target}")
        if not datastore_id:
            raise RuntimeError(f"could not identify the datastore for {target}")
    elif target.startswith("shard_"):
        target_shard_id = target
        node_ids = get_shard_node_ids(environment, target)
        _, datastore_id = get_node_details(environment, sorted(node_ids)[0])
        if not datastore_id:
            raise RuntimeError(f"could not identify the datastore for {target}")
    elif target.startswith("dst_"):
        datastore_id = target
    else:
        raise ValueError(
            "target must be a node ID (node_...), shard ID (shard_...), or datastore ID (dst_...)"
        )

    datastore_arguments = ["--shards", "--nodes"]
    if include_deleted:
        datastore_arguments.append("--history")
    datastore = get_resource_show_json(environment, "datastore", datastore_id, *datastore_arguments)
    customer_name = find_customer_name(datastore)

    all_records = find_node_records(datastore, include_deleted=True)
    active_records = [record for record in all_records if not node_record_is_deleted(record)]
    datastore_node_ids = {
        first_value(record, {"node_id"})
        for record in active_records
        if first_value(record, {"node_id"})
    }
    datastore_shard_ids = {
        first_value(record, {"shard_id"}) or "<unavailable>" for record in active_records
    }
    scoped_records = [
        record
        for record in all_records
        if not target_shard_id or first_value(record, {"shard_id"}) == target_shard_id
    ]
    records = [record for record in scoped_records if not node_record_is_deleted(record)]
    historical_records = [
        record for record in scoped_records if include_deleted and node_record_is_deleted(record)
    ]
    if not records:
        raise RuntimeError("dfadmin returned no node records for this datastore")

    unique_records = {}
    public_ips = {}
    for record in records:
        node_id = first_value(record, {"node_id"})
        if node_id:
            unique_records[node_id] = record
            public_ips[node_id] = first_value(record, {"public_ip"}) or None

    shards = {}
    for node_id, record in unique_records.items():
        shard_id = first_value(record, {"shard_id"}) or "<unavailable>"
        role = first_value(record, {"role"}).lower()
        shard = shards.setdefault(shard_id, {"primary": "", "replicas": [], "other": []})
        if role in {"master", "primary"}:
            shard["primary"] = node_id
        elif role in {"slave", "replica"}:
            shard["replicas"].append(node_id)
        else:
            shard["other"].append(node_id)

    result_shards = []
    rows = []
    selected_total_shards = len(shards)
    if max_elements is not None and selected_total_shards == 1:
        raise ValueError("--max-elements cannot be used when only one shard is selected")
    selected_shards = sorted(shards.items())[:max_elements]
    truncated = len(selected_shards) < selected_total_shards
    for shard_id, members in selected_shards:
        replicas = sorted(members["replicas"])
        other_nodes = sorted(members["other"])
        result_shards.append(
            {
                "shard_id": None if shard_id == "<unavailable>" else shard_id,
                "primary": members["primary"] or None,
                "replicas": replicas,
                "other_nodes": other_nodes,
                "node_count": (
                    1 + len(replicas) + len(other_nodes)
                    if members["primary"]
                    else len(replicas) + len(other_nodes)
                ),
            }
        )
        if shards_only:
            rows.append(
                (
                    shard_id,
                    str(result_shards[-1]["node_count"]),
                    members["primary"] or "<unavailable>",
                )
            )
        else:
            display_members = replicas + other_nodes
            rows.append(
                (
                    shard_id,
                    members["primary"] or "<unavailable>",
                    ", ".join(display_members) or "<none>",
                )
            )

    replacements = {}
    for record in all_records:
        replaces = first_value(record, {"replaces"})
        node_id = first_value(record, {"node_id"})
        if replaces and node_id:
            replacements.setdefault(replaces, []).append(node_id)
    historical_nodes = [
        {
            "node_id": first_value(record, {"node_id"}),
            "shard_id": first_value(record, {"shard_id"}) or None,
            "public_ip": first_value(record, {"public_ip"}) or None,
            "deleted_at": first_value(record, {"deleted_at"}),
            "replaced_by": sorted(replacements.get(first_value(record, {"node_id"}), [])),
        }
        for record in historical_records
    ]

    json_shards = (
        [
            {
                "shard_id": shard["shard_id"],
                "primary": shard["primary"],
                "node_count": shard["node_count"],
            }
            for shard in result_shards
        ]
        if shards_only
        else result_shards
    )
    report = {
        "schema_version": TOPOLOGY_SCHEMA_VERSION,
        "command": "discover",
        "environment": environment,
        "datastore_id": datastore_id,
        "customer": customer_name or None,
        "shards": json_shards,
        "node_public_ips": public_ips,
        "totals": {"shards": len(datastore_shard_ids), "nodes": len(datastore_node_ids)},
        "historical_nodes": historical_nodes,
        "view": "shards-only" if shards_only else "topology",
        "selected_elements": len(result_shards),
        "selected_nodes": len(unique_records),
        "truncated": truncated,
    }
    if report_out is not None:
        report_out.append(report)
        return 0
    if json_output:
        print(json.dumps(report, indent=2))
        return 0
    if truncated:
        print(
            warning_message(
                f"showing {len(rows)} of {selected_total_shards} selected shards; results are partial."
            ),
            file=sys.stderr,
        )
    render_discovery_report(report, shards_only, show_context)
    if historical_nodes:
        print("\nDeleted nodes:")
        for node in historical_nodes:
            replacements_display = ", ".join(node["replaced_by"]) or "none in this response"
            print(
                f"{node['node_id']} ({node['public_ip'] or '<unavailable>'})  "
                f"deleted_at={node['deleted_at']}  "
                f"replaced_by={replacements_display}"
            )
    return 0


def discover_datastores(
    environment: str,
    targets: Sequence[str],
    json_output: bool = False,
    max_elements: int | None = None,
    include_deleted: bool = False,
    shards_only: bool = False,
    customer_target: str | None = None,
    short: bool = False,
) -> int:
    if len(targets) == 1 and customer_target is None and not short:
        return discover_datastore(
            environment, targets[0], json_output, max_elements, include_deleted, shards_only
        )
    collected_reports: list[tuple[str, dict[str, object]]] = []
    for target in targets:
        target_reports: list[dict[str, object]] = []
        discover_datastore(
            environment,
            target,
            False,
            max_elements,
            include_deleted,
            shards_only,
            report_out=target_reports,
        )
        collected_reports.append((target, target_reports[0]))
    full_datastores = {
        str(report["datastore_id"])
        for target, report in collected_reports
        if target.startswith("dst_")
    }
    reports: list[dict[str, object]] = []
    seen_scopes: set[tuple[str, tuple[str, ...]]] = set()
    for target, report in collected_reports:
        datastore_id = str(report["datastore_id"])
        if not target.startswith("dst_") and datastore_id in full_datastores:
            continue
        shards = report.get("shards", [])
        if not isinstance(shards, list):
            raise RuntimeError("discovery report has invalid shard data")
        shard_ids = tuple(
            sorted(
                str(shard.get("shard_id") or "<unavailable>")
                for shard in shards
                if isinstance(shard, dict)
            )
        )
        scope = (datastore_id, shard_ids)
        if scope not in seen_scopes:
            seen_scopes.add(scope)
            reports.append(report)
    if json_output:
        print(
            json.dumps(
                {
                    "schema_version": TOPOLOGY_SCHEMA_VERSION,
                    "command": "discover",
                    "environment": environment,
                    "customer": customer_target,
                    "datastores": reports,
                },
                indent=2,
            )
        )
        return 0
    inventory_rows = []
    total_shards = 0
    total_nodes = 0
    for report in reports:
        totals = report["totals"]
        shards = report["shards"]
        if not isinstance(totals, dict) or not isinstance(shards, list):
            raise RuntimeError("discovery report has invalid inventory data")
        datastore_id = str(report["datastore_id"])
        total_shard_count = int(totals.get("shards", 0))
        total_node_count = int(totals.get("nodes", 0))
        shard_count = len(shards)
        selected_nodes = report.get("selected_nodes", 0)
        if not isinstance(selected_nodes, int):
            raise RuntimeError("discovery report has invalid selected-node count")
        node_count = selected_nodes
        primary_count = sum(
            bool(shard.get("primary")) for shard in shards if isinstance(shard, dict)
        )
        replica_count = sum(
            len(shard.get("replicas", [])) for shard in shards if isinstance(shard, dict)
        )
        total_shards += total_shard_count
        total_nodes += total_node_count
        is_partial = shard_count != total_shard_count or node_count != total_node_count
        inventory_rows.append(
            {
                "datastore": datastore_id,
                "scope": "partial" if is_partial else "full",
                "shards": f"{shard_count} of {total_shard_count}",
                "nodes": f"{node_count} of {total_node_count}",
                "primaries": str(primary_count),
                "replicas": str(replica_count),
            }
        )
    if customer_target:
        print(f"Customer: {customer_target}")
    print(f"Datastores: {len(reports)} | Shards: {total_shards} | Nodes: {total_nodes}")
    print("\nSummary:")
    print("--------")
    print_multi_table(
        ["datastore", "scope", "shards", "nodes", "primaries", "replicas"],
        inventory_rows,
        None,
    )
    if short:
        return 0
    topology_rows = []
    for report in reports:
        datastore_id = str(report["datastore_id"])
        shards = report["shards"]
        public_ips = report.get("node_public_ips", {})
        if not isinstance(shards, list) or not isinstance(public_ips, dict):
            raise RuntimeError("discovery report has invalid topology data")
        first_datastore_row = True
        for shard in shards:
            if not isinstance(shard, dict):
                continue
            shard_id = str(shard.get("shard_id") or "<unavailable>")
            primary = str(shard.get("primary") or "<unavailable>")
            if shards_only:
                topology_rows.append(
                    {
                        "datastore": datastore_id if first_datastore_row else "",
                        "shard": shard_id,
                        "nodes": str(shard.get("node_count", 0)),
                        "primary": primary,
                    }
                )
            else:
                replica_ids = [
                    *shard.get("replicas", []),
                    *shard.get("other_nodes", []),
                ]
                if not all(isinstance(node_id, str) for node_id in replica_ids):
                    raise RuntimeError("discovery report has invalid replica data")
                topology_rows.append(
                    {
                        "datastore": datastore_id if first_datastore_row else "",
                        "shard": shard_id,
                        "primary (public IP)": (
                            f"{primary} ({public_ips.get(primary) or '<unavailable>'})"
                        ),
                        "replica (public IP)": (
                            f"{replica_ids[0]} ({public_ips.get(replica_ids[0]) or '<unavailable>'})"
                            if replica_ids
                            else ""
                        ),
                    }
                )
                for node_id in replica_ids[1:]:
                    topology_rows.append(
                        {
                            "datastore": "",
                            "shard": "",
                            "primary (public IP)": "",
                            "replica (public IP)": (
                                f"{node_id} ({public_ips.get(node_id) or '<unavailable>'})"
                            ),
                        }
                    )
            first_datastore_row = False
    print("\nTopology:")
    print("---------")
    print_multi_table(
        (
            ["datastore", "shard", "nodes", "primary"]
            if shards_only
            else ["datastore", "shard", "primary (public IP)", "replica (public IP)"]
        ),
        topology_rows,
        None,
    )
    return 0


def check_pair(
    environment: str,
    first_node_id: str,
    second_node_id: str,
    parameter: str,
    dry_run: bool = False,
) -> int:
    if dry_run:
        if not first_node_id.startswith("node_") or not second_node_id.startswith("node_"):
            raise ValueError("node IDs must begin with 'node_'")
        print("Dry run: no control-plane or Redis requests will be sent.")
        for node_id in (first_node_id, second_node_id):
            print(
                f"Planned command: dfadmin-wrapper --env {environment} node show {node_id} --output json"
            )
            print(
                f"Planned command: dfadmin-wrapper --env {environment} node resp {node_id} -- INFO replication"
            )
        print("After topology and role validation, the following commands will run for both nodes:")
        for node_id in (first_node_id, second_node_id):
            print(
                f"Planned command: dfadmin-wrapper --env {environment} node resp {node_id} -- INFO keyspace"
            )
            print(
                f"Planned command: dfadmin-wrapper --env {environment} node resp {node_id} -- CONFIG GET {parameter}"
            )
        return 0
    first_shard, first_datastore = get_node_details(environment, first_node_id)
    second_shard, second_datastore = get_node_details(environment, second_node_id)
    first_role, first_replication = get_role(environment, first_node_id)
    second_role, second_replication = get_role(environment, second_node_id)

    print("Dragonfly Primary and Replica Pair Report")
    print(f"Environment: {environment}")
    print(
        f"First node:  {first_node_id} (role: {first_role or 'unknown'}, "
        f"shard: {first_shard or 'unknown'}, datastore: {first_datastore or 'unknown'})"
    )
    print(
        f"Second node: {second_node_id} (role: {second_role or 'unknown'}, "
        f"shard: {second_shard or 'unknown'}, datastore: {second_datastore or 'unknown'})"
    )

    if not first_shard or first_shard != second_shard:
        print(
            "Pair validation: FAIL - nodes are not in the same shard. No key-count comparison made."
        )
        return 2
    if not first_datastore or first_datastore != second_datastore:
        print(
            "Pair validation: FAIL - nodes are not in the same datastore. No key-count comparison made."
        )
        return 2

    roles = {first_role: first_node_id, second_role: second_node_id}
    if set(roles) != {"master", "slave"}:
        print(
            "Pair validation: FAIL - expected one primary and one replica; "
            f"got {first_role or 'unknown'} and {second_role or 'unknown'}."
        )
        if not first_role:
            print(f"First node replication response: {first_replication or '<empty response>'}")
        if not second_role:
            print(f"Second node replication response: {second_replication or '<empty response>'}")
        return 2

    master_node_id = roles["master"]
    replica_node_id = roles["slave"]

    def sample_key_counts(node_id: str) -> tuple[dict[str, int], float, float]:
        started_at = time.monotonic()
        counts = get_key_counts(environment, node_id)
        return counts, started_at, time.monotonic()

    with ThreadPoolExecutor(max_workers=2) as executor:
        master_future = executor.submit(sample_key_counts, master_node_id)
        replica_future = executor.submit(sample_key_counts, replica_node_id)
        master_counts, master_started, master_finished = master_future.result()
        replica_counts, replica_started, replica_finished = replica_future.result()
    master_keys, replica_keys = sum(master_counts.values()), sum(replica_counts.values())
    signed_gap = master_keys - replica_keys
    sampling_window = max(master_finished, replica_finished) - min(master_started, replica_started)

    print(
        f"Pair validation: PASS - same shard {first_shard}; "
        f"primary={master_node_id} replica={replica_node_id}"
    )
    print(
        f"Primary keys: {master_keys} ({', '.join(f'{database}={count}' for database, count in sorted(master_counts.items()))})"
    )
    print(
        f"Replica keys: {replica_keys} ({', '.join(f'{database}={count}' for database, count in sorted(replica_counts.items()))})"
    )
    print(f"Key-count sampling window: {sampling_window:.2f}s; live writes can affect small gaps.")
    print(f"Primary - replica gap: {signed_gap} (absolute: {abs(signed_gap)})")
    if signed_gap < 0:
        print(f"Direction: replica has {abs(signed_gap)} more keys than primary.")
    elif signed_gap > 0:
        print(f"Direction: primary has {abs(signed_gap)} more keys than replica.")
    else:
        print("Direction: key counts match.")

    master_config = get_config(environment, master_node_id, parameter)
    replica_config = get_config(environment, replica_node_id, parameter)
    print(f"\nCONFIG GET {parameter}")
    print(
        f"Primary response: {master_config if not config_response_is_empty(master_config) else '<not exposed>'}"
    )
    print(
        f"Replica response: {replica_config if not config_response_is_empty(replica_config) else '<not exposed>'}"
    )
    if config_response_is_empty(master_config) and config_response_is_empty(replica_config):
        print(
            "Interpretation: parameter is not exposed by CONFIG GET; this does not prove it is unset."
        )
    return 0


def encode_scan_iterator(cursors: dict[str, str]) -> str:
    payload = json.dumps(cursors, sort_keys=True, separators=(",", ":")).encode()
    return base64.urlsafe_b64encode(payload).decode().rstrip("=")


def decode_scan_iterator(value: str, node_ids: set[str]) -> dict[str, str]:
    try:
        padded = value + "=" * (-len(value) % 4)
        cursors = json.loads(base64.urlsafe_b64decode(padded).decode())
    except (ValueError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ValueError("--iterator must be a token produced by scan-compare") from error
    if not isinstance(cursors, dict) or set(cursors) != node_ids:
        raise ValueError("--iterator belongs to a different node pair")
    if not all(isinstance(cursor, str) and cursor.isdigit() for cursor in cursors.values()):
        raise ValueError("--iterator contains invalid cursors")
    return cursors


def redis_cluster_slot(key: bytes) -> int:
    match = re.search(rb"\{([^{}]*)\}", key)
    hash_key = match.group(1) if match and match.group(1) else key
    return binascii.crc_hqx(hash_key, 0) % 16384


def parse_slots(value: str) -> set[int]:
    slots = set()
    for item in value.split(","):
        item = item.strip()
        if not item:
            continue
        start_text, separator, end_text = item.partition("-")
        try:
            start = int(start_text)
            end = int(end_text) if separator else start
        except ValueError as error:
            raise ValueError(
                "--slots must be comma-separated slot IDs or ranges, such as 563,100-105"
            ) from error
        if not 0 <= start <= end < 16384:
            raise ValueError("--slots must be between 0 and 16383")
        slots.update(range(start, end + 1))
    if not slots:
        raise ValueError("--slots must contain at least one slot")
    return slots


def migration_records(value: object) -> list[dict]:
    if isinstance(value, dict):
        if "migration_id" in value and "config" in value:
            return [value]
        records = []
        for child in value.values():
            records.extend(migration_records(child))
        return records
    if isinstance(value, list):
        return [record for child in value for record in migration_records(child)]
    return []


def format_slot_ranges(ranges: object) -> str:
    if not isinstance(ranges, list):
        return "<unavailable>"
    formatted = []
    for slot_range in ranges:
        if not isinstance(slot_range, dict):
            continue
        start, end = slot_range.get("start"), slot_range.get("end")
        if isinstance(start, int) and isinstance(end, int):
            formatted.append(str(start) if start == end else f"{start}-{end}")
    return ",".join(formatted) or "<none>"


def migration_report(
    environment: str,
    history_path: Path,
    scope: str,
    output: Path | None,
    shard_filter: set[str] | None,
    state_filter: str | None,
    recover_malformed_history: bool,
    max_elements: int | None = None,
) -> int:
    if max_elements is not None and max_elements <= 0:
        raise ValueError("--max-elements must be positive")
    try:
        history_text = history_path.read_text()
    except OSError as error:
        raise RuntimeError(f"could not read migration history: {error}") from error
    repairs: list[str] = []
    if recover_malformed_history:

        def remove_numeric_suffix(match: re.Match[str]) -> str:
            repairs.append(match.group(0))
            return match.group(1)

        history_text = re.sub(
            r"(\b\d+)([A-Za-z]+)(?=\s*[,}\]])", remove_numeric_suffix, history_text
        )
    try:
        history = json.loads(history_text)
    except json.JSONDecodeError as error:
        raise ValueError(
            f"migration history is not valid JSON at line {error.lineno}, column {error.colno}: {error.msg}"
        ) from error
    if scope.startswith("node_"):
        shard_id, datastore_id = get_node_details(environment, scope)
        if not shard_id or not datastore_id:
            raise RuntimeError(f"could not resolve shard and datastore for node {scope}")
    elif scope.startswith("shard_"):
        shard_id, datastore_id = scope, None
    elif scope.startswith("dst_"):
        shard_id, datastore_id = None, scope
    else:
        raise ValueError("scope must be a node ID, shard ID, or datastore ID")
    records = []
    for migration in migration_records(history):
        config = migration.get("config")
        if not isinstance(config, dict):
            continue
        source, target = config.get("source"), config.get("target")
        if not isinstance(source, dict) or not isinstance(target, dict):
            continue
        if datastore_id and config.get("datastore_id") != datastore_id:
            continue
        direction = ""
        if shard_id:
            direction = (
                "outbound"
                if source.get("shard_id") == shard_id
                else "inbound" if target.get("shard_id") == shard_id else ""
            )
        if shard_id and not direction:
            continue
        status_value = migration.get("status")
        status = status_value if isinstance(status_value, dict) else {}
        state = status.get("state", "unknown")
        involved_shards = {source.get("shard_id"), target.get("shard_id")}
        if shard_filter and not involved_shards.intersection(shard_filter):
            continue
        if state_filter and state != state_filter:
            continue
        records.append(
            {
                "migration_id": migration.get("migration_id"),
                "direction": direction,
                "state": state,
                "source_shard": source.get("shard_id"),
                "target_shard": target.get("shard_id"),
                "slot_ranges": config.get("slot_ranges", []),
                "started_at": migration.get("started_at"),
                "finished_at": migration.get("finished_at"),
            }
        )
    records.sort(key=lambda record: (record["started_at"] or 0, record["migration_id"] or ""))
    total_records = len(records)
    if max_elements is not None and total_records == 1:
        raise ValueError("--max-elements cannot be used when only one migration is selected")
    records = records[:max_elements]
    truncated = len(records) < total_records
    result = {
        "history": str(history_path),
        "scope": scope,
        "shard_id": shard_id,
        "datastore_id": datastore_id,
        "migrations": records,
        "summary": {"total": total_records, "selected": len(records), "truncated": truncated},
        "shard_filter": sorted(shard_filter) if shard_filter else None,
        "state_filter": state_filter,
        "repaired_values": repairs,
    }
    if shard_id:
        result["summary"] |= {
            direction: sum(record["direction"] == direction for record in records)
            for direction in ("outbound", "inbound")
        }
    print("Migration History Report")
    print(f"Scope: {scope}")
    if shard_id:
        print(f"Shard: {shard_id}")
        print(f"Outbound: {result['summary']['outbound']}; inbound: {result['summary']['inbound']}")
    else:
        print(f"Datastore: {datastore_id}; migrations: {result['summary']['total']}")
    if repairs:
        print(f"Recovered malformed values in memory: {', '.join(repairs)}")
    if truncated:
        print(
            warning_message(
                f"showing {len(records)} of {total_records} migrations; results are partial."
            ),
            file=sys.stderr,
        )
    for record in records:
        if shard_id:
            counterpart = (
                record["target_shard"]
                if record["direction"] == "outbound"
                else record["source_shard"]
            )
            scope_detail = f"{record['direction']} counterpart={counterpart}"
        else:
            scope_detail = f"source={record['source_shard']} target={record['target_shard']}"
        print(
            f"{scope_detail} {record['migration_id']} state={record['state']} slots={format_slot_ranges(record['slot_ranges'])}"
        )
    if output:
        write_json(output, result)
        print(f"Report: {output}")
    return 0


def remote_redis_json(bastion: str, public_ip: str, script: str) -> dict:
    result = subprocess.run(
        remote_ssh_command(bastion, public_ip),
        input=script,
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or "no output"
        raise RuntimeError(f"remote Redis command failed: {detail}")
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError(f"remote Redis command returned invalid JSON: {error.msg}") from error


def remote_cluster_slots(bastion: str, public_ip: str) -> list[tuple[int, int, str]]:
    script = """set -eu
python3 - <<'PY'
import json
import subprocess

result = subprocess.run(
    ["redis-cli", "--json", "-h", "127.0.0.1", "-p", "9999", "CLUSTER", "SLOTS"],
    text=True, capture_output=True, check=False,
)
if result.returncode:
    raise SystemExit(result.stderr.strip() or "redis-cli CLUSTER SLOTS failed")
print(result.stdout)
PY
"""
    result = subprocess.run(
        remote_ssh_command(bastion, public_ip),
        input=script,
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode:
        detail = result.stderr.strip() or result.stdout.strip() or "no stdout or stderr"
        raise RuntimeError(f"remote CLUSTER SLOTS command exited {result.returncode}: {detail}")
    try:
        response = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError(f"remote CLUSTER SLOTS returned invalid JSON: {error.msg}") from error
    if not isinstance(response, list):
        raise RuntimeError("remote CLUSTER SLOTS response has an invalid shape")
    ranges = []
    for entry in response:
        if not isinstance(entry, list) or len(entry) < 3:
            raise RuntimeError("remote CLUSTER SLOTS response contains an invalid range")
        start, end, owner = entry[:3]
        if (
            not isinstance(start, int)
            or not isinstance(end, int)
            or not isinstance(owner, list)
            or len(owner) < 3
        ):
            raise RuntimeError("remote CLUSTER SLOTS response contains invalid ownership data")
        node_id = owner[2]
        if not isinstance(node_id, str) or not 0 <= start <= end < 16384:
            raise RuntimeError("remote CLUSTER SLOTS response contains invalid ownership values")
        ranges.append((start, end, node_id))
    return sorted(ranges)


def resolve_slot_ownership_nodes(
    environment: str, targets: list[str], workers: int
) -> tuple[str, dict[str, str]]:
    if len(targets) == 1 and targets[0].startswith("dst_"):
        node_ids = get_datastore_node_ids(environment, targets[0])
    elif all(target.startswith("node_") for target in targets):
        node_ids = list(dict.fromkeys(targets))
    else:
        raise ValueError("use one datastore ID or a list of node IDs; do not mix target domains")
    metadata = run_parallel_node_operations(
        node_ids, workers, lambda node_id: get_node_metadata(environment, node_id)
    )
    addresses = {node_id: details[3] for node_id, details in metadata.items()}
    datastore_ids = {details[1] for details in metadata.values()}
    if "" in datastore_ids or len(datastore_ids) != 1:
        raise ValueError("all nodes must belong to one datastore")
    if not all(addresses.values()):
        raise RuntimeError("could not resolve a public address for every node")
    return datastore_ids.pop(), addresses


def owners_by_slot(mapping: list[tuple[int, int, str]]) -> list[str]:
    owners = ["<unassigned>"] * 16384
    for start, end, owner in mapping:
        owners[start : end + 1] = [owner] * (end - start + 1)
    return owners


def compact_slot_ranges(slots: list[int]) -> str:
    if not slots:
        return "none"
    ranges = []
    start = previous = slots[0]
    for slot in slots[1:]:
        if slot == previous + 1:
            previous = slot
            continue
        ranges.append(str(start) if start == previous else f"{start}-{previous}")
        start = previous = slot
    ranges.append(str(start) if start == previous else f"{start}-{previous}")
    return ",".join(ranges)


def slot_range_for(mapping: list[tuple[int, int, str]], slot: int) -> tuple[int, int, str] | None:
    return next(
        ((start, end, owner) for start, end, owner in mapping if start <= slot <= end), None
    )


def slot_ownership(
    environment: str,
    targets: list[str],
    bastion: str,
    slots: set[int] | None,
    output: Path | None,
    workers: int,
    dry_run: bool = False,
) -> int:
    if dry_run:
        if len(targets) == 1 and targets[0].startswith("dst_"):
            resolution = f"list nodes for datastore {targets[0]}"
        elif targets and all(target.startswith("node_") for target in targets):
            resolution = (
                f"resolve metadata and public addresses for {', '.join(dict.fromkeys(targets))}"
            )
        else:
            raise ValueError(
                "use one datastore ID or a list of node IDs; do not mix target domains"
            )
        print("Dry run: no control-plane or SSH requests will be sent.")
        print(f"Planned topology resolution: {resolution}")
        print(
            f"Planned remote command: SSH through {bastion}, then redis-cli --json CLUSTER SLOTS on each resolved node"
        )
        print(
            f"Planned comparison: {'selected slots' if slots else 'all 16,384 slots'}; maximum parallel queries: {workers}"
        )
        if output:
            print(f"Planned local report: {output}")
        return 0
    started_at = time.monotonic()
    datastore_id, addresses = resolve_slot_ownership_nodes(environment, targets, workers)
    mappings = run_parallel_node_operations(
        list(addresses), workers, lambda node_id: remote_cluster_slots(bastion, addresses[node_id])
    )
    reference_node, reference = next(iter(mappings.items()))
    slot_owners = {node_id: owners_by_slot(mapping) for node_id, mapping in mappings.items()}
    reference_owners = slot_owners[reference_node]
    comparison_slots = sorted(slots) if slots else list(range(16384))
    differences = {
        node_id: [slot for slot in comparison_slots if owners[slot] != reference_owners[slot]]
        for node_id, owners in slot_owners.items()
    }
    differences = {
        node_id: different_slots
        for node_id, different_slots in differences.items()
        if different_slots
    }
    result = {
        "command": "slot-ownership",
        "environment": environment,
        "datastore_id": datastore_id,
        "nodes": {
            node_id: [{"start": start, "end": end, "owner": owner} for start, end, owner in mapping]
            for node_id, mapping in mappings.items()
        },
        "mappings_match": not differences,
        "different_slots": differences,
        "comparison_scope": "selected_slots" if slots else "complete_map",
        "slots": sorted(slots) if slots else None,
        "elapsed_seconds": round(time.monotonic() - started_at, 2),
    }
    print("Slot Ownership Report")
    print(f"Datastore: {datastore_id}")
    print(f"Nodes checked: {', '.join(addresses)}")
    scope_description = (
        f"{len(comparison_slots)} selected slots" if slots else "complete map (all 16,384 slots)"
    )
    print(f"Comparison scope: {scope_description}")
    print(f"Ownership results: {'match' if result['mappings_match'] else 'differ'}")
    for node_id, mapping in mappings.items():
        print(f"{node_id}: source response contains {len(mapping)} CLUSTER SLOTS range entries")
    if slots:
        print(f"Selected individual slots ({len(slots)} requested; not a range listing):")
        for slot in sorted(slots):
            reported_ranges = {
                node_id: slot_range_for(mapping, slot) for node_id, mapping in mappings.items()
            }
            owners = []
            for node_id, range_info in reported_ranges.items():
                if range_info:
                    start, end, owner = range_info
                    owners.append(f"{node_id}={owner} (range {start}-{end})")
                else:
                    owners.append(f"{node_id}=<unassigned>")
            print(f"  slot {slot}: " + "; ".join(owners))
    print("Difference summary:")
    if not differences:
        print(f"  None; ownership agrees for the {scope_description}.")
    else:
        for node_id, different_slots in differences.items():
            print(
                f"  {node_id} differs from {reference_node} for {len(different_slots)} slots: {compact_slot_ranges(different_slots)}"
            )
    if output:
        write_json(output, result)
        print(f"Report: {output}")
    print(f"Elapsed time: {result['elapsed_seconds']:.2f} seconds")
    return 0 if result["mappings_match"] else 2


def remote_scan(bastion: str, public_ip: str, cursor: str, count: int) -> tuple[str, list[bytes]]:
    script = f"""set -eu
python3 - <<'PY'
import base64
import json
import socket

def command(*parts):
    encoded = [part if isinstance(part, bytes) else str(part).encode() for part in parts]
    return b"*" + str(len(encoded)).encode() + b"\\r\\n" + b"".join(
        b"$" + str(len(part)).encode() + b"\\r\\n" + part + b"\\r\\n" for part in encoded
    )
def response(reader):
    prefix = reader.read(1)
    if prefix == b"$":
        length = int(reader.readline())
        return None if length == -1 else reader.read(length) + reader.read(2)[:-2]
    if prefix == b"*":
        return [response(reader) for _ in range(int(reader.readline()))]
    if prefix == b"-":
        raise SystemExit(reader.readline().decode(errors="replace").strip())
    raise SystemExit(f"unexpected RESP prefix: {{prefix!r}}")
with socket.create_connection(("127.0.0.1", 9999), timeout=15) as connection:
    connection.sendall(command("SCAN", {cursor!r}, "COUNT", {count}))
    result = response(connection.makefile("rb"))
if not isinstance(result, list) or len(result) != 2 or not isinstance(result[0], bytes) or not isinstance(result[1], list):
    raise SystemExit("invalid SCAN response")
if not all(isinstance(key, bytes) for key in result[1]):
    raise SystemExit("SCAN response contains a non-bulk key")
print(json.dumps({{"cursor": result[0].decode(), "keys": [base64.b64encode(key).decode() for key in result[1]]}}))
PY
"""
    response = remote_redis_json(bastion, public_ip, script)
    next_cursor, keys = response.get("cursor"), response.get("keys")
    if not isinstance(next_cursor, str) or not next_cursor.isdigit() or not isinstance(keys, list):
        raise RuntimeError("remote SCAN response has an invalid shape")
    if not all(isinstance(key, str) for key in keys):
        raise RuntimeError("remote SCAN response contains a non-string key")
    try:
        return next_cursor, [base64.b64decode(key, validate=True) for key in keys]
    except binascii.Error as error:
        raise RuntimeError("remote SCAN response contains an invalid base64 key") from error


def remote_missing_keys(bastion: str, public_ip: str, keys: list[bytes]) -> list[int]:
    if not keys:
        return []
    script = f"""set -eu
python3 - <<'PY'
import json
import socket
import base64

keys = [base64.b64decode(key, validate=True) for key in json.loads({json.dumps([base64.b64encode(key).decode() for key in keys])!r})]
def command(*parts):
    encoded = [part if isinstance(part, bytes) else part.encode() for part in parts]
    return b"*" + str(len(encoded)).encode() + b"\\r\\n" + b"".join(
        b"$" + str(len(part)).encode() + b"\\r\\n" + part + b"\\r\\n" for part in encoded
    )

with socket.create_connection(("127.0.0.1", 9999), timeout=15) as connection:
    connection.sendall(b"".join(command("EXISTS", key) for key in keys))
    reader = connection.makefile("rb")
    missing = []
    for index in range(1, len(keys) + 1):
        response = reader.readline()
        if response == b":0\\r\\n":
            missing.append(index)
        elif response != b":1\\r\\n":
            raise SystemExit(f"unexpected EXISTS response: {{response[:100]!r}}")
print(json.dumps({{"missing": missing}}))
PY
"""
    response = remote_redis_json(bastion, public_ip, script)
    missing = response.get("missing")
    if not isinstance(missing, list) or not all(isinstance(index, int) for index in missing):
        raise RuntimeError("remote EXISTS response has an invalid shape")
    if any(index < 1 or index > len(keys) for index in missing):
        raise RuntimeError("remote EXISTS response contains an invalid key index")
    return missing


def scan_compare(
    environment: str,
    first_node_id: str,
    second_node_id: str,
    bastion: str,
    count: int,
    max_iterations: int,
    stop_after_diffs: int | None,
    iterator: str | None,
    output: Path | None,
    force: bool,
    show_keys: bool,
    slots: set[int] | None,
    progress_every: int | None,
    confirm_delay: float,
    dry_run: bool = False,
) -> int:
    if count <= 0 or max_iterations <= 0:
        raise ValueError("--count and --max-iterations must be positive")
    if stop_after_diffs is not None and stop_after_diffs <= 0:
        raise ValueError("--stop-after-diffs must be positive")
    if progress_every is not None and progress_every <= 0:
        raise ValueError("--progress must be positive")
    if confirm_delay < 0:
        raise ValueError("--confirm-delay must not be negative")
    if dry_run:
        if not first_node_id.startswith("node_") or not second_node_id.startswith("node_"):
            raise ValueError("node IDs must begin with 'node_'")
        print("Dry run: no control-plane or SSH requests will be sent.")
        print(
            f"Planned topology validation: resolve shard, datastore, role, and public address for {first_node_id}, {second_node_id}"
        )
        print(
            f"Planned remote commands: SSH through {bastion}; SCAN COUNT {count} on each node, then EXISTS batches on its peer"
        )
        print(
            f"Planned limits: at most {max_iterations} SCAN calls per node; stop after {stop_after_diffs or 'no configured'} differences"
        )
        print(
            f"Planned slot filter: {compact_slot_ranges(sorted(slots)) if slots else 'all slots'}; confirmation delay: {confirm_delay:g}s"
        )
        if iterator:
            print(f"Planned resume iterator: {iterator}")
        if output:
            print(f"Planned local report: {output}")
        else:
            print("Planned local report: generated after shard resolution")
        return 0
    first_shard, first_datastore = get_node_details(environment, first_node_id)
    second_shard, second_datastore = get_node_details(environment, second_node_id)
    if not first_shard or first_shard != second_shard or first_datastore != second_datastore:
        raise ValueError("nodes must belong to the same shard and datastore")
    first_role, _ = get_role(environment, first_node_id)
    second_role, _ = get_role(environment, second_node_id)
    roles = {first_role: first_node_id, second_role: second_node_id}
    if set(roles) != {"master", "slave"}:
        raise ValueError("expected one primary and one replica")
    primary, replica = roles["master"], roles["slave"]
    addresses = {
        node_id: get_node_address(environment, node_id)[2] for node_id in (primary, replica)
    }
    if not all(addresses.values()):
        raise RuntimeError("could not resolve a public address for both nodes")
    if output is None:
        timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        output = Path(f"scan-compare-{first_shard}-{timestamp}.json")
    elif output.exists() and not force:
        raise ValueError(f"report already exists: {output}; use --force to overwrite it")
    if show_keys:
        print(
            warning_message(
                "--show-keys writes customer key names to the terminal and JSON report."
            ),
            file=sys.stderr,
        )
    cursors = (
        decode_scan_iterator(iterator, {primary, replica})
        if iterator
        else {primary: "0", replica: "0"}
    )
    if iterator:
        print("Resuming scan from supplied iterator:")
        print(f"  {primary} cursor={cursors[primary]}")
        print(f"  {replica} cursor={cursors[replica]}")
    report = {
        "command": "scan-compare",
        "environment": environment,
        "shard_id": first_shard,
        "datastore_id": first_datastore,
        "primary": primary,
        "replica": replica,
        "started_at": datetime.now(timezone.utc).isoformat(),
        "count": count,
        "max_iterations_per_node": max_iterations,
        "stop_after_diffs": stop_after_diffs,
        "confirm_delay_seconds": confirm_delay,
        "slots": sorted(slots) if slots else None,
        "progress_every": progress_every,
        "input_iterator": iterator,
        "nodes": {
            node_id: {
                "cursor_start": cursors[node_id],
                "cursor_end": cursors[node_id],
                "iterations": 0,
                "keys_scanned": 0,
                "keys_matching_slots": 0,
                "complete": False,
            }
            for node_id in (primary, replica)
        },
        "candidates": {"primary_only": 0, "replica_only": 0},
        "differences": {"primary_only": 0, "replica_only": 0, "examples": []},
    }
    exit_code, stop_reason = 0, "completed"
    try:
        while True:
            for source, other, direction in (
                (primary, replica, "primary_only"),
                (replica, primary, "replica_only"),
            ):
                node_report = report["nodes"][source]
                if cursors[source] == "0" and node_report["iterations"]:
                    node_report["complete"] = True
                    continue
                if node_report["iterations"] >= max_iterations:
                    stop_reason, exit_code = "max_iterations", EXIT_INCONCLUSIVE
                    break
                next_cursor, keys = remote_scan(bastion, addresses[source], cursors[source], count)
                cursors[source] = next_cursor
                node_report["cursor_end"] = next_cursor
                node_report["iterations"] += 1
                node_report["keys_scanned"] += len(keys)
                if show_keys:
                    for key in keys:
                        print(
                            f"scanned source={source} slot={redis_cluster_slot(key)} key_base64={base64.b64encode(key).decode()}"
                        )
                compare_keys = [
                    key for key in keys if slots is None or redis_cluster_slot(key) in slots
                ]
                node_report["keys_matching_slots"] += len(compare_keys)
                candidates = [
                    compare_keys[index - 1]
                    for index in remote_missing_keys(bastion, addresses[other], compare_keys)
                ]
                report["candidates"][direction] += len(candidates)
                if candidates and confirm_delay:
                    time.sleep(confirm_delay)
                for index in remote_missing_keys(bastion, addresses[other], candidates):
                    key = candidates[index - 1]
                    evidence = {
                        "direction": direction,
                        "slot": redis_cluster_slot(key),
                        "key_sha256": hashlib.sha256(key).hexdigest(),
                    }
                    if show_keys:
                        evidence["key_base64"] = base64.b64encode(key).decode()
                    report["differences"][direction] += 1
                    report["differences"]["examples"].append(evidence)
                    print(
                        f"{direction} slot={evidence['slot']} key_sha256={evidence['key_sha256']}"
                        + (f" key_base64={evidence['key_base64']}" if show_keys else "")
                    )
                    if (
                        stop_after_diffs
                        and sum(
                            report["differences"][item] for item in ("primary_only", "replica_only")
                        )
                        >= stop_after_diffs
                    ):
                        stop_reason, exit_code = "stop_after_diffs", EXIT_DIVERGED
                        break
                if stop_reason != "completed":
                    break
                if next_cursor == "0":
                    node_report["complete"] = True
                if progress_every and (
                    node_report["iterations"] % progress_every == 0 or next_cursor == "0"
                ):
                    print(
                        f"progress source={source} iterations={node_report['iterations']} keys_scanned={node_report['keys_scanned']} keys_matching_slots={node_report['keys_matching_slots']} cursor={next_cursor}"
                    )
            if stop_reason != "completed" or all(
                report["nodes"][node_id]["complete"] for node_id in (primary, replica)
            ):
                break
    except KeyboardInterrupt:
        stop_reason, exit_code = "interrupted", 130
        print("Scan interrupted; writing resume report.", file=sys.stderr)
    except (RuntimeError, ValueError):
        stop_reason = "error"
        raise
    finally:
        report["finished_at"] = datetime.now(timezone.utc).isoformat()
        has_differences = bool(
            report["differences"]["primary_only"] or report["differences"]["replica_only"]
        )
        report["status"] = (
            "diverged"
            if has_differences
            else {
                "completed": "complete",
                "max_iterations": "inconclusive",
                "stop_after_diffs": "diverged",
            }.get(stop_reason, "incomplete")
        )
        report["stop_reason"] = stop_reason
        report["resume_iterator"] = encode_scan_iterator(cursors)
        output.parent.mkdir(parents=True, exist_ok=True)
        write_json(output, report)
        print("-" * 80)
        print("Scan Compare Report")
        print(f"Status: {report['status']}; stop reason: {stop_reason}")
        for node_id in (primary, replica):
            node_report = report["nodes"][node_id]
            print(
                f"{node_id}: keys scanned={node_report['keys_scanned']}; matching slots={node_report['keys_matching_slots']}; iterations={node_report['iterations']}; cursor={node_report['cursor_end']}"
            )
        print(
            f"Candidates: primary-only={report['candidates']['primary_only']}; replica-only={report['candidates']['replica_only']}"
        )
        print(
            f"Confirmed differences: primary-only={report['differences']['primary_only']}; replica-only={report['differences']['replica_only']}"
        )
        print(f"Resume iterator: {report['resume_iterator']}")
        print(f"Report: {output}")
    if report["differences"]["primary_only"] or report["differences"]["replica_only"]:
        return EXIT_DIVERGED
    return exit_code


