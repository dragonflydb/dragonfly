    dashboards_parser.add_argument("--datastore-id", required=True, help="Datastore ID (dst_...)")
    dashboards_parser.add_argument("--shard-id", default=".*", help="Shard ID regex (default: .*)")
    dashboards_parser.add_argument("--node-id", default=".*", help="Node ID regex (default: .*)")
    dashboards_parser.add_argument(
        "--sections", default="", help="Comma-separated exact named sections; requires '*' "
    )
    dashboards_parser.add_argument(
        "--global-only", action="store_true", help="Select global panels only; requires '*'"
    )
    dashboards_parser.add_argument("--rate-interval", default="1m", help="PromQL rate interval")
    dashboards_parser.add_argument("--context", help="Optional gcx context")
    dashboards_parser.add_argument(
        "--datasource", default="victoria-prom", help="Fallback Prometheus datasource UID"
    )
    dashboards_parser.add_argument(
        "--resume", action="store_true", help="Resume matching incomplete panel exports"
    )
    dashboards_parser.add_argument(
        "--dry-run", action="store_true", help="Print selected panels without exporting data"
    )
    dashboards_parser.add_argument("--source-folder", help="Canonical source-folder title")
    dashboards_parser.add_argument("--dashboard", help="Canonical dashboard title")
    dashboards_parser.add_argument("--panels", help="Canonical '*' or comma-separated panel titles")
    dashboards_parser.add_argument("-o", "--output-root", help="Canonical export output root")
    dashboards_parser.add_argument(
        "-s", "--since", help="Window start; accepts UTC, 'now', or '<N> hours ago'"
    )
    dashboards_parser.add_argument(
        "-u", "--until", help="Window end; defaults to the captured current UTC time"
    )

    viewer_parser = commands.add_parser(
        "dashboard-viewer",
        help="render saved dashboard query responses as a self-contained offline HTML report",
        description="Create an offline HTML report from a completed dashboard-panels export. No network requests are made.",
    )
    viewer_parser.add_argument(
        "dashboard_dir",
        type=Path,
        help="Completed dashboard export directory containing resume.json",
    )
    viewer_parser.add_argument(
        "--output", type=Path, help="HTML output path (default: <dashboard-dir>/index.html)"
    )
    for command_parser in dict.fromkeys(commands.choices.values()):
        global_options = command_parser.add_argument_group("global options")
        global_options.add_argument(
            "--env",
            choices=GCX_CONTEXTS,
            dest="_canonical_environment",
            help="Environment selector; accepted before or after the command (default: prod)",
        )
        if command_parser not in {explain_parser, session_parser}:
            global_options.add_argument(
                "--deployment-ssh-conn-command",
                help="Deployment 'gcloud compute ssh' command; verified once and cached automatically.",
            )
        if command_parser not in {explain_parser, session_parser}:
            global_options.add_argument(
                "--session",
                help="Tag this successful recorded output with an investigation session",
            )
            global_options.add_argument(
                "--ai-explain",
                "--explain",
                dest="explain",
                action="store_true",
                help="Explain this successful output and record it for explain --last",
            )
            global_options.add_argument(
                "--ai-agent",
                "--agent",
                dest="agent",
                choices=("copilot", "gemini", "codex", "claude"),
                default="copilot",
                help="Named local agent backend for --explain (default: copilot)",
            )
            global_options.add_argument(
                "--ai-depth",
                "--depth",
                dest="depth",
                choices=EXPLAIN_DEPTHS,
                default="standard",
                help="Stateless response depth for --explain (default: standard)",
            )
            global_options.add_argument(
                "--ai-deep",
                "--deep",
                action="store_const",
                dest="depth",
                const="deep",
                help="Alias for --ai-depth deep",
            )
            global_options.add_argument(
                "--ai-model",
                "--model",
                dest="model",
                help="Copilot model override for --explain",
            )
            global_options.add_argument(
                "--ai-question", help="Question to answer with --ai-explain"
            )
            global_options.add_argument(
                "--ai-cache",
                action="store_true",
                help="Reuse an exact local AI response cache entry",
            )
    try:
        arguments = normalize_environment_arguments(sys.argv[1:])
        arguments = normalize_explain_arguments(arguments)
        arguments = normalize_canonical_arguments(arguments)
        return parser.parse_args(normalize_time_window_arguments(arguments))
    except ValueError as error:
        parser.error(str(error))


def run_command(arguments: argparse.Namespace | None = None) -> int:
    arguments = arguments or parse_arguments()
    command_aliases = {
        "ad": "addresses",
        "au": "audit",
        "bu": "bundle",
        "co": "collect",
        "dp": "dashboard-panels",
        "ds": "discover",
        "dc": "diff-config",
        "df": "diff-config",
        "diff-flags": "diff-config",
        "ex": "explain",
        "hl": "health",
        "la": "log-archiver",
        "lg": "logs",
        "mg": "migrations",
        "rg": "replication-gap",
        "rs": "run-inspection-script",
        "run-script": "run-inspection-script",
        "mu": "multi",
        "sc": "scan-compare",
        "sl": "slowlog",
        "so": "slot-ownership",
    }
    arguments.command = command_aliases.get(arguments.command, arguments.command)
    environment = arguments.environment
    requires_dfadmin = arguments.command not in {"dashboard-panels", "explain", "session"}
    requires_deployment_ssh = arguments.command in {
        "bundle",
        "collect",
        "health",
        "run-inspection-script",
        "scan-compare",
        "slot-ownership",
    }
    supplied_ssh_connection = getattr(arguments, "deployment_ssh_conn_command", None)
    cached_ssh_connection = load_deployment_ssh_connection()
    if (
        not getattr(arguments, "dry_run", False)
        and requires_deployment_ssh
        and not (supplied_ssh_connection or cached_ssh_connection)
    ):
        raise ValueError(
            "deployment SSH is not configured; provide --deployment-ssh-conn-command once "
            "to verify and cache the deployment connection"
        )
    executables = []
    if not getattr(arguments, "dry_run", False):
        executables = (
            []
            if arguments.command in {"explain", "session"}
            else (
                ["gcx", "dfadmin-wrapper"]
                if arguments.command in {"bundle", "logs", "log-archiver", "dashboard-panels"}
                else ["dfadmin-wrapper"]
            )
        )
        if requires_deployment_ssh:
            executables.append("gcloud")
    missing = next((executable for executable in executables if not shutil.which(executable)), None)
    if missing:
        print(error_message(f"{missing} is not on PATH"), file=sys.stderr)
        return 1
    try:
        if not getattr(arguments, "dry_run", False):
            set_deployment_ssh_connection(supplied_ssh_connection)
            if requires_dfadmin:
                preflight_dfadmin(environment)
            if requires_deployment_ssh:
                preflight_deployment_ssh(supplied_ssh_connection)
        if arguments.command == "session":
            if arguments.session_action == "list":
                return show_sessions()
            if arguments.session_action == "show":
                return show_session(arguments.name)
            return clear_session(arguments.name)
        if arguments.command == "explain":
            if arguments.dry_run:
                if arguments.history or arguments.defaults:
                    raise ValueError("--dry-run cannot be combined with --history or --defaults")
                if arguments.last is not None and arguments.last <= 0:
                    raise ValueError("--last must be positive")
                return explain_dry_run(arguments)
            if arguments.history:
                if arguments.question:
                    raise ValueError("--history does not accept a question")
                return show_history()
            if arguments.defaults:
                if arguments.question:
                    raise ValueError("--defaults does not accept a question")
                return explain_defaults()
            if arguments.last is not None:
                if arguments.last <= 0:
                    raise ValueError("--last must be positive")
                selected = history_artifact(arguments.last)
                if selected is None:
                    print("No recorded command output.")
                    return 0
                entry, output = selected
                print(json.dumps(explain_history_artifact(arguments, entry, output), indent=2))
                return 0
            if arguments.session is not None:
                selected = session_artifact(arguments.session)
                if selected is None:
                    print(f"No recorded command output for session {arguments.session!r}.")
                    return 0
                entries, output = selected
                source = f"session {arguments.session} ({len(entries)} artifacts)"
                print(
                    json.dumps(
                        explain_artifact(
                            arguments.agent,
                            arguments.question or "Explain this session output.",
                            source,
                            output,
                            arguments.depth,
                            arguments.model,
                            arguments.ai_cache,
                        ),
                        indent=2,
                    )
                )
                return 0
            if arguments.file is not None:
                try:
                    output = arguments.file.read_text()
                except OSError as error:
                    raise RuntimeError(
                        f"could not read --file {arguments.file}: {error}"
                    ) from error
                if not output.strip():
                    print("No output to explain.")
                    return 0
                print(
                    json.dumps(
                        explain_artifact(
                            arguments.agent,
                            arguments.question or "Explain this command output.",
                            str(arguments.file),
                            output,
                            arguments.depth,
                            arguments.model,
                            arguments.ai_cache,
                        ),
                        indent=2,
                    )
                )
                return 0
            piped_output = ""
            if not sys.stdin.isatty():
                piped_output = sys.stdin.read(MAX_AGENT_CONTEXT_BYTES + 1)
            if piped_output:
                if len(piped_output.encode()) > MAX_AGENT_CONTEXT_BYTES:
                    print(
                        warning_message(
                            f"stdin exceeds {MAX_AGENT_CONTEXT_BYTES} bytes; explaining the leading bytes only."
                        ),
                        file=sys.stderr,
                    )
                    piped_output = piped_output.encode()[:MAX_AGENT_CONTEXT_BYTES].decode(
                        errors="replace"
                    )
                print(
                    json.dumps(
                        explain_artifact(
                            arguments.agent,
                            arguments.question or "Explain this command output.",
                            "stdin",
                            piped_output,
                            arguments.depth,
                            arguments.model,
                            arguments.ai_cache,
                        ),
                        indent=2,
                    )
                )
                return 0
            if not arguments.question:
                print("No recorded command output.")
                return 0
            print(
                json.dumps(
                    explain_with_agent(
                        arguments.agent, arguments.question, arguments.depth, arguments.model
                    ),
                    indent=2,
                )
            )
            return 0
        if arguments.command in {"logs", "log-archiver", "dashboard-panels"}:
            expected_context = GCX_CONTEXTS[environment]
            if arguments.context and arguments.context != expected_context:
                raise ValueError(
                    f"--context {arguments.context!r} conflicts with --env {environment}; "
                    f"expected {expected_context!r}"
                )
            arguments.context = expected_context
        if hasattr(arguments, "targets"):
            arguments.customer_targets = [
                target for target in arguments.targets if target.startswith("cus_")
            ]
            if arguments.command == "discover" and len(arguments.customer_targets) > 1:
                raise ValueError("discover accepts at most one customer target")
            arguments.targets = expand_customer_targets(environment, arguments.targets)
        if arguments.command == "scan-compare":
            slots = parse_slots(arguments.slots) if arguments.slots else None
            return scan_compare(
                environment,
                arguments.first_node_id,
                arguments.second_node_id,
                "",
                arguments.count,
                arguments.max_iterations,
                arguments.stop_after_diffs,
                arguments.iterator,
                arguments.output,
                arguments.force,
                arguments.show_keys,
                slots,
                arguments.progress,
                arguments.confirm_delay,
                arguments.dry_run,
            )
        if arguments.command == "slot-ownership":
            slots = parse_slots(arguments.slots) if arguments.slots else None
            return slot_ownership(
                environment,
                arguments.scope,
                "",
                slots,
                arguments.output,
                arguments.workers,
                arguments.dry_run,
            )
        if arguments.command == "migrations":
            shard_filter = (
                {shard for shard in arguments.shards.split(",") if shard}
                if arguments.shards
                else None
            )
            if shard_filter and not all(shard.startswith("shard_") for shard in shard_filter):
                raise ValueError("--shards must be a comma-separated list of shard IDs")
            return migration_report(
                environment,
                arguments.history,
                arguments.scope,
                arguments.output,
                shard_filter,
                arguments.state,
                arguments.recover_malformed_history,
                arguments.max_elements,
            )
        if arguments.command == "audit":
            since, until = resolve_time_window(arguments.since, arguments.until)
            return audit_log(
                environment,
                arguments.resource_id,
                since,
                until,
                arguments.limit,
                arguments.json_output,
            )
        if arguments.command == "health":
            return health_reports(
                environment,
                arguments.targets,
                "",
                arguments.workers,
                arguments.format,
                arguments.max_elements,
            )
        if arguments.command == "slowlog":
            return slowlog_report(
                environment,
                arguments.targets,
                arguments.limit,
                arguments.format,
                arguments.output,
                arguments.workers,
                arguments.max_elements,
                arguments.dry_run,
            )
        if arguments.command == "diff-config":
            if arguments.list_parameters:
                if arguments.parameter:
                    raise ValueError(
                        "--list-parameters cannot be combined with --parameter or --all-parameters"
                    )
                if arguments.report_only or arguments.max_elements is not None:
                    raise ValueError(
                        "--list-parameters cannot be combined with --report-only or --max-elements"
                    )
                return list_config_parameters(environment, arguments.targets)
            return diff_config(
                environment,
                arguments.targets,
                arguments.parameter,
                arguments.workers,
                arguments.format,
                arguments.max_elements,
                arguments.report_only,
            )
        if arguments.command == "multi":
            if arguments.schema is not None:
                if len(arguments.targets) != 1:
                    raise ValueError("--schema requires exactly one target")
                if (
                    arguments.resource
                    or arguments.field
                    or arguments.prefix
                    or arguments.max_elements
                ):
                    raise ValueError(
                        "--schema cannot be combined with --resource, --field, --prefix, or --max-elements"
                    )
                return show_schema(environment, arguments.targets[0], arguments.schema)
            resource_type = arguments.resource or infer_multi_resource_type(arguments.targets)
            return multi_show(
                environment,
                resource_type,
                arguments.targets,
                arguments.field,
                arguments.prefix,
                arguments.workers,
                arguments.format,
                arguments.max_column_width,
                arguments.max_elements,
            )
        if arguments.command == "collect":
            includes = {item for item in arguments.include.split(",") if item}
            invalid_includes = includes - {
                "dfly-logs",
                "info-dump",
                "journal",
                "agent",
                "clients",
                "perf",
            }
            if invalid_includes:
                raise ValueError(f"unknown --include source: {', '.join(sorted(invalid_includes))}")
            if arguments.workers <= 0 or arguments.workers > MAX_COLLECTION_WORKERS:
                raise ValueError("--workers must be between 1 and 2")
            if arguments.max_normalized_load <= 0:
                raise ValueError("--max-normalized-load must be positive")
            if arguments.min_free_kib <= 0:
                raise ValueError("--min-free-kib must be positive")
            since, until = resolve_time_window(arguments.since, arguments.until)
            return collect_evidence(
                environment,
                arguments.targets,
                arguments.output_dir,
                includes,
                arguments.workers,
                "",
                arguments.max_normalized_load,
                arguments.min_free_kib,
                since,
                until,
                arguments.bundle,
                arguments.raw_transfer,
                arguments.estimate,
                arguments.dry_run,
                arguments.max_elements,
            )
        if arguments.command == "bundle":
            includes = {item for item in arguments.collect_include.split(",") if item}
            invalid_includes = includes - {
                "dfly-logs",
                "info-dump",
                "journal",
                "agent",
                "clients",
                "perf",
            }
            if invalid_includes:
                raise ValueError(
                    f"unknown --collect-include source: {', '.join(sorted(invalid_includes))}"
                )
            output_dir = arguments.output_dir or Path.cwd() / arguments.incident_id
            return incident_bundle(
                environment,
                arguments.incident_id,
                arguments.around,
                arguments.window,
                arguments.targets,
                arguments.source_folder,
                arguments.dashboard,
                arguments.panels,
                output_dir,
                includes,
                arguments.log_limit,
                arguments.loki_datasource,
                arguments.dashboard_sections,
                arguments.dashboard_global_only,
                "",
                arguments.resume,
                arguments.overwrite,
                arguments.dry_run,
            )
        if arguments.command == "run-inspection-script":
            return run_script_on_nodes(
                environment,
                arguments.targets,
                arguments.script,
                arguments.inline_command,
                arguments.output_dir,
                arguments.workers,
                "",
                arguments.timeout_seconds,
                arguments.acknowledge_multi_node,
                arguments.tee,
                arguments.screen_only,
                arguments.dry_run,
                arguments.max_elements,
                arguments.agent_validation,
            )
        if arguments.command == "logs":
            return get_logs(
                arguments.node_id,
                arguments.start,
                arguments.end,
                environment,
                arguments.context,
                arguments.source,
                arguments.limit,
                arguments.datastore_id,
                arguments.shard_id,
                arguments.output,
                arguments.dry_run,
            )
        if arguments.command == "log-archiver":
            return archive_logs(
                environment,
                arguments.targets,
                arguments.start,
                arguments.end,
                arguments.context,
                arguments.limit,
                arguments.output_dir,
                arguments.max_workers,
                arguments.source,
                arguments.compress,
                arguments.dry_run,
                arguments.max_elements,
                arguments.loki_datasource,
            )
        if arguments.command == "dashboard-panels":
            return export_dashboard_panels(
                arguments.source_folder,
                arguments.dashboard,
                arguments.panels,
                arguments.start,
                arguments.end,
                arguments.output_root,
                arguments.datastore_id,
                arguments.shard_id,
                arguments.node_id,
                arguments.rate_interval,
                arguments.context,
                arguments.datasource,
                arguments.sections,
                arguments.global_only,
                arguments.resume,
                arguments.dry_run,
            )
        if arguments.command == "dashboard-viewer":
            viewer_path = write_dashboard_viewer(arguments.dashboard_dir, arguments.output)
            print(f"Offline dashboard viewer: {viewer_path}")
            return 0
        if arguments.command == "discover":
            return discover_datastores(
                environment,
                arguments.targets,
                arguments.json_output,
                arguments.max_elements,
                arguments.include_deleted,
                arguments.shards_only,
                arguments.customer_targets[0] if len(arguments.customer_targets) == 1 else None,
                arguments.short,
            )
        if arguments.command == "addresses":
            return show_addresses(
                environment, arguments.targets, arguments.json_output, arguments.max_elements
            )
        return check_pair(
            environment,
            arguments.first_node_id,
            arguments.second_node_id,
            arguments.config_parameter,
            arguments.dry_run,
        )
    except KeyboardInterrupt:
        print(error_message("interrupted"), file=sys.stderr)
        return 130
    except (OSError, RuntimeError, ValueError) as error:
        print(error_message(str(error)), file=sys.stderr)
        return 1


class OutputCapture(io.StringIO):
    def __init__(self, target: Any) -> None:
        super().__init__()
        self.target = target

    def write(self, value: str) -> int:
        self.target.write(value)
        self.target.flush()
        return super().write(value)


def main() -> int:
    arguments = parse_arguments()
    is_local_command = arguments.command in {"explain", "ex", "session"}
    requested_explanation = getattr(arguments, "explain", False)
    if getattr(arguments, "ai_question", None) and not requested_explanation:
        print(error_message("--ai-question requires --ai-explain"), file=sys.stderr)
        return 1
    if is_local_command:
        return run_command(arguments)

    captured_stdout = OutputCapture(sys.stdout)
    with contextlib.redirect_stdout(captured_stdout):
        result = run_command(arguments)
    if result != 0:
        return result
    output = captured_stdout.getvalue()
    output_path = getattr(arguments, "output", None)
    artifact_type = "text"
    if (
        isinstance(output_path, Path)
        and output_path.is_file()
        and output_path.suffix.lower() == ".json"
    ):
        try:
            output = output_path.read_text()
            artifact_type = "json"
        except OSError:
            pass
    elif not output.strip() and isinstance(output_path, Path) and output_path.is_file():
        try:
            output = output_path.read_text()
        except OSError:
            pass
    if artifact_type == "text":
        try:
            json.loads(output)
            artifact_type = "json"
        except json.JSONDecodeError:
            pass
    log_heavy_commands = {"collect", "logs", "log-archiver", "run-inspection-script", "slowlog"}
    if arguments.command in log_heavy_commands and artifact_type == "text":
        if requested_explanation:
            print(
                warning_message(
                    "raw log-oriented output is not retained or sent to AI automatically; select a bounded local report with explain --file instead."
                ),
                file=sys.stderr,
            )
        return 0
    entry = record_history(sys.argv[1:], output, getattr(arguments, "session", None), artifact_type)
    if entry is None:
        return 0
    if not requested_explanation:
        return 0
    try:
        response = explain_history_artifact(arguments, entry, output)
    except (OSError, RuntimeError, ValueError) as error:
        print(error_message(str(error)), file=sys.stderr)
        return 1
    print(json.dumps(response, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
