def capture_command(archive, name, command, match=None):
    def output():
        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        for line in iter(process.stdout.readline, b""):
            if match is None or match in line.lower() or b"killed process" in line.lower():
                yield line
