def load_history() -> list[dict[str, object]]:
    try:
        history = json.loads(HISTORY_INDEX_PATH.read_text())
    except FileNotFoundError:
        return []
    except (OSError, json.JSONDecodeError):
        return []
    return (
        [entry for entry in history if isinstance(entry, dict)] if isinstance(history, list) else []
    )


def save_history(entries: list[dict[str, object]]) -> None:
    HISTORY_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    write_json(HISTORY_INDEX_PATH, entries[:MAX_HISTORY_ENTRIES])
    HISTORY_INDEX_PATH.chmod(0o600)


def history_command(arguments: list[str]) -> str:
    redacted_arguments = list(arguments)
    for index, argument in enumerate(redacted_arguments[:-1]):
        if argument == "--command":
            redacted_arguments[index + 1] = "<redacted>"
    for index, argument in enumerate(redacted_arguments):
        if argument.startswith("--command="):
            redacted_arguments[index] = "--command=<redacted>"
    return shlex.join(redacted_arguments)


def redact_persisted_output(output: str) -> str:
    """Redact common credential assignments before retaining any local artifact."""
    sensitive = r"(?:auth(?:orization)?|pass(?:word)?|secret|token|credential|api[_-]?key|access[_-]?key|private[_-]?key|masterauth|requirepass)"
    output = re.sub(
        rf'(?im)("{sensitive}"\s*:\s*)"[^"]*"',
        r'\1"<redacted>"',
        output,
    )
    return re.sub(
        r"(?im)(\b(?:auth(?:orization)?|pass(?:word)?|secret|token|credential|"
        r"api[_-]?key|access[_-]?key|private[_-]?key|masterauth|requirepass)\b"
        r"\s*(?:=|:|\s)\s*)([^\s,;]+)",
        r"\1<redacted>",
        output,
    )


def validate_session_name(session: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", session):
        raise ValueError(
            "--session must be 1-64 letters, digits, '.', '_', or '-', starting with a letter or digit"
        )
    return session


def record_history(
    arguments: list[str], output: str, session: str | None = None, artifact_type: str = "text"
) -> dict[str, object] | None:
    if not output.strip():
        return None
    output = redact_persisted_output(output)
    encoded_output = output.encode()
    if len(encoded_output) > MAX_HISTORY_ARTIFACT_BYTES:
        encoded_output = encoded_output[:MAX_HISTORY_ARTIFACT_BYTES]
    timestamp = datetime.now(timezone.utc)
    artifact_name = f"{timestamp.strftime('%Y%m%dT%H%M%SZ')}-{hashlib.sha256(encoded_output).hexdigest()[:12]}.txt"
    HISTORY_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    artifact_path = HISTORY_DIR / artifact_name
    artifact_path.write_bytes(encoded_output)
    artifact_path.chmod(0o600)
    entry: dict[str, object] = {
        "timestamp": timestamp.isoformat(),
        "command": history_command(arguments),
        "artifact": artifact_name,
        "sha256": hashlib.sha256(encoded_output).hexdigest(),
        "bytes": len(encoded_output),
        "truncated": len(encoded_output) < len(output.encode()),
        "artifact_type": artifact_type,
    }
    if session is not None:
        entry["session"] = validate_session_name(session)
    save_history([entry, *load_history()])
    return entry


def show_history() -> int:
    entries = load_history()
    if not entries:
        print("No recorded command output.")
        return 0
    print("Recorded command output:")
    for index, entry in enumerate(entries, 1):
        session = entry.get("session")
        suffix = f"  session={session}" if isinstance(session, str) else ""
        print(
            f"{index:>2}  {entry.get('timestamp', '<unknown>')}  {entry.get('command', '<unknown>')}{suffix}"
        )
    return 0


def history_artifact(index: int) -> tuple[dict[str, object], str] | None:
    entries = load_history()
    if index < 1 or index > len(entries):
        return None
    entry = entries[index - 1]
    artifact = entry.get("artifact")
    if not isinstance(artifact, str) or Path(artifact).name != artifact:
        return None
    try:
        return entry, (HISTORY_DIR / artifact).read_text()
    except OSError:
        return None


def session_artifact(session: str) -> tuple[list[dict[str, object]], str] | None:
    session = validate_session_name(session)
    entries = [entry for entry in load_history() if entry.get("session") == session]
    structured_entries = [entry for entry in entries if entry.get("artifact_type") == "json"]
    entries = structured_entries or entries
    chunks = []
    selected_entries = []
    remaining = MAX_AGENT_CONTEXT_BYTES
    for entry in reversed(entries[-MAX_SESSION_ARTIFACTS:]):
        artifact = entry.get("artifact")
        if not isinstance(artifact, str) or Path(artifact).name != artifact:
            continue
        try:
            output = (HISTORY_DIR / artifact).read_text()
        except OSError:
            continue
        label = f"COMMAND: {entry.get('command', '<unknown>')}\nTIMESTAMP: {entry.get('timestamp', '<unknown>')}\n"
        chunk = f"{label}{output}\n\n"
        encoded_chunk = chunk.encode()
        if len(encoded_chunk) > remaining:
            chunk = encoded_chunk[:remaining].decode(errors="replace")
        chunks.append(chunk)
        selected_entries.append(entry)
        remaining -= len(chunk.encode())
        if remaining <= 0:
            break
    if not chunks:
        return None
    return selected_entries, "".join(chunks)


def show_sessions() -> int:
    sessions: dict[str, list[dict[str, object]]] = {}
    for entry in load_history():
        session = entry.get("session")
        if isinstance(session, str):
            sessions.setdefault(session, []).append(entry)
    if not sessions:
        print("No recorded investigation sessions.")
        return 0
    print("Recorded investigation sessions:")
    for session, entries in sorted(sessions.items()):
        print(
            f"{session}  artifacts={len(entries)}  latest={entries[0].get('timestamp', '<unknown>')}"
        )
    return 0


def show_session(session: str) -> int:
    session = validate_session_name(session)
    entries = [entry for entry in load_history() if entry.get("session") == session]
    if not entries:
        print(f"No recorded command output for session {session!r}.")
        return 0
    print(f"Session {session}:")
    for index, entry in enumerate(reversed(entries), 1):
        print(
            f"{index:>2}  {entry.get('timestamp', '<unknown>')}  {entry.get('command', '<unknown>')}"
        )
    return 0


def clear_session(session: str) -> int:
    session = validate_session_name(session)
    retained, removed = [], []
    for entry in load_history():
        if entry.get("session") == session:
            removed.append(entry)
        else:
            retained.append(entry)
    for entry in removed:
        artifact = entry.get("artifact")
        if isinstance(artifact, str) and Path(artifact).name == artifact:
            with contextlib.suppress(OSError):
                (HISTORY_DIR / artifact).unlink()
    save_history(retained)
    print(f"Cleared {len(removed)} recorded artifact(s) from session {session!r}.")
    return 0


def ai_cache_path(
    agent: str, question: str, source: str, output: str, depth: str, model: str | None
) -> Path:
    digest = hashlib.sha256(
        json.dumps(
            {
                "agent": agent,
                "question": question,
                "source": source,
                "output": output,
                "depth": depth,
                "model": model,
            },
            sort_keys=True,
        ).encode()
    ).hexdigest()
    return AI_CACHE_DIR / f"{digest}.json"


def read_ai_cache(
    agent: str, question: str, source: str, output: str, depth: str, model: str | None
) -> dict[str, Any] | None:
    try:
        response = json.loads(
            ai_cache_path(agent, question, source, output, depth, model).read_text()
        )
    except (OSError, json.JSONDecodeError):
        return None
    return (
        response if isinstance(response, dict) and isinstance(response.get("answer"), str) else None
    )


def write_ai_cache(
    response: dict[str, Any],
    agent: str,
    question: str,
    source: str,
    output: str,
    depth: str,
    model: str | None,
) -> None:
    AI_CACHE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    path = ai_cache_path(agent, question, source, output, depth, model)
    write_json(path, response)
    path.chmod(0o600)


def explain_dry_run(arguments: argparse.Namespace) -> int:
    """Preview an explain request without invoking an agent or writing a cache entry."""
    question = arguments.question or "Explain this command output."
    source = "operator question"
    output = ""
    if arguments.last is not None:
        selected = history_artifact(arguments.last)
        if selected is None:
            raise ValueError(f"no recorded command output at --last {arguments.last}")
        entry, output = selected
        source = str(entry.get("command", "recorded command"))
    elif arguments.session is not None:
        selected = session_artifact(arguments.session)
        if selected is None:
            raise ValueError(f"no recorded command output for session {arguments.session!r}")
        entries, output = selected
        source = f"session {arguments.session} ({len(entries)} artifacts)"
        question = arguments.question or "Explain this session output."
    elif arguments.file is not None:
        try:
            output = arguments.file.read_text()
        except OSError as error:
            raise RuntimeError(f"could not read --file {arguments.file}: {error}") from error
        source = str(arguments.file)
    elif not sys.stdin.isatty():
        output = sys.stdin.read(MAX_AGENT_CONTEXT_BYTES + 1)
        source = "stdin"
    model = effective_explain_model(arguments.agent, arguments.model)
    output = redact_persisted_output(output)
    input_bytes = len(output.encode())
    truncated = input_bytes > MAX_AGENT_CONTEXT_BYTES
    cache_key = ai_cache_path(
        arguments.agent, question, source, output, arguments.depth, model
    ).stem
    print_explain_settings(
        arguments.agent, model, arguments.depth, question, source, arguments.ai_cache, input_bytes
    )
    print(
        json.dumps(
            {
                "dry_run": True,
                "source": source,
                "input_bytes": input_bytes,
                "input_limit_bytes": MAX_AGENT_CONTEXT_BYTES,
                "would_truncate_input": truncated,
                "cache": "would_lookup" if arguments.ai_cache else "disabled",
                "cache_key": cache_key if arguments.ai_cache else None,
                "provider_call": "not started",
                "cache_write": "not performed",
            },
            indent=2,
            sort_keys=True,
        )
    )
    return 0


def explain_artifact(
    agent_name: str,
    question: str,
    source: str,
    output: str,
    depth: str = "standard",
    model: str | None = None,
    use_cache: bool = False,
) -> dict[str, Any]:
    model = effective_explain_model(agent_name, model)
    output = redact_persisted_output(output)
    print_explain_settings(
        agent_name, model, depth, question, source, use_cache, len(output.encode())
    )
    if use_cache:
        cached = read_ai_cache(agent_name, question, source, output, depth, model)
        if cached is not None:
            return {
                "agent": agent_name,
                "model": model,
                "source": source,
                "answer": cached["answer"],
                "cache": "hit",
